# ---------------------------------------------------------------- helpers

def eprint(*a):
    print(*a, file=sys.stderr)


def die(msg, code=1):
    eprint("bws-touchid: " + msg)
    sys.exit(code)


def clean(s, n=80):
    s = "".join(ch for ch in str(s or "") if ch.isprintable())
    return s if len(s) <= n else s[:n] + "…"


def claimed(s, n):
    """A client-asserted label (host, caller): printable ASCII only, so look-alike letters, bidi and
    zero-width characters never reach a prompt, the canonical or the log."""
    return "".join(ch if " " <= ch < "\x7f" or ch == "…" else "?" for ch in clean(s, n))


def load_config():
    c = json.loads(json.dumps(DEFAULTS))
    try:
        with open(CONFIG_PATH) as f:
            user = json.load(f)
        if isinstance(user, dict):
            c.update({k: v for k, v in user.items() if not k.startswith("_")})
    except FileNotFoundError:
        pass
    except Exception as e:  # noqa: BLE001
        eprint("bws-touchid: ignoring unreadable config %s: %s" % (CONFIG_PATH, e))
    c["denied_projects"] = [str(x).lower() for x in c.get("denied_projects") or []]
    names = {str(k).lower(): str(v) for k, v in (c.get("project_names") or {}).items()}
    c["project_names"] = names
    for pid, nm in names.items():  # denying a name also denies its id
        if nm.lower() in c["denied_projects"]:
            c["denied_projects"].append(pid)
    # Denied NAMES with no id in project_names: bws output only carries projectId, so these are resolved
    # to ids with a live `project list` before any read result is returned (fail closed).
    mapped = {v.lower() for v in names.values()}
    c["denied_unresolved"] = sorted(set(n for n in c["denied_projects"] if not UUID_RE.match(n) and n not in mapped))
    c["save_projects"] = [p for p in c.get("save_projects") or [] if p.lower() not in c["denied_projects"]]
    rt = c.get("read_tokens")
    rt = [x for x in rt if isinstance(x, str)] if isinstance(rt, list) else []
    c["read_tokens"] = list(dict.fromkeys([str(c["read_token"])] + rt))
    return c


def denied_project(x, c):
    return str(x or "").lower() in c["denied_projects"]


def denied_key(k, c):
    """Key prefixes are matched case-insensitively (Bitwarden keys are free-form: Mail_x, mail_x)."""
    k = str(k or "").upper()
    return any(p and k.startswith(str(p).upper()) for p in c.get("denied_key_prefixes") or [])


def log(fields):
    fields = dict(fields)
    fields["ts"] = datetime.datetime.now().astimezone().isoformat(timespec="seconds")
    notes = fields.pop("notes", None)
    if notes:
        fields["detail"] = " ".join(([fields["detail"]] if fields.get("detail") else []) + list(notes))
    order = ["ts", "op", "result", "key", "project", "token", "host", "caller", "via", "approver",
             "request_id", "detail"]
    line = " ".join("%s=%s" % (k, clean(fields[k], 200)) for k in order if fields.get(k)) + "\n"
    os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
    fd = os.open(LOG_PATH, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    with os.fdopen(fd, "a") as f:
        f.write(line)


def find_tool(name, configured):
    if configured:
        return configured
    path = os.pathsep.join([os.environ.get("PATH", "")] + EXTRA_PATH)
    return shutil.which(name, path=path)


def tool_env():
    return {"PATH": os.pathsep.join(EXTRA_PATH + ["/usr/bin", "/bin"]), "HOME": HOME}


def notify(title, msg, c):
    if not c.get("notify", True):
        return
    script = ["-e", "on run argv", "-e", "display notification (item 2 of argv) with title (item 1 of argv)",
              "-e", "end run", clean(title, 60), clean(msg, 200)]
    try:
        subprocess.run(["/usr/bin/osascript"] + script, timeout=5,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:  # noqa: BLE001
        pass


def token_path(name):
    if not NAME_RE.match(name or ""):
        raise ValueError("bad token name")
    return os.path.join(TOKENS_DIR, name + ".age")


def decrypt_token(name, c):
    """One Secure Enclave decrypt = one Touch ID prompt. Returns (token, error)."""
    path = token_path(name)
    if not os.path.isfile(path):
        return None, "no token named '%s' on the broker Mac (owner: bws-touchid store %s)" % (name, name)
    age = find_tool("age", c.get("age_path"))
    if not age:
        return None, "age not found (brew install age age-plugin-se)"
    try:
        r = subprocess.run([age, "-d", "-i", IDENTITY, path], capture_output=True, timeout=120, env=tool_env())
    except subprocess.TimeoutExpired:
        return None, "timed out waiting for Touch ID"
    if r.returncode != 0:
        err = r.stderr.decode("utf-8", "replace").strip().splitlines()
        return None, "Touch ID / decrypt failed: %s" % clean(err[-1] if err else "exit %d" % r.returncode, 160)
    tok = r.stdout.decode("utf-8").strip()
    if not tok:
        return None, "decrypted token is empty"
    return tok, None


def run_bws(args, token, c, timeout=None):
    """Run bws with the token in env only and an empty HOME (no user bws config can redirect it)."""
    bws = find_tool("bws", c.get("bws_path"))
    if not bws:
        return 127, b"", "bws not found on the broker Mac"
    with tempfile.TemporaryDirectory(prefix="bws-touchid-") as tmp:
        env = {"HOME": tmp, "TMPDIR": tmp + "/", "PATH": "/usr/bin:/bin", "BWS_ACCESS_TOKEN": token}
        try:
            r = subprocess.run([bws, "--color", "no"] + args, capture_output=True, timeout=timeout or BWS_TIMEOUT_S,
                               env=env, stdin=subprocess.DEVNULL)
        except subprocess.TimeoutExpired:
            return 124, b"", "bws timed out"
    err = r.stderr.decode("utf-8", "replace").replace(token, "[REDACTED]")
    if len(r.stdout) > MAX_STDOUT:
        return 1, b"", "bws output too large"
    return r.returncode, r.stdout, err[:600]


# ------------------------------------------------------------ approvers
#
# A gated op (save, bws) needs one approval before a token is decrypted. With the default
# `"approvers": ["touchid"]` that is exactly the old notify() + decrypt_token() path. With "iphone" in
# the list the broker races the Touch ID decrypt against a phone-signed approval relayed by the
# whispera-link daemon (PROTOCOL.md §8, §11.2). The broker builds and serialises the canonical request
# itself and re-verifies every phone signature with /usr/bin/openssl against a pinned key; the daemon
# is only a relay. First valid answer wins; a deny from either leg is a deny; the deadline is a deny.

def expand(p):
    p = str(p or "")
    return HOME + p[1:] if p == "~" or p.startswith("~/") else p


def approvers_of(c):
    """The configured approver list, or None when it is unusable (fail closed)."""
    a = c.get("approvers")
    if not isinstance(a, list) or not a or not all(isinstance(x, str) and x in KNOWN_APPROVERS for x in a) \
            or len(set(a)) != len(a):
        return None
    return a


def is_default_approvers(c):
    return approvers_of(c) == ["touchid"]


def phone_window(c):
    """approval_wait_s (legacy: phone_window_s), default 300, clamped PHONE_WINDOW_MIN-PHONE_WINDOW_MAX."""
    raw = c.get("approval_wait_s")
    if raw is None:
        raw = c.get("phone_window_s")
    try:
        w = APPROVAL_WAIT_DEFAULT_S if raw is None or isinstance(raw, bool) else int(raw)
    except (TypeError, ValueError):
        w = APPROVAL_WAIT_DEFAULT_S
    return max(PHONE_WINDOW_MIN, min(PHONE_WINDOW_MAX, w))


def prefer_device_of(req, c):
    """Routing hint for the daemon: which paired device to push first (the one used last). Only a hint:
    every approval is still verified against a pinned key. From the request, else the helper's file."""
    dev = req.get("prefer_device")
    if isinstance(dev, str) and DEVICE_RE.match(dev):
        return dev
    path = expand(c.get("prefer_device_file") or "")
    if not path or not safe_owned(path, False):
        return ""
    try:
        with open(path) as f:
            dev = f.read(64).strip()
    except (OSError, UnicodeDecodeError):
        return ""
    return dev if DEVICE_RE.match(dev) else ""


def iphone_identity(c):
    return expand(c.get("iphone_token_identity")) or os.path.join(CONF_DIR, "identity-iphone.txt")


def iphone_token_path(name):
    if not NAME_RE.match(name or ""):
        raise ValueError("bad token name")
    return os.path.join(TOKENS_DIR, name + ".iphone.age")


def approvers_dir(c):
    return expand(c.get("approvers_dir") or "~/.bws-broker/approvers")


def b32id(prefix):
    return prefix + "_" + base64.b32encode(os.urandom(15)).decode().lower().rstrip("=")


def canonical_bytes(obj):
    return json.dumps(obj, sort_keys=True, separators=(",", ":"), ensure_ascii=True).encode("ascii")


def build_canonical(c, op, key, summary, project, token, host, caller, via, now=None):
    created = int(time.time() if now is None else now)
    return {"v": 1, "request_id": b32id("apr"),
            "nonce": base64.urlsafe_b64encode(os.urandom(16)).decode().rstrip("="),
            "op": op, "key": key, "summary": summary, "project": project, "token": token,
            "host": host, "caller": caller, "via": via, "broker": str(c["broker_name"]),
            "created_at": created, "expires_at": created + phone_window(c)}


# --- P-256 keys and signatures (copied, not imported, from whispera_link/crypto.py; PROTOCOL.md §2.1, §4.5)

def spki_from_pem(text):
    """DER SubjectPublicKeyInfo of a P-256 public key PEM, or None."""
    m = re.search(r"-----BEGIN PUBLIC KEY-----([A-Za-z0-9+/=\s]+)-----END PUBLIC KEY-----", text or "")
    if not m:
        return None
    try:
        der = base64.b64decode("".join(m.group(1).split()), validate=True)
    except ValueError:
        return None
    if len(der) != 91 or not der.startswith(SPKI_P256_PREFIX) or der[26] != 4:
        return None
    return der


def pem_from_spki(der):
    b = base64.b64encode(der).decode()
    return "-----BEGIN PUBLIC KEY-----\n%s\n-----END PUBLIC KEY-----\n" % "\n".join(
        b[i:i + 64] for i in range(0, len(b), 64))


def fingerprint(der):
    return hashlib.sha256(der).hexdigest()


def display_fp(der):
    h = fingerprint(der)[:16]
    return "-".join(h[i:i + 4] for i in range(0, 16, 4))


def p256_verify(spki_der, message, sig_der):
    """ECDSA P-256 / SHA-256 / DER via /usr/bin/openssl. Any doubt = False."""
    if not isinstance(sig_der, bytes) or not 8 <= len(sig_der) <= 80 or not os.path.exists(OPENSSL):
        return False
    tmp = tempfile.mkdtemp(prefix="bws-touchid-v-")
    try:
        os.chmod(tmp, 0o700)
        pub, sig = os.path.join(tmp, "pub.pem"), os.path.join(tmp, "sig.der")
        with open(pub, "w") as f:
            f.write(pem_from_spki(spki_der))
        with open(sig, "wb") as f:
            f.write(sig_der)
        r = subprocess.run([OPENSSL, "dgst", "-sha256", "-verify", pub, "-signature", sig], input=message,
                           capture_output=True, timeout=5, env={"PATH": "/usr/bin:/bin"})
        return r.returncode == 0 and r.stdout.strip() == b"Verified OK"
    except (OSError, subprocess.SubprocessError):
        return False
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def safe_owned(path, want_dir):
    """Not a symlink, owned by us, not group/world-writable, right type."""
    try:
        st = os.lstat(path)
    except OSError:
        return False
    kind_ok = stat.S_ISDIR(st.st_mode) if want_dir else stat.S_ISREG(st.st_mode)
    return kind_ok and st.st_uid == os.getuid() and not st.st_mode & 0o022


def load_pin(c, device_id):
    """SPKI DER of a pinned approve key, or (None, why)."""
    if not DEVICE_RE.match(device_id or ""):
        return None, "bad device id"
    d = approvers_dir(c)
    path = os.path.join(d, device_id + ".pub")
    if not os.path.lexists(path):
        return None, "not pinned"
    if not safe_owned(d, True) or not safe_owned(path, False):
        return None, "pin file or dir is a symlink, not ours, or group/world-writable"
    try:
        with open(path) as f:
            der = spki_from_pem(f.read(4096))
    except (OSError, UnicodeDecodeError):
        der = None
    return (der, "") if der else (None, "not a P-256 public key PEM")


def pinned_devices(c):
    d = approvers_dir(c)
    try:
        names = sorted(os.listdir(d))
    except OSError:
        return []
    return [n[:-4] for n in names if n.endswith(".pub") and DEVICE_RE.match(n[:-4])]


def private_file_ok(path):
    """A regular file we own, not a symlink, no group/other bits at all (0600 or tighter)."""
    try:
        st = os.lstat(path)
    except OSError:
        return False
    return stat.S_ISREG(st.st_mode) and st.st_uid == os.getuid() and not st.st_mode & 0o077


def exe_path(pid):
    """The real executable of a process (proc_pidpath), not its self-reported argv[0]. "" if unknown."""
    try:
        import ctypes
        buf = ctypes.create_string_buffer(4096)
        n = ctypes.CDLL("/usr/lib/libproc.dylib").proc_pidpath(int(pid), buf, 4096)
        return buf.value.decode("utf-8", "replace") if n > 0 else ""
    except Exception:  # noqa: BLE001
        return ""


# --- iPhone token copies: the token sealed together with the approve keys allowed to release it

def seal_iphone_payload(token, fps):
    return IPHONE_COPY_MAGIC + json.dumps({"token": token, "approvers": sorted(set(fps))}, sort_keys=True)


def open_iphone_payload(text):
    """(token, approver fingerprints) of a decrypted iPhone copy. fps None = a pre-binding copy that holds
    the bare token (re-run `approver add` to bind it); token None = malformed."""
    if not text.startswith(IPHONE_COPY_MAGIC):
        return (text.strip() or None), None
    try:
        obj = json.loads(text[len(IPHONE_COPY_MAGIC):])
    except ValueError:
        return None, None
    tok = obj.get("token") if isinstance(obj, dict) else None
    fps = obj.get("approvers") if isinstance(obj, dict) else None
    if not isinstance(tok, str) or not tok.strip() or not isinstance(fps, list) \
            or not all(isinstance(x, str) for x in fps):
        return None, None
    return tok.strip(), [x.lower() for x in fps]


def decrypt_iphone_copy(c, name):
    """Decrypt tokens/<name>.iphone.age with the no-biometry identity (no prompt).
    Returns (token, fps, error); fps None = unbound legacy copy."""
    age = find_tool("age", c.get("age_path"))
    if not age:
        return None, None, "age not found (brew install age age-plugin-se)"
    try:
        r = subprocess.run([age, "-d", "-i", iphone_identity(c), iphone_token_path(name)],
                           capture_output=True, timeout=IPHONE_DECRYPT_S, env=tool_env(), stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        return None, None, "iPhone token decrypt timed out"
    if r.returncode != 0:
        err = r.stderr.decode("utf-8", "replace").strip().splitlines()
        return None, None, "iPhone token decrypt failed: %s" % clean(err[-1] if err else "exit %d" % r.returncode, 160)
    tok, fps = open_iphone_payload(r.stdout.decode("utf-8", "replace"))
    if not tok:
        return None, None, "decrypted iPhone token is empty or malformed"
    return tok, fps, None


def iphone_copy_names():
    try:
        files = os.listdir(TOKENS_DIR)
    except OSError:
        return []
    return sorted(f[:-len(".iphone.age")] for f in files
                  if f.endswith(".iphone.age") and NAME_RE.match(f[:-len(".iphone.age")]))


def rebind_iphone_copies(c, add=None, keep=None):
    """Re-seal every iPhone copy with its approver list changed: add one fingerprint and/or keep only
    `keep`. Decrypts with the no-biometry identity. Returns (names rebound, errors)."""
    age = find_tool("age", c.get("age_path"))
    done, errors = [], []
    if not age or not os.path.exists(RECIPIENT_IPHONE):
        return done, ["no iPhone identity (bws-touchid iphone-setup)"] if iphone_copy_names() else []
    for name in iphone_copy_names():
        tok, fps, err = decrypt_iphone_copy(c, name)
        if err:
            errors.append("%s: %s" % (name, err))
            continue
        fps = set(fps or [])
        if keep is not None:
            fps &= set(keep)
        if add:
            fps.add(add)
        err = encrypt_to(age, RECIPIENT_IPHONE, seal_iphone_payload(tok, fps), iphone_token_path(name))
        del tok
        (errors.append("%s: age encrypt failed: %s" % (name, err)) if err else done.append(name))
    return done, errors


def bound_fps(c):
    """Union of the approver fingerprints sealed in the existing iPhone copies (for new copies)."""
    out = set()
    for name in iphone_copy_names():
        _tok, fps, err = decrypt_iphone_copy(c, name)
        if not err:
            out |= set(fps or [])
    return out


# --- passcode copies: the token sealed with age's scrypt passphrase recipient
#
# The passcode is a decryption key, not a comparison: tokens/<name>.passcode.age is a normal age file
# with one scrypt stanza (random 16-byte salt per file, log2 N = PASSCODE_WORK_FACTOR, ChaCha20-Poly1305),
# written and read by `age -j batchpass`. The passcode reaches age only through AGE_PASSPHRASE_FD, the
# read end of a pipe this process filled; never argv, never the environment, never a file.

def passcode_token_path(name):
    if not NAME_RE.match(name or ""):
        raise ValueError("bad token name")
    return os.path.join(TOKENS_DIR, name + ".passcode.age")


def passcode_copy_names():
    suffix = ".passcode.age"
    try:
        files = os.listdir(TOKENS_DIR)
    except OSError:
        return []
    return sorted(f[:-len(suffix)] for f in files if f.endswith(suffix) and NAME_RE.match(f[:-len(suffix)]))


def touchid_token_names():
    """Names of the Touch ID token files tokens/<name>.age (NAME_RE has no dot, so no copies)."""
    try:
        files = os.listdir(TOKENS_DIR)
    except OSError:
        return []
    return sorted(f[:-4] for f in files if f.endswith(".age") and NAME_RE.match(f[:-4]))


def seal_passcode_payload(token, name):
    """The token name is sealed too, so one copy cannot stand in for another (write for read)."""
    return PASSCODE_COPY_MAGIC + json.dumps({"token": token, "name": name}, sort_keys=True)


def open_passcode_payload(text, name):
    """The token of a decrypted passcode copy, or None (malformed, or sealed for another token)."""
    if not text.startswith(PASSCODE_COPY_MAGIC):
        return None
    try:
        obj = json.loads(text[len(PASSCODE_COPY_MAGIC):])
    except ValueError:
        return None
    if not isinstance(obj, dict) or obj.get("name") != name:
        return None
    tok = obj.get("token")
    return tok.strip() if isinstance(tok, str) and tok.strip() else None


def zero(buf):
    """Overwrite a bytearray in place. Best effort: Python str / bytes copies cannot be wiped."""
    if isinstance(buf, bytearray):
        buf[:] = bytes(len(buf))


def batchpass_plugin(c):
    return find_tool("age-plugin-batchpass", c.get("age_plugin_batchpass_path"))


def passcode_tools(c):
    """'' or why the passcode approver cannot run here."""
    if not find_tool("age", c.get("age_path")):
        return "no-age"
    plugin = batchpass_plugin(c)
    if not plugin or not os.path.isfile(plugin) or not os.access(plugin, os.X_OK):
        return "no-batchpass-plugin"
    return ""


def passcode_pipe(secret):
    """Read end of a pipe that holds `secret` (a bytearray) followed by EOF, for AGE_PASSPHRASE_FD."""
    r, w = os.pipe()
    try:
        with memoryview(secret) as view:
            done = 0
            while done < len(view):
                done += os.write(w, view[done:])
    except OSError:
        os.close(r)
        raise
    finally:
        os.close(w)
    return r


def batchpass_cmd(c, fd, decrypt, path):
    """argv + env for `age -j batchpass`; the passcode is on fd (inherited), never in either."""
    age = find_tool("age", c.get("age_path"))
    env = tool_env()
    env["PATH"] = os.path.dirname(os.path.abspath(batchpass_plugin(c))) + os.pathsep + env["PATH"]
    env["AGE_PASSPHRASE_FD"] = str(fd)
    if decrypt:
        return [age, "-d", "-j", "batchpass", path], env
    env["AGE_PASSPHRASE_WORK_FACTOR"] = str(PASSCODE_WORK_FACTOR)
    return [age, "-e", "-j", "batchpass", "-o", path], env


def passcode_result(code, out, err, name):
    """(token, kind, error) of one passcode decrypt; kind ok | wrong | malformed | error."""
    if code != 0:
        text = (err or b"").decode("utf-8", "replace")
        if "incorrect passphrase" in text.lower():
            return None, "wrong", "wrong passcode"
        lines = text.strip().splitlines()
        return None, "error", "passcode copy decrypt failed: %s" % clean(lines[-1] if lines else "exit %d" % code, 160)
    tok = open_passcode_payload((out or b"").decode("utf-8", "replace"), name)
    if not tok:
        return None, "malformed", "passcode copy is malformed or sealed for another token"
    return tok, "ok", ""


def open_passcode_copy(c, name, secret):
    """Decrypt tokens/<name>.passcode.age with the passcode (blocking; CLI use). (token, kind, error)."""
    fd = passcode_pipe(secret)
    try:
        argv, env = batchpass_cmd(c, fd, True, passcode_token_path(name))
        r = subprocess.run(argv, env=env, pass_fds=(fd,), stdin=subprocess.DEVNULL, capture_output=True,
                           timeout=PASSCODE_DECRYPT_S)
    except subprocess.TimeoutExpired:
        return None, "error", "passcode decrypt timed out"
    finally:
        os.close(fd)
    return passcode_result(r.returncode, r.stdout, r.stderr, name)


def seal_lock(wait=None):
    """An fd holding the exclusive flock on tokens/.passcode-seal.lock, or None if it stayed busy for
    `wait` s (default PASSCODE_SEAL_LOCK_S). `store` holds it while it replaces a token and drops the
    stale passcode copy; `passcode set` / `change` while they seal, re-check and rename their copies, so
    neither can slip between the other's check and rename. Non-blocking with a short retry. Raises
    OSError when the lock file cannot be opened (e.g. it is a symlink)."""
    os.makedirs(TOKENS_DIR, exist_ok=True)
    fd = os.open(os.path.join(TOKENS_DIR, ".passcode-seal.lock"), os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    end = time.time() + (PASSCODE_SEAL_LOCK_S if wait is None else wait)
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return fd
        except BlockingIOError:
            if time.time() >= end:
                os.close(fd)
                return None
            time.sleep(0.05)


def take_seal_lock(what):
    """seal_lock() or die: `what` is the command that cannot run now."""
    try:
        fd = seal_lock()
    except OSError as e:
        die("%s: cannot lock %s: %s" % (what, os.path.join(TOKENS_DIR, ".passcode-seal.lock"), clean(e, 120)))
    if fd is None:
        die("%s: another store or passcode set/change is running; try again when it finishes" % what)
    return fd


def seal_passcode_copy(c, secret, token, name):
    """Encrypt `token` to tokens/<name>.passcode.age.tmp (0600) with the passcode. '' or an error; the
    caller renames the .tmp files once every copy is sealed."""
    tmp = passcode_token_path(name) + ".tmp"
    fd = passcode_pipe(secret)
    old = os.umask(0o077)
    try:
        argv, env = batchpass_cmd(c, fd, False, tmp)
        r = subprocess.run(argv, input=seal_passcode_payload(token, name).encode(), env=env, pass_fds=(fd,),
                           capture_output=True, timeout=PASSCODE_DECRYPT_S)
    except subprocess.TimeoutExpired:
        return "age timed out"
    finally:
        os.close(fd)
        os.umask(old)
    if r.returncode != 0 or not os.path.isfile(tmp):
        try:
            os.remove(tmp)
        except OSError:
            pass
        return clean(r.stderr.decode("utf-8", "replace"), 200) or "exit %d" % r.returncode
    os.chmod(tmp, 0o600)
    return ""


# --- passcode attempt counter: PASSCODE_STATE, 0600, flock'd read-modify-write
#
# Missing, unsafe (symlink, not ours, group/other bits) or corrupt state = locked: deleting the file
# does not reset the counter. Every attempt is counted BEFORE the decrypt runs (a verify that is killed
# still counts) and only a correct passcode or Touch ID (passcode unlock / set / change) resets it.

def passcode_backoff(failures):
    return 0.0 if failures < 1 else PASSCODE_BACKOFF_S * 4 ** (failures - 1)


PC_BUSY = -1   # _pc_state_open: another process holds the lock past PASSCODE_LOCK_S (= locked for now)


def _pc_state_open(create=False):
    """An exclusively locked fd of PASSCODE_STATE, None (missing or unsafe), or PC_BUSY. Non-blocking
    with a short retry: callers run under GATE_LOCK, and a stuck holder must not stall every approval."""
    try:
        fd = os.open(PASSCODE_STATE, os.O_RDWR | os.O_NOFOLLOW | (os.O_CREAT if create else 0), 0o600)
    except OSError:
        return None
    try:
        end = time.time() + PASSCODE_LOCK_S
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.time() >= end:
                    os.close(fd)
                    return PC_BUSY
                time.sleep(0.05)
        st = os.fstat(fd)
        if stat.S_ISREG(st.st_mode) and st.st_uid == os.getuid() and not st.st_mode & 0o077:
            return fd
    except OSError:
        pass
    os.close(fd)
    return None


def _pc_read(fd):
    try:
        os.lseek(fd, 0, os.SEEK_SET)
        st = json.loads(os.read(fd, 4096).decode("utf-8"))
    except (OSError, ValueError):
        return None
    if not isinstance(st, dict):
        return None
    f, last, locked = st.get("failures"), st.get("last_failure"), st.get("locked")
    if not isinstance(f, int) or isinstance(f, bool) or f < 0 or not isinstance(last, (int, float)) \
            or isinstance(last, bool) or not isinstance(locked, bool):
        return None
    return {"failures": f, "last_failure": float(last), "locked": locked}


def _pc_write(fd, st):
    data = json.dumps({"v": 1, "failures": st["failures"], "last_failure": st["last_failure"],
                       "locked": st["locked"]}).encode()
    os.lseek(fd, 0, os.SEEK_SET)
    os.ftruncate(fd, 0)
    os.write(fd, data)
    os.fsync(fd)


def passcode_state():
    """{"failures", "last_failure", "locked"}, None = missing / unsafe / corrupt, or PC_BUSY (both = locked)."""
    fd = _pc_state_open()
    if fd is None or fd == PC_BUSY:
        return fd
    try:
        return _pc_read(fd)
    finally:
        os.close(fd)


def passcode_check(st, now):
    """(why, wait_s): why '' = a passcode may be tried now; "locked" or "backoff" otherwise."""
    if st is None:
        return "locked(state-missing-or-unsafe)", 0.0
    if st == PC_BUSY:
        return "locked(state-busy)", 0.0
    if st["locked"] or st["failures"] >= PASSCODE_MAX_FAILURES:
        return "locked", 0.0
    wait = st["last_failure"] + passcode_backoff(st["failures"]) - now
    return ("backoff", wait) if wait > 0 else ("", 0.0)


def passcode_begin_attempt(now=None):
    """Atomically check and count one attempt, before it is verified. (failures now, why); why '' = go."""
    now = time.time() if now is None else now
    fd = _pc_state_open()
    if fd is None or fd == PC_BUSY:
        return None, passcode_check(fd, now)[0]
    try:
        st = _pc_read(fd)
        why, _wait = passcode_check(st, now)
        if why:
            return (st or {}).get("failures"), why
        st["failures"] += 1
        st["last_failure"] = now
        st["locked"] = st["failures"] >= PASSCODE_MAX_FAILURES
        _pc_write(fd, st)
        return st["failures"], ""
    finally:
        os.close(fd)


def passcode_reset(create=False):
    """Clear failures and lockout: after a correct passcode, or (create=True) after Touch ID in
    passcode set / change / unlock, which also replaces a missing or unsafe state file."""
    fd = _pc_state_open(create)
    if fd == PC_BUSY:   # never delete a file someone else has locked
        return False
    if fd is None and create:
        try:
            os.remove(PASSCODE_STATE)   # unsafe (symlink, wrong mode): the owner just used Touch ID
        except OSError:
            pass
        fd = _pc_state_open(True)
    if fd is None or fd == PC_BUSY:
        return False
    try:
        _pc_write(fd, {"failures": 0, "last_failure": 0, "locked": False})
        return True
    finally:
        os.close(fd)


def passcode_failed(c, tname, failures, kind, how):
    """Audit + lockout notice for one failed attempt (never the passcode itself)."""
    locked = failures is not None and failures >= PASSCODE_MAX_FAILURES
    log({"op": "passcode", "result": "locked" if locked else kind, "token": tname,
         "detail": "failures=%s/%d via=%s" % (failures, PASSCODE_MAX_FAILURES, how)})
    if locked:
        notify("bws-touchid: passcode locked", "%d wrong passcodes; Touch ID only until: bws-touchid passcode "
               "unlock" % PASSCODE_MAX_FAILURES, c)


def kill_group(proc):
    """SIGTERM, then SIGKILL, the process group of a start_new_session child."""
    if proc is None or proc.poll() is not None:
        return
    for sig, wait in ((signal.SIGTERM, KILL_GRACE_S), (signal.SIGKILL, 5)):
        try:
            os.killpg(proc.pid, sig)
        except OSError:
            pass
        try:
            proc.wait(wait)
            return
        except subprocess.TimeoutExpired:
            continue


# --- the legs

class Leg(object):
    """One approver in the race. poll() returns None while undecided, else a decision dict:
    {"kind": "approve"|"deny"|"unavailable", "approver": str, "why": str, ...}. A leg that returned a
    decision is no longer live. cancel(reason) stops it (kills the prompt / tells the daemon)."""
    name = "?"
    live = False

    def fileno_or_none(self):
        return None

    def poll(self, now):
        raise NotImplementedError

    def cancel(self, reason):
        pass

    def token(self):
        """After an approve: (token, None) or (None, error)."""
        raise NotImplementedError


class TouchIdLeg(Leg):
    name = "touchid"

    def __init__(self, c, tname, deadline):
        self.c, self.tname, self.deadline = c, tname, deadline
        self.proc, self._tok, self.error = None, None, ""

    def start(self):
        path = token_path(self.tname)
        if not os.path.isfile(path):
            self.error = "no token named '%s' on the broker Mac (owner: bws-touchid store %s)" % (self.tname, self.tname)
            return False
        age = find_tool("age", self.c.get("age_path"))
        if not age:
            self.error = "age not found (brew install age age-plugin-se)"
            return False
        self.proc = subprocess.Popen([age, "-d", "-i", IDENTITY, path], stdin=subprocess.DEVNULL,
                                     stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=tool_env(),
                                     start_new_session=True)
        self.live = True
        return True

    def poll(self, now):
        if not self.live:
            return None
        if self.proc.poll() is None:
            if now >= self.deadline:
                self.cancel("timeout")
                self.error = "timed out waiting for Touch ID"
                return {"kind": "unavailable", "approver": "touchid", "why": "timeout"}
            return None
        out, err = self.proc.communicate()
        self.live = False
        if self.proc.returncode == 0:
            tok = out.decode("utf-8", "replace").strip()
            if tok:
                self._tok = tok
                return {"kind": "approve", "approver": "touchid", "why": ""}
            self.error = "decrypted token is empty"
            return {"kind": "unavailable", "approver": "touchid", "why": "empty"}
        lines = err.decode("utf-8", "replace").strip().splitlines()
        self.error = "Touch ID / decrypt failed: %s" % clean(lines[-1] if lines else "exit %d" % self.proc.returncode, 160)
        if "cancel" in err.decode("utf-8", "replace").lower():
            return {"kind": "deny", "approver": "touchid", "why": "cancel"}
        return {"kind": "unavailable", "approver": "touchid", "why": "error"}

    def cancel(self, reason):
        if self.proc is None or self.proc.poll() is not None:
            self.live = False
            return
        for sig, wait in ((signal.SIGTERM, KILL_GRACE_S), (signal.SIGKILL, 5)):
            try:
                os.killpg(self.proc.pid, sig)
            except OSError:
                pass
            try:
                self.proc.wait(wait)
                break
            except subprocess.TimeoutExpired:
                continue
        try:
            self.proc.communicate(timeout=1)
        except (subprocess.SubprocessError, ValueError, OSError):
            pass
        self.live = False

    def token(self):
        return (self._tok, None) if self._tok else (None, self.error or "no token")


class IphoneLeg(Leg):
    """Client of ~/.whispera-link/approvals.sock: one connection per approval (PROTOCOL.md §8)."""
    name = "iphone"

    def __init__(self, c, canon, tname, prefer_device=""):
        self.c, self.canon, self.tname = c, canon, tname
        self.prefer_device = prefer_device or None
        self.raw = canonical_bytes(canon)
        self.rid = canon["request_id"]
        self.sock, self.buf, self.why, self.device = None, b"", "", ""
        self.devices = 0
        self._tok, self.error = None, ""

    def start(self):
        """Connect + request + ack. False (with self.why) = leg unavailable, never a deny."""
        if not os.path.isfile(iphone_identity(self.c)):
            self.why = "no-iphone-identity"
        elif not os.path.isfile(iphone_token_path(self.tname)):
            self.why = "no-iphone-token-copy"
        elif not private_file_ok(iphone_identity(self.c)) or not private_file_ok(iphone_token_path(self.tname)):
            self.why = "unsafe-file-mode"   # identity / copy must be ours, not a symlink, 0600
        elif not any(load_pin(self.c, d)[0] for d in pinned_devices(self.c)):
            self.why = "no-pinned-device"
        if self.why:
            return False
        path = expand(self.c.get("approvals_socket") or "~/.whispera-link/approvals.sock")
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            s.settimeout(PHONE_CONNECT_S)
            s.connect(path)
        except (OSError, socket.timeout) as e:
            s.close()
            self.why = "daemon-unreachable(%s)" % type(e).__name__
            return False
        self.sock = s
        try:  # the daemon must run as us (it is only a relay, but do not even talk to another uid)
            peer_uid = struct.unpack_from("Ii", s.getsockopt(SOL_LOCAL, LOCAL_PEERCRED, 76))[1]
        except OSError:
            peer_uid = -1
        if peer_uid != os.getuid():
            self._close()
            self.why = "daemon-uid-mismatch"
            return False
        allowed = self.c.get("approvals_peer_paths") or []
        if allowed:  # optional: only these executables may serve the approvals socket
            try:
                peer_pid = struct.unpack("i", s.getsockopt(SOL_LOCAL, LOCAL_PEERPID, 4))[0]
            except OSError:
                peer_pid = -1
            exe = exe_path(peer_pid) if peer_pid > 0 else ""
            if not isinstance(allowed, list) or exe not in allowed:
                self._close()
                self.why = "daemon-not-allowed(%s)" % clean(os.path.basename(exe) or "?", 40)
                return False
        try:
            req = {"op": "approval.request", "v": 1, "request_id": self.rid,
                   "canonical_b64": base64.b64encode(self.raw).decode(), "expires_at": self.canon["expires_at"],
                   "prefer_device": self.prefer_device}
            s.sendall(json.dumps(req).encode() + b"\n")
            end = time.time() + PHONE_ACK_S
            line = None
            while line is None:
                left = end - time.time()
                if left <= 0:
                    raise socket.timeout()
                s.settimeout(left)
                line = self._next_line(s.recv(4096) or None)
            msg = json.loads(line)
        except socket.timeout:
            self._close()
            self.why = "no-ack"
            return False
        except (OSError, ValueError, EOFError):
            self._close()
            self.why = "bad-ack"
            return False
        if not isinstance(msg, dict) or msg.get("request_id") != self.rid:
            self._close()
            self.why = "bad-ack"
            return False
        if msg.get("op") == "approval.error":
            self._close()
            self.why = "daemon-error(%s)" % clean(msg.get("code"), 30)
            return False
        n = msg.get("devices")
        if msg.get("op") != "approval.ack" or not isinstance(n, int) or isinstance(n, bool) or n < 1:
            self._close()
            self.why = "no-devices" if msg.get("op") == "approval.ack" else "bad-ack"
            return False
        self.devices = n
        s.setblocking(False)
        self.live = True
        return True

    def _next_line(self, chunk):
        """Feed bytes; return one complete line or None. EOF (chunk None) raises EOFError."""
        if chunk is None:
            raise EOFError()
        self.buf += chunk
        nl = self.buf.find(b"\n")
        if nl < 0:
            if len(self.buf) > MAX_DAEMON_LINE:
                raise ValueError("line too long")
            return None
        line, self.buf = self.buf[:nl], self.buf[nl + 1:]
        if len(line) > MAX_DAEMON_LINE:
            raise ValueError("line too long")
        return line

    def fileno_or_none(self):
        return self.sock if self.live else None

    def _send(self, obj):
        if self.sock is None:
            return
        try:
            self.sock.setblocking(True)
            self.sock.settimeout(1)
            self.sock.sendall(json.dumps(obj).encode() + b"\n")
        except OSError:
            pass

    def _close(self):
        if self.sock is not None:
            try:
                self.sock.close()
            except OSError:
                pass
        self.sock = None
        self.live = False

    def _result(self, outcome):
        self._send({"op": "approval.result", "request_id": self.rid, "outcome": outcome})
        self._close()

    def poll(self, now):
        if not self.live:
            return None
        line = None
        try:
            if self.buf.find(b"\n") >= 0:
                line = self._next_line(b"")
            else:
                try:
                    chunk = self.sock.recv(65536)
                except (BlockingIOError, InterruptedError):
                    return None
                line = self._next_line(chunk or None)
        except EOFError:
            self._close()
            return {"kind": "unavailable", "approver": "iphone", "why": "daemon-eof"}
        except ValueError:
            self._result("malformed")
            return {"kind": "deny", "approver": "iphone", "why": "malformed"}
        except OSError as e:
            self._close()
            return {"kind": "unavailable", "approver": "iphone", "why": "socket-error(%s)" % type(e).__name__}
        if line is None:
            return None
        return self._decide(line, now)

    def _decide(self, line, now):
        try:
            msg = json.loads(line)
        except ValueError:
            msg = None
        if not isinstance(msg, dict) or msg.get("op") != "approval.decision" \
                or msg.get("decision") not in ("approve", "deny"):
            self._result("malformed")
            return {"kind": "deny", "approver": "iphone", "why": "malformed"}
        dev = msg.get("device_id") if isinstance(msg.get("device_id"), str) else ""
        self.device = dev if DEVICE_RE.match(dev) else ""
        who = "iphone:" + (self.device or "?")
        der = load_pin(self.c, self.device)[0] if self.device else None
        if msg["decision"] == "deny":
            # A deny is unsigned (PROTOCOL v1). Only a pinned approver's deny is final; any other paired or
            # rogue device only ends the phone leg, and Touch ID keeps waiting (audit M1).
            if der is None:
                self._result("unknown_device")
                return {"kind": "advisory", "approver": who, "why": "deny-from-unpinned-device"}
            self._result("accepted")
            return {"kind": "deny", "approver": who, "why": "phone-deny"}
        outcome = "accepted"
        if msg.get("request_id") != self.rid:
            outcome = "malformed"
        elif der is None:  # not a pinned approver: it cannot approve, and it must not cancel Touch ID either
            self._result("unknown_device")
            return {"kind": "advisory", "approver": who, "why": "unknown_device"}
        elif now > self.canon["expires_at"]:
            outcome = "expired"
        else:
            sig = msg.get("signature")
            try:
                sig_der = base64.b64decode(sig, validate=True) if isinstance(sig, str) else None
            except ValueError:
                sig_der = None
            if not sig_der or not p256_verify(der, b"WL1-APPROVE\n" + self.raw, sig_der):
                outcome = "bad_signature"
        if outcome == "accepted":
            # The signer must also be bound inside the sealed iPhone copy: a pin file alone (plain file,
            # writable by any same-user process) does not unlock the token (audit H1, broker route).
            tok, fps, err = decrypt_iphone_copy(self.c, self.tname)
            if err:
                self.error = err  # approved, but no token: token() reports it; never the Touch ID copy
            elif fps is None or fingerprint(der) not in fps:
                del tok
                self._result("unknown_device")
                return {"kind": "advisory", "approver": who,
                        "why": "unbound_device" if fps is not None else "unbound_device(legacy-copy)"}
            else:
                self._tok = tok
        self._result(outcome)
        if outcome != "accepted":  # fail closed: something is tampering or confused
            return {"kind": "deny", "approver": who, "why": outcome}
        return {"kind": "approve", "approver": who, "why": ""}

    def cancel(self, reason):
        if self.live:
            self._send({"op": "approval.cancel", "request_id": self.rid, "reason": reason})
        self._close()

    def token(self):
        """The token from the no-biometry iPhone copy, unsealed while checking the binding. Never falls back
        to the Touch ID copy."""
        tok, self._tok = self._tok, None
        return (tok, None) if tok else (None, self.error or "no iPhone token")


# AppleScript for the passcode dialog. All text arrives through argv (on run argv); the answer leaves on
# stdout as "P<passcode>", "T" when the dialog gave up; Deny is error -128.
DIALOG_SCRIPT = (
    "on run argv",
    "set r to display dialog (item 1 of argv) with title (item 2 of argv) default answer \"\" with hidden answer "
    "buttons {\"Deny\", \"Approve\"} default button \"Approve\" cancel button \"Deny\" with icon caution "
    "giving up after ((item 3 of argv) as integer)",
    "if gave up of r then return \"T\"",
    "return \"P\" & (text returned of r)",
    "end run",
)


class PasscodeLeg(Leg):
    """A hidden-answer dialog on the broker Mac; the answer is checked by decrypting
    tokens/<name>.passcode.age (scrypt), not compared. A wrong answer re-prompts after the backoff until
    the lockout. The passcode travels osascript stdout -> this process (bytearray, zeroed) -> a pipe
    fd for age, and nowhere else."""
    name = "passcode"

    def __init__(self, c, tname, deadline, prompt, notes):
        self.c, self.tname, self.deadline, self.prompt, self.notes = c, tname, deadline, prompt, notes
        self.proc, self.phase, self.why, self.error = None, "", "", ""
        self.next_at, self.failures, self.verify_by, self._tok = 0.0, 0, 0.0, None
        self.dialog_pid = None
        self.dialog = expand(c.get("osascript_path")) or OSASCRIPT

    def start(self, now=None):
        now = time.time() if now is None else now
        path = passcode_token_path(self.tname)
        if not os.path.lexists(path):
            self.why = "no-passcode-copy"
        elif not private_file_ok(path) or not safe_owned(TOKENS_DIR, True):
            self.why = "unsafe-file-mode"
        elif passcode_tools(self.c):
            self.why = passcode_tools(self.c)
        elif not os.path.isfile(self.dialog) or not os.access(self.dialog, os.X_OK):
            self.why = "no-dialog"
        else:
            why, wait = passcode_check(passcode_state(), now)
            if why == "backoff" and now + wait >= self.deadline - 5:
                self.why = "backoff(%ds)" % int(wait + 1)
            elif why and why != "backoff":
                self.why = why
        if self.why:
            return False
        self.live, self.phase, self.next_at = True, "wait", now   # the first poll shows the dialog
        return True

    def _show(self, now):
        text = self.prompt
        if self.failures:
            text += "\n\nWrong passcode (%d of %d attempts used)." % (self.failures, PASSCODE_MAX_FAILURES)
        text += "\n\nEnter your bws-touchid passcode to approve."
        argv = [self.dialog]
        for line in DIALOG_SCRIPT:
            argv += ["-e", line]
        argv += [text, "bws-touchid passcode", str(max(1, int(self.deadline - now)))]
        try:
            self.proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                         stderr=subprocess.PIPE, bufsize=0, env={"PATH": "/usr/bin:/bin", "HOME": HOME},
                                         start_new_session=True)
        except OSError as e:   # fd exhaustion, a dialog program that cannot exec: end this leg, not the gate
            self.proc = None
            self.error = "passcode dialog failed: %s" % clean(e, 120)
            return self._end("unavailable", "error")
        self.phase = "prompt"
        self._remember_dialog()
        return None

    def _remember_dialog(self):
        """Record the dialog (its own session) so a broker restarted after a SIGKILL can close it."""
        self.dialog_pid = self.proc.pid
        info = {"broker": os.getpid(), "pid": self.proc.pid, "lstart": ps_field(self.proc.pid, "lstart")}
        tmp = PASSCODE_DIALOG_PID + ".tmp"
        try:
            fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
            with os.fdopen(fd, "w") as f:
                f.write(json.dumps(info))
            os.replace(tmp, PASSCODE_DIALOG_PID)
        except OSError:
            pass   # best effort: the dialog still gives up on its own at the deadline

    def _forget_dialog(self):
        if self.dialog_pid is None:
            return
        self.dialog_pid = None
        try:
            os.remove(PASSCODE_DIALOG_PID)
        except OSError:
            pass

    def _end(self, kind, why):
        self.live = False
        self._reap()
        self._forget_dialog()
        return {"kind": kind, "approver": "passcode", "why": why}

    def _reap(self):
        if self.proc is not None:
            for f in (self.proc.stdout, self.proc.stderr):
                try:
                    if f:
                        f.close()
                except OSError:
                    pass

    def poll(self, now):
        if not self.live:
            return None
        if self.phase == "wait":
            if now >= self.deadline:
                return self._end("unavailable", "timeout")
            if now < self.next_at:
                return None
            why, wait = passcode_check(passcode_state(), now)
            if why == "backoff":
                self.next_at = now + wait
                return None
            if why:
                return self._end("unavailable", why)
            return self._show(now)
        if self.proc.poll() is None:
            if self.phase == "verify":   # bounded by verify_by, not the deadline: a passcode typed late still counts
                if now < self.verify_by:
                    return None
                kill_group(self.proc)    # a stuck age: a tool error, not a guess
                if self.proc.returncode is not None and self.proc.returncode >= 0:
                    return self._verified(now)   # it finished as we stopped it: its real outcome
                self.error = "passcode decrypt timed out"
                passcode_failed(self.c, self.tname, self.failures, "error", "dialog")
                self.notes.append("passcode-error:%s" % self.failures)
                return self._end("unavailable", "error")
            if now >= self.deadline:
                self.cancel("timeout")
                return {"kind": "unavailable", "approver": "passcode", "why": "timeout"}
            return None
        return self._answered(now) if self.phase == "prompt" else self._verified(now)

    def _answered(self, now):
        self._forget_dialog()   # the dialog has exited
        buf = bytearray(PASSCODE_MAX_LEN * 4 + 8)
        n = 0
        try:
            with memoryview(buf) as view:
                while n < len(buf):
                    k = self.proc.stdout.readinto(view[n:])
                    if not k:
                        break
                    n += k
            err = self.proc.stderr.read(4096) or b""
        except OSError:
            err = b""
        self._reap()
        try:
            if self.proc.returncode != 0:
                return self._end("deny", "cancel") if b"(-128)" in err else self._end("unavailable", "dialog-error")
            while n and buf[n - 1] in (10, 13):
                n -= 1
            if n and buf[0] == ord("T"):
                return self._end("unavailable", "gave-up")
            if not n or buf[0] != ord("P") or n == len(buf):
                return self._end("unavailable", "dialog-error")
            if n == 1:                    # empty answer: no attempt, ask again while there is time
                if now >= self.deadline:
                    return self._end("unavailable", "timeout")
                return self._show(now)
            failures, why = passcode_begin_attempt(now)
            if why:
                return self._end("unavailable", why)
            self.failures = failures
            secret = buf[1:n]             # a bytearray slice: one copy, zeroed below
            try:
                fd = passcode_pipe(secret)
            except OSError as e:          # no fds left: counted (it already was), not a guess
                self.error = "passcode decrypt failed: %s" % clean(e, 120)
                passcode_failed(self.c, self.tname, failures, "error", "dialog")
                self.notes.append("passcode-error:%s" % failures)
                return self._end("unavailable", "error")
            finally:
                zero(secret)
            try:
                argv, env = batchpass_cmd(self.c, fd, True, passcode_token_path(self.tname))
                self.proc = subprocess.Popen(argv, env=env, pass_fds=(fd,), stdin=subprocess.DEVNULL,
                                             stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True)
            except (OSError, TypeError, ValueError) as e:   # age vanished since start(): counted, not a guess
                self.proc = None
                self.error = "passcode decrypt failed: %s" % clean(e, 120)
                passcode_failed(self.c, self.tname, failures, "error", "dialog")
                self.notes.append("passcode-error:%s" % failures)
                return self._end("unavailable", "error")
            finally:
                os.close(fd)
            self.phase, self.verify_by = "verify", now + PASSCODE_DECRYPT_S
            return None
        finally:
            zero(buf)

    def _verified(self, now):
        out, err = self.proc.communicate()
        tok, kind, error = passcode_result(self.proc.returncode, out, err, self.tname)
        del out
        if tok:
            passcode_reset()
            self._tok = tok
            return self._end("approve", "")
        self.error = error
        passcode_failed(self.c, self.tname, self.failures, kind, "dialog")
        self.notes.append("passcode-%s:%s" % (kind, self.failures))
        if kind == "malformed":           # right passcode, wrong file: someone swapped copies
            return self._end("deny", "copy-mismatch")
        if kind == "error":               # plugin crash, OOM, missing plugin: counted, but no "Wrong passcode"
            return self._end("unavailable", "error")
        if self.failures >= PASSCODE_MAX_FAILURES:
            return self._end("unavailable", "locked")
        self.phase, self.next_at = "wait", now + passcode_backoff(self.failures)
        return None

    def cancel(self, reason):
        """Stop at once (the caller holds GATE_LOCK). A verify still running is killed: its attempt was
        counted before it started, so it stays counted and is logged as abandoned. One that finished
        before it could be killed (not read yet, or exiting as the signal arrived) is settled by its real
        outcome; its token is discarded."""
        if self.live and self.phase == "verify" and self.proc is not None:
            kill_group(self.proc)
            if self.proc.returncode is None or self.proc.returncode < 0:   # killed (or unkillable)
                locked = self.failures >= PASSCODE_MAX_FAILURES
                log({"op": "passcode", "result": "abandoned", "token": self.tname,
                     "detail": "failures=%s/%d via=dialog reason=%s%s" % (
                         self.failures, PASSCODE_MAX_FAILURES, clean(reason, 40), " locked" if locked else "")})
                self.notes.append("passcode-abandoned:%s" % self.failures)
                if locked:
                    notify("bws-touchid: passcode locked", "%d passcode attempts; Touch ID only until: bws-touchid "
                           "passcode unlock" % PASSCODE_MAX_FAILURES, self.c)
            else:
                try:
                    out, err = self.proc.communicate(timeout=1)
                except (OSError, ValueError, subprocess.TimeoutExpired):
                    out, err = b"", b""
                tok, kind, _error = passcode_result(self.proc.returncode, out, err, self.tname)
                del out
                if tok:
                    passcode_reset()
                else:
                    passcode_failed(self.c, self.tname, self.failures, kind, "dialog")
                    self.notes.append("passcode-%s:%s" % (kind, self.failures))
                del tok
        kill_group(self.proc)
        self._reap()
        self._forget_dialog()
        self.live = False

    def token(self):
        tok, self._tok = self._tok, None
        return (tok, None) if tok else (None, self.error or "no passcode token")


def sweep_stale_dialog(c):
    """At broker start: close a passcode dialog left open by a broker that was SIGKILLed (the dialog runs
    in its own session, so it outlives the broker until it gives up at its deadline). Only the process
    named in PASSCODE_DIALOG_PID is touched, and only if its broker is gone and it is still that dialog:
    same uid, same start time, our dialog program in its argv with the passcode dialog title."""
    path = PASSCODE_DIALOG_PID
    if not os.path.lexists(path):
        return
    try:
        info = None
        if private_file_ok(path):
            with open(path) as f:
                info = json.loads(f.read(4096))
        broker, pid, lstart = info["broker"], info["pid"], info["lstart"]
        if not (isinstance(broker, int) and isinstance(pid, int) and pid > 1 and isinstance(lstart, str) and lstart):
            raise ValueError
    except (OSError, ValueError, TypeError, KeyError):
        broker = pid = None
    if broker is not None and broker != os.getpid():
        try:
            os.kill(broker, 0)
            return   # that broker is still running: the dialog is its own
        except ProcessLookupError:
            pass
        except OSError:
            return
    if pid is not None:
        dialog = expand(c.get("osascript_path")) or OSASCRIPT
        args = ps_field(pid, "args")
        if (" %s " % dialog) in (" %s " % args) and " bws-touchid passcode " in args + " " and \
                ps_field(pid, "uid") == str(os.getuid()) and ps_field(pid, "lstart") == lstart:
            try:
                os.killpg(pid, signal.SIGTERM)   # its own session: pgid == pid
                log({"op": "passcode", "result": "swept", "detail": "closed a stale dialog pid=%d" % pid})
            except OSError:
                pass
    try:
        os.remove(path)
    except OSError:
        pass


def approve_gate(c, rec, tname, title, msg, canon_fields, prefer_device=""):
    """Get one approval and the decrypted token. Returns (token, None) or (None, (result, detail, error)).
    Sets rec approver / request_id / notes for the audit line.

    Deadlines: the Touch ID leg keeps its 120 s; a live iPhone leg may answer until expires_at
    (created_at + approval_wait_s, default 300) + PHONE_GRACE_S. The gate waits for the later of the
    legs it actually has, so with the phone unavailable Touch ID behaves exactly as before. The opt-in
    passcode leg shows its dialog for PASSCODE_WINDOW_S and races the others the same way."""
    if is_default_approvers(c):  # exactly the pre-approver behaviour
        notify(title, msg, c)
        token, err = decrypt_token(tname, c)
        return (token, None) if not err else (None, ("auth-failed", err, err))
    approvers = approvers_of(c)
    if approvers is None:
        return None, ("rejected", "bad approvers config", "bad approvers config")
    canon = build_canonical(c, **canon_fields)
    rec["request_id"] = canon["request_id"]
    rec["approver"] = "none"
    notes = rec.setdefault("notes", [])
    created = canon["created_at"]
    deadline_touchid = created + TOUCHID_WINDOW_S
    deadline_phone = canon["expires_at"] + PHONE_GRACE_S
    deadline_pc = created + PASSCODE_WINDOW_S
    phone = touch = pc = None
    try:
        if "iphone" in approvers:
            phone = IphoneLeg(c, canon, tname, prefer_device)
            if not phone.start():
                notes.append("iphone-unavailable:" + phone.why)
                phone = None
        if "passcode" in approvers:
            pc = PasscodeLeg(c, tname, deadline_pc, "%s\n%s" % (clean(title, 80), clean(msg, 200)), notes)
            if not pc.start():
                notes.append("passcode-unavailable:" + pc.why)
                pc = None
        ends = ([deadline_touchid] if "touchid" in approvers else []) + ([deadline_phone] if phone else []) + \
            ([deadline_pc] if pc else [])
        deadline = max(ends) if ends else deadline_phone
        window = int(deadline - created)
        who = "Touch ID or iPhone" if "passcode" not in approvers else \
            " or ".join({"touchid": "Touch ID", "iphone": "iPhone", "passcode": "passcode"}[a] for a in approvers)
        if "touchid" in approvers:
            notify(title, msg + (" — or approve on iPhone" if phone else "") + (" — or enter passcode" if pc else ""), c)
            touch = TouchIdLeg(c, tname, deadline_touchid)
            if not touch.start():
                notes.append("touchid-unavailable:start")
        elif pc:
            notify(title, msg + " — enter passcode" + (" or approve on iPhone" if phone else ""), c)
        legs = [x for x in (phone, pc, touch) if x is not None]

        touch_cancelled = False

        def verifying():   # a passcode typed just before the deadline: its verify (bounded by verify_by) may finish
            return pc is not None and pc.live and pc.phase == "verify"

        def dialog_in_use():   # the passcode dialog is on screen, or the passcode typed in it is being checked
            return pc is not None and pc.live and pc.phase in ("prompt", "verify")
        while True:
            now = time.time()
            if touch_cancelled and not (pc is not None and pc.live):
                # the passcode leg the owner switched to has ended: the Touch ID cancel is final after all
                for leg in legs:
                    if leg.live:
                        leg.cancel("touchid_denied")
                rec["approver"] = "touchid"
                return None, ("denied", "by=touchid", touch.error)
            if now >= deadline:
                if not verifying():
                    for leg in legs:
                        leg.cancel("timeout")
                    return None, ("timeout", "", "no approval within %ds (%s)" % (window, who))
                for leg in legs:
                    if leg is not pc and leg.live:
                        leg.cancel("timeout")
            live = [x for x in legs if x.live]
            if not live:
                if touch is not None and touch.error and phone is None and "passcode" not in approvers:
                    return None, ("auth-failed", touch.error, touch.error)  # today's error
                if "passcode" not in approvers:
                    return None, ("no-approver", "",
                                  "no approver available (Touch ID unavailable, iPhone not connected)")
                return None, ("no-approver", "", "no approver available (%s)" % ", ".join(notes[-3:] or ["none"]))
            socks = [x.fileno_or_none() for x in live if x.fileno_or_none() is not None]
            if socks:
                select.select(socks, [], [], 0.1)
            else:
                time.sleep(0.1)
            now = time.time()
            if now >= deadline and not verifying():
                continue
            for leg in live:
                d = leg.poll(now)
                if d is None:
                    continue
                if d["kind"] == "unavailable":
                    notes.append("%s-unavailable:%s" % (leg.name, d["why"]))
                    continue
                if d["kind"] == "advisory":  # an answer we do not act on; the other leg keeps going
                    notes.append("%s-ignored:%s" % (leg.name, d["why"]))
                    if any(x.live for x in legs if x is not leg):
                        continue
                    rec["approver"] = d["approver"]
                    return None, ("denied", "by=%s outcome=%s" % (d["approver"], d["why"]),
                                  "iPhone answer not accepted (%s) and no other approver" % d["why"])
                other = [x for x in legs if x is not leg]
                if leg is touch and d["kind"] == "deny" and d["why"] == "cancel" and dialog_in_use():
                    # Cancelling the sheet only drops Touch ID while the passcode dialog is on screen (or its
                    # passcode is being checked), so the owner can type the passcode instead; Deny in the
                    # dialog is still final. Otherwise (only the phone, or the dialog in its backoff wait
                    # with nothing on screen to Deny) a Touch ID cancel is a deny and ends every leg.
                    touch_cancelled = True
                    notes.append("touchid-cancelled")
                    continue
                rec["approver"] = d["approver"]
                if leg is touch:
                    reason = "touchid_approved" if d["kind"] == "approve" else "touchid_denied"
                    for x in other:
                        x.cancel(reason)
                    if d["kind"] == "deny":
                        return None, ("denied", "by=touchid", touch.error)
                    return touch.token()[0], None
                if leg is pc:
                    # PROTOCOL v1 cancel reasons have no "passcode": it is a local approval on this Mac,
                    # so the phone hears the Touch ID ones.
                    reason = "touchid_approved" if d["kind"] == "approve" else "touchid_denied"
                    for x in other:
                        x.cancel(reason)
                    if d["kind"] == "deny":
                        if d["why"] == "cancel":
                            return None, ("denied", "by=passcode", "denied in the passcode dialog")
                        return None, ("denied", "by=passcode outcome=" + d["why"],
                                      "passcode approval rejected (%s)" % d["why"])
                    token, err = pc.token()
                    return (token, None) if not err else (None, ("auth-failed", err, err))
                for x in other:  # the phone decided: stop the Touch ID prompt first
                    x.cancel("phone_decided")
                if d["kind"] == "deny":
                    detail = "by=%s" % d["approver"] + ("" if d["why"] == "phone-deny" else " outcome=" + d["why"])
                    err = "denied on iPhone" if d["why"] == "phone-deny" else \
                        "iPhone approval rejected (%s)" % d["why"]
                    return None, ("denied", detail, err)
                token, err = leg.token()
                if err:
                    return None, ("auth-failed", err, err)
                return token, None
    finally:  # exceptions included: never leave a prompt up or the daemon waiting
        for leg in (phone, pc, touch):
            if leg is not None and leg.live:
                leg.cancel("broker_error")


# ------------------------------------------------------- who is asking

def ps_field(pid, field):
    try:
        r = subprocess.run(["/bin/ps", "-o", field + "=", "-p", str(pid)], capture_output=True, timeout=3)
        return r.stdout.decode("utf-8", "replace").strip()
    except Exception:  # noqa: BLE001
        return ""


def proc_label(pid):
    args = ps_field(pid, "args").split()
    if not args:
        return "pid%s" % pid
    base = os.path.basename(args[0]).lstrip("-")
    if base in ("bash", "zsh", "sh") and "-c" in args:
        return base + " -c"
    if base in ("node", "bun", "deno", "bash", "zsh", "sh", "perl", "ruby", "env") or base.startswith("python"):
        for a in args[1:]:
            if not a.startswith("-"):
                return "%s %s" % (base, "/".join(a.split("/")[-2:]))
    return base


def proc_chain(pid, depth=4):
    out = []
    for _ in range(depth):
        try:
            pid = int(pid)
        except ValueError:
            break
        if pid <= 1:
            break
        out.append(proc_label(pid))
        pid = ps_field(pid, "ppid") or "0"
    return " < ".join(out)


def ssh_destination(args):
    """Destination of an ssh client argv, never the remote command (which could hold a value)."""
    with_arg = set("-" + ch for ch in "BbcDEeFIiJLlmOoPpQRSWw")
    i = 1
    while i < len(args):
        a = args[i]
        if a == "--":
            return args[i + 1] if i + 1 < len(args) else "?"
        if a.startswith("-"):
            i += 2 if a in with_arg else 1
            continue
        return a
    return "?"


# ---------------------------------------------------------------- broker

def validate_read_args(raw, c):
    pos, server = [], None
    i = 0
    while i < len(raw):
        a = raw[i]
        if a in ("--color", "-c"):
            i += 2
        elif a in ("--output", "-o"):
            if i + 1 >= len(raw) or raw[i + 1] != "json":
                return None
            i += 2
        elif a in ("--server-url", "-u"):
            if i + 1 >= len(raw) or raw[i + 1] not in c["server_urls"]:
                return None
            server = raw[i + 1]
            i += 2
        elif a.startswith("-"):
            return None  # -t/--access-token, -f, -p, --value, ... all refused
        else:
            pos.append(a)
            i += 1
    name = lambda pid: c["project_names"].get(pid.lower(), pid)  # noqa: E731
    if pos == ["project", "list"]:
        summary = "list projects"
    elif pos == ["secret", "list"]:
        summary = "read ALL secrets the token can see"
    elif len(pos) == 3 and pos[:2] == ["secret", "list"] and UUID_RE.match(pos[2]):
        summary = "read all secrets in " + name(pos[2])
    elif len(pos) == 3 and pos[:2] == ["secret", "get"] and UUID_RE.match(pos[2]):
        summary = "read secret %s" % pos[2].lower()   # the full id: what the owner approves is unambiguous
    elif len(pos) == 3 and pos[:2] == ["project", "get"] and UUID_RE.match(pos[2]):
        summary = "get project " + name(pos[2])
    else:
        return None
    if any(denied_project(p, c) for p in pos):
        return None
    if server:
        summary += " @ " + server.split("://", 1)[-1]
    args = ["--output", "json"] + (["--server-url", server] if server else []) + pos
    return args, summary


def scrub(stdout, c):
    """Drop denied entries by key prefix and by project id AND name. After a live project lookup
    (c["allowed_project_ids"]), a secret whose projectId is not a visible, allowed project is dropped too."""
    allowed = c.get("allowed_project_ids")

    def bad(e):
        if (denied_key(e.get("key", ""), c) or denied_project(e.get("projectId"), c)
                or denied_project(e.get("id"), c) or denied_project(e.get("name"), c)):
            return True
        return allowed is not None and "key" in e and str(e.get("projectId") or "").lower() not in allowed
    try:
        data = json.loads(stdout or b"null")
    except ValueError:
        return stdout
    if isinstance(data, list):
        return json.dumps([e for e in data if not (isinstance(e, dict) and bad(e))]).encode()
    if isinstance(data, dict) and bad(data):
        return b"{}"
    return stdout


# ------------------------------------------------------------ providers
#
# The approval gate (approve_gate above) decides WHETHER an op may run and unseals the credential the
# provider asked for; a Provider decides WHAT runs: which sealed token it needs, how a read request is
# parsed and summarised for the prompt, and how list / get / save talk to the backend. The gate never
# sees provider details and a provider never sees approvers. See docs/PROVIDERS.md for adding one.

class Provider(object):
    """A secret backend behind the approval gate.

    Token handling: every provider names the sealed credential each operation needs (read_token /
    write_token; files tokens/<name>.age, plus the .iphone.age copies) and how it is handed to the backend
    (token_env). The token is decrypted by the gate, used for one op, and dropped.

    parse_read(raw, c) -> None (refused) or {"kind": "list"|"get", "args", "summary", "project"}
    list(op, token, c) / get(op, token, c) -> (exit_code, stdout_bytes, stderr_text)
    save(key, value, note, project, token, c) -> (result, detail, response_dict)
    scrub(stdout, c) -> stdout with denied projects / keys removed
    """
    name = "?"
    enabled = False
    token_env = ""

    def read_token(self, c, requested=None):
        return requested or c["read_token"]

    def write_token(self, c):
        return c["write_token"]

    def resolve_projects(self, op, token, c):
        """Live project ids visible to `token`, minus denied ones (ids and names): (set, None) or (None, why).
        Used when a denied project name has no id in project_names. A provider without it fails closed."""
        return None, "provider '%s' cannot resolve denied project names" % self.name

    def parse_read(self, raw, c):
        raise NotImplementedError

    def list(self, op, token, c):
        raise NotImplementedError

    def get(self, op, token, c):
        raise NotImplementedError

    def read(self, op, token, c):
        return (self.list if op["kind"] == "list" else self.get)(op, token, c)

    def save(self, key, value, note, project, token, c):
        raise NotImplementedError

    def scrub(self, stdout, c):
        return stdout


class BitwardenProvider(Provider):
    """Bitwarden Secrets Manager through the `bws` CLI (the original and default behaviour)."""
    name = "bitwarden"
    enabled = True
    token_env = "BWS_ACCESS_TOKEN"

    def parse_read(self, raw, c):
        v = validate_read_args(raw, c)
        if not v:
            return None
        args, summary = v
        pos = args[4:] if args[2:3] == ["--server-url"] else args[2:]
        scoped = len(pos) == 3 and pos[:2] in (["secret", "list"], ["project", "get"])
        project = c["project_names"].get(pos[2].lower(), pos[2]) if scoped else ""
        return {"kind": "list" if "list" in pos[1:2] else "get", "args": args, "summary": summary,
                "project": project, "project_id": pos[2].lower() if scoped else ""}

    def resolve_projects(self, op, token, c):
        server = op["args"][2:4] if op["args"][2:3] == ["--server-url"] else []
        code, out, err = run_bws(["--output", "json"] + server + ["project", "list"], token, c)
        try:
            projects = json.loads(out) if code == 0 else None
        except ValueError:
            projects = None
        if not isinstance(projects, list) or not all(isinstance(p, dict) for p in projects):
            return None, "bws project list failed: " + clean(err, 120)
        allowed = set()
        for p in projects:
            pid, name = str(p.get("id") or "").lower(), str(p.get("name") or "").lower()
            if not UUID_RE.match(pid):
                return None, "bws project list returned an entry without a project id"
            if pid in c["denied_projects"] or name in c["denied_projects"]:
                c["denied_projects"].append(pid)
            else:
                allowed.add(pid)
        return allowed, None

    def list(self, op, token, c):
        return run_bws(op["args"], token, c, BWS_TIMEOUT_S)

    get = list  # bws itself tells list from get by its argv

    def scrub(self, stdout, c):
        return scrub(stdout, c)

    def save(self, key, value, note, project, token, c):
        def reject(msg):
            return "rejected", msg, {"ok": False, "error": msg}
        code, out, err = run_bws(["--output", "json", "project", "list"], token, c)
        try:
            projects = json.loads(out) if code == 0 else None
        except ValueError:
            projects = None
        if not isinstance(projects, list):
            return reject("bws project list failed: " + err)
        pid = next((p.get("id") for p in projects if p.get("name") == project), None)
        if not pid or denied_project(pid, c):
            return reject("project '%s' is not visible to the write token" % project)
        code, out, err = run_bws(["--output", "json", "secret", "list", pid], token, c)
        try:
            secrets = json.loads(out) if code == 0 else None
        except ValueError:
            secrets = None
        if not isinstance(secrets, list):
            return reject("bws secret list failed: " + err)
        existing = [s for s in secrets if s.get("key") == key]
        if len(existing) > 1:
            return reject("%d secrets already named %s in %s; fix by hand" % (len(existing), key, project))
        # bws 2.x only takes the value on argv: it is visible to same-user processes on this Mac
        # for the second bws runs. Never logged; redacted from errors.
        # Values, notes and keys may start with "-" (a PEM is "-----BEGIN ..."), which clap would read as
        # a flag: option values are attached with "=" and positionals all follow "--".
        note_arg = ["--note=" + note] if note else []
        if existing:
            args = ["--output", "json", "secret", "edit", "--value=" + value] + note_arg + ["--", existing[0]["id"]]
            action = "updated"
        else:
            args = ["--output", "json", "secret", "create"] + note_arg + ["--", key, value, pid]
            action = "created"
        code, out, err = run_bws(args, token, c)
        if code != 0:
            return "error", "bws %s failed exit %d" % (action, code), \
                {"ok": False, "error": "bws failed: " + err.replace(value, "[REDACTED]")}
        try:
            sid = json.loads(out).get("id", "")
        except (ValueError, AttributeError):
            sid = ""
        return action, "id=%s" % sid, {"ok": True, "id": sid, "action": action, "project": project}


class OnePasswordProvider(Provider):
    """SKELETON, not enabled: 1Password through `op` with a service account.

    token_env OP_SERVICE_ACCOUNT_TOKEN; tokens/<read_token>.age holds a read-only service account token,
    tokens/<write_token>.age one that may write the allowed vaults. Planned mapping (docs/PROVIDERS.md):
      list -> op item list --vault <vault> --format json        (project = vault name)
      get  -> op item get <id> --vault <vault> --format json     (fields with values)
      save -> op item edit <id> 'password=<value>' / op item create --category password ...
    The value would go on argv for op too; prefer a template file on a 0600 fd or stdin (`op item create
    --template -`) when implementing. Same denied_projects / save_projects rules apply to vault names."""
    name = "1password"
    token_env = "OP_SERVICE_ACCOUNT_TOKEN"


class KeychainProvider(Provider):
    """SKELETON, not enabled: the macOS login Keychain through /usr/bin/security.

    Keychain items need no bearer token, so token handling differs: the gate still unseals a token
    (that decrypt IS the Touch ID approval) and the provider discards it. Planned mapping:
      list -> security dump-keychain (names only) filtered to a service prefix (project = service prefix)
      get  -> security find-generic-password -s <service> -a <key> -w
      save -> security add-generic-password -U -s <service> -a <key> -w (value via stdin prompt, not argv)
    Items must be created with an ACL that excludes /usr/bin/security for other callers, or any process
    running as the user can read them silently; see docs/PROVIDERS.md before enabling."""
    name = "keychain"


PROVIDERS = {"bitwarden": BitwardenProvider()}                     # shipped
PROVIDER_SKELETONS = {"1password": OnePasswordProvider(), "keychain": KeychainProvider()}  # not enabled


def provider_of(c):
    """(provider, None) or (None, why). Unknown and skeleton providers fail closed."""
    name = c.get("provider") or "bitwarden"
    p = PROVIDERS.get(name) if isinstance(name, str) else None
    if p is not None and p.enabled:
        return p, None
    if isinstance(name, str) and name in PROVIDER_SKELETONS:
        return None, "provider '%s' is not enabled in this version" % name
    return None, "unknown provider %r" % clean(name, 30)


# ---------------------------------------------------------------- requests

class Job(object):
    """A validated gated op that still needs its approval. run() = gate + provider call (+ audit line);
    it must hold GATE_LOCK. approved is set once the gate let it through."""

    def __init__(self, op, rec, run, reject):
        self.op, self.rec, self._run, self.reject = op, rec, run, reject
        self.approved = False

    def run(self):
        return self._run(self)


GATE_LOCK = threading.Lock()   # one approval in flight: one Touch ID sheet / one phone request at a time


def prepare(req, peer_pid):
    """Validate a request. Returns a response dict (ping, rejects, dry runs) or a Job for save / bws."""
    c = load_config()
    op = req.get("op", "")
    host = claimed(req.get("host"), 48)
    caller = claimed(req.get("caller"), 60)
    peer_args = ps_field(peer_pid, "args").split()
    named_ssh = bool(peer_args) and os.path.basename(peer_args[0]) == "ssh"
    # argv[0] is whatever the peer chose; only the real /usr/bin/ssh binary counts as a tunnel (audit L6)
    if named_ssh and exe_path(peer_pid) == SSH_EXE:
        via = "ssh session to " + claimed(ssh_destination(peer_args), 40)
        who = "%s (%s)" % (host or "remote", caller or "?")
        named_ssh = False
    else:
        via = "local: " + clean(proc_chain(ps_field(peer_pid, "ppid") or peer_pid), 70)
        who = caller or "local process"
    rec = {"op": op, "host": host, "caller": caller, "via": via}
    if named_ssh:
        rec["notes"] = ["peer-claims-ssh:" + clean(os.path.basename(exe_path(peer_pid)) or "?", 40)]
    dry = bool(req.get("dryrun"))

    def reject(msg):
        rec.update(result="rejected", detail=msg)
        log(rec)
        return {"ok": False, "error": msg}

    if op == "ping":
        return {"ok": True, "broker": "bws-touchid", "broker_name": c["broker_name"]}

    if op in ("save", "bws"):
        provider, why = provider_of(c)
        if provider is None:
            return reject(why)
        prefer = prefer_device_of(req, c)

    if op == "save":
        key = req.get("key") or ""
        project = req.get("project") or (c["save_projects"][0] if c["save_projects"] else "")
        note = req.get("note") or ""
        value = req.get("value")
        tname = provider.write_token(c)
        rec.update(key=key, project=project, token=tname)
        if not KEY_RE.match(key):
            return reject("key must match ^[A-Z0-9_]+$ (max 128)")
        if denied_key(key, c):
            return reject("that key prefix is owner-only")
        if not project or denied_project(project, c) or project not in c["save_projects"]:
            return reject("project '%s' is not in save_projects %s" % (clean(project, 40), c["save_projects"]))
        if not isinstance(value, str) or not value:
            return reject("empty value")
        if len(value.encode()) > MAX_VALUE:
            return reject("value larger than %d bytes" % MAX_VALUE)
        if not isinstance(note, str) or len(note) > 1000:
            return reject("note longer than 1000 chars")
        if approvers_of(c) is None:
            return reject("bad approvers config")
        if dry:
            rec.update(result="DRYRUN-ok")
            log(rec)
            return {"ok": True, "id": "dryrun", "action": "dry-run"}

        def run_save(job):
            token, fail = approve_gate(c, rec, tname, "Touch ID: save %s" % key,
                                       "%s → %s [%s]" % (who, project, via),
                                       dict(op="save", key=key, summary="save %s → %s" % (key, project),
                                            project=project, token=tname, host=host, caller=caller, via=via),
                                       prefer)
            if fail:
                rec.update(result=fail[0], detail=fail[1])
                log(rec)
                return {"ok": False, "error": fail[2]}
            job.approved = True
            result, detail, resp = provider.save(key, value, note, project, token, c)
            del token
            rec.update(result=result, detail=detail)
            log(rec)
            return resp
        return Job("save", rec, run_save, reject)

    if op == "bws":
        raw = req.get("args")
        tname = provider.read_token(c, req.get("token"))
        rec["token"] = tname
        if not NAME_RE.match(str(tname)):
            return reject("bad token name")
        if tname not in c["read_tokens"]:  # a read may not pick the write token on its own (audit M5)
            return reject("token '%s' is not allowed for reads (config read_tokens: %s)"
                          % (tname, ", ".join(c["read_tokens"])))
        rop = provider.parse_read(raw, c) \
            if isinstance(raw, list) and all(isinstance(a, str) for a in raw) else None
        if not rop:
            return reject("refused: only read-only bws calls (project list/get, secret list/get, -o json)")
        summary = rop["summary"]
        rec["detail"] = summary
        if approvers_of(c) is None:
            return reject("bad approvers config")
        if dry:
            rec.update(result="DRYRUN-ok")
            log(rec)
            return {"ok": True, "exit": 0, "stdout_b64": base64.b64encode(b"[]").decode()}

        title = "Touch ID: %s" % summary + ("" if tname == c["read_token"] else " (token %s)" % tname)

        def run_read(job):
            token, fail = approve_gate(c, rec, tname, title, "%s [%s]" % (who, via),
                                       dict(op="bws", key="", summary=summary, project=rop["project"],
                                            token=tname, host=host, caller=caller, via=via),
                                       prefer)
            if fail:
                rec.update(result=fail[0], detail=fail[1] or summary)
                log(rec)
                return {"ok": False, "error": fail[2]}
            job.approved = True
            if c["denied_unresolved"]:
                # A denied project NAME without an id in project_names: look the ids up with this token
                # before reading, and return only secrets of visible, allowed projects (fail closed).
                allowed, why = provider.resolve_projects(rop, token, c)
                if allowed is None or (rop.get("project_id") and rop["project_id"] not in allowed):
                    del token
                    msg = ("refused: could not resolve denied project names to ids (%s); nothing was read" % why
                           if allowed is None else "refused: that project is denied or not visible to the token")
                    rec.update(result="rejected", detail=msg)
                    log(rec)
                    return {"ok": False, "error": msg}
                c["allowed_project_ids"] = allowed
            code, out, err = provider.read(rop, token, c)
            del token
            rec["result"] = "exit=%d" % code
            log(rec)
            return {"ok": code == 0, "exit": code, "stdout_b64": base64.b64encode(provider.scrub(out, c)).decode(),
                    "stderr": err, "error": "" if code == 0 else "bws exited %d" % code}
        return Job("bws", rec, run_read, reject)

    return reject("unknown op")


def handle(req, peer_pid):
    """Synchronous request: validate, wait for the approval slot, run. Returns the response dict."""
    job = prepare(req, peer_pid)
    if not isinstance(job, Job):
        return job
    if not GATE_LOCK.acquire(timeout=GATE_QUEUE_S):
        return job.reject("broker busy: another approval is pending; retry, or use --async")
    try:
        return job.run()
    finally:
        GATE_LOCK.release()


# ---------------------------------------------------------------- async tickets
#
# A caller that cannot wait for an approval (MCP tools are killed at 60 s) sends "async": true and gets
# {"ticket"} at once; the job runs in the background, one approval at a time like every other request.
# ticket.get returns pending | approved (with the result) | denied | expired. Results live in this
# process's memory only (never on disk, never logged), are handed out once, and are dropped
# TICKET_TTL_S after the job finished. A ticket only answers a ticket.get that carries its ticket_key
# (a random secret returned once, to the creator only; the broker keeps a hash) AND the same uid + host +
# caller; anything else - unknown, used, expired, someone else's - gets the same "expired" answer.
# One host + caller may have MAX_PENDING_PER_CALLER tickets pending, and once the owner denies (or lets
# time out) one of its requests, the ones it queued before that are dropped without another prompt.

class Tickets(object):
    def __init__(self):
        self.lock = threading.Lock()
        self.items = {}
        self.refused_at = {}    # (uid, host, caller) -> time of the last owner deny / timeout

    def _purge(self, now):
        for tid in [t for t, e in self.items.items() if e["done_at"] and now - e["done_at"] > TICKET_TTL_S]:
            e = self.items.pop(tid)
            e["result"] = None

    def create(self, uid, host, caller, op):
        """(ticket id, ticket key, None) or (None, None, why)."""
        with self.lock:
            self._purge(time.time())
            if len(self.items) >= MAX_TICKETS:
                return None, None, "too many outstanding tickets (%d); collect or let them expire" % MAX_TICKETS
            mine = [e for e in self.items.values()
                    if e["status"] == "pending" and (e["uid"], e["host"], e["caller"]) == (uid, host, caller)]
            if len(mine) >= MAX_PENDING_PER_CALLER:
                return None, None, "too many pending requests from this host/caller (%d)" % MAX_PENDING_PER_CALLER
            tid = b32id("tkt")
            key = base64.urlsafe_b64encode(os.urandom(24)).decode().rstrip("=")
            self.items[tid] = {"uid": uid, "host": host, "caller": caller, "op": op, "status": "pending",
                               "key_hash": hashlib.sha256(key.encode()).digest(),
                               "created": time.time(), "done_at": None, "result": None,
                               "event": threading.Event()}
            return tid, key, None

    def note_refused(self, tid):
        with self.lock:
            e = self.items.get(tid)
            if e is not None:
                self.refused_at[(e["uid"], e["host"], e["caller"])] = time.time()

    def refused_since_created(self, tid):
        with self.lock:
            e = self.items.get(tid)
            if e is None:
                return False
            return self.refused_at.get((e["uid"], e["host"], e["caller"]), 0) >= e["created"]

    def finish(self, tid, status, result):
        with self.lock:
            e = self.items.get(tid)
            if e is None:
                return
            e.update(status=status, result=result, done_at=time.time())
            e["event"].set()

    def get(self, tid, key, uid, host, caller, wait=0):
        gone = {"ok": False, "status": "expired",
                "error": "no such ticket (expired, already collected, or not yours)"}
        if not isinstance(tid, str) or not TICKET_RE.match(tid) or not isinstance(key, str) or len(key) > 128:
            return gone
        digest = hashlib.sha256(key.encode()).digest()
        with self.lock:
            self._purge(time.time())
            e = self.items.get(tid)
            if e is None or not hmac.compare_digest(e["key_hash"], digest) \
                    or (e["uid"], e["host"], e["caller"]) != (uid, host, caller):
                return gone
            ev = e["event"]
        if e["status"] == "pending" and wait > 0:
            ev.wait(min(wait, TICKET_WAIT_MAX_S))
        with self.lock:
            if self.items.get(tid) is not e:
                return gone  # collected by a concurrent ticket.get
            if e["status"] == "pending":
                return {"ok": True, "status": "pending", "ticket": tid}
            del self.items[tid]
            result, e["result"] = e["result"], None
        if e["status"] == "approved":
            return {"ok": True, "status": "approved", "op": e["op"], "result": result}
        return {"ok": False, "status": "denied", "op": e["op"], "error": (result or {}).get("error") or "denied"}

    def sweep(self):
        with self.lock:
            self._purge(time.time())


TICKETS = Tickets()


def _ticket_worker(job, tid):
    try:
        with GATE_LOCK:
            if TICKETS.refused_since_created(tid):  # the owner already said no to this caller: no new prompt
                resp = job.reject("dropped: the owner denied an earlier request from this host/caller")
            else:
                resp = job.run()
                # a Touch ID cancel is "denied" ("auth-failed" with the default approvers)
                if job.rec.get("result") in ("denied", "timeout", "auth-failed"):
                    TICKETS.note_refused(tid)
    except Exception as e:  # noqa: BLE001
        log({"op": job.op, "result": "error", "detail": "async " + type(e).__name__})
        resp = {"ok": False, "error": "broker error"}
    TICKETS.finish(tid, "approved" if job.approved else "denied", resp)


def start_async(job, uid):
    tid, key, why = TICKETS.create(uid, job.rec.get("host", ""), job.rec.get("caller", ""), job.op)
    if tid is None:
        return job.reject(why)
    threading.Thread(target=_ticket_worker, args=(job, tid), name="ticket", daemon=True).start()
    return {"ok": True, "status": "pending", "ticket": tid, "ticket_key": key, "ttl_s": TICKET_TTL_S}


def dispatch(req, peer_pid, peer_uid):
    """Everything the broker socket accepts: ping, save, bws (sync or "async": true), ticket.get."""
    op = req.get("op", "")
    if op == "ticket.get":
        try:
            wait = max(0.0, min(float(req.get("wait") or 0), TICKET_WAIT_MAX_S))
        except (TypeError, ValueError):
            wait = 0.0
        return TICKETS.get(req.get("ticket"), req.get("ticket_key"), peer_uid, claimed(req.get("host"), 48),
                           claimed(req.get("caller"), 60), wait)
    if req.get("async") is True and op in ("save", "bws"):
        job = prepare(req, peer_pid)
        return start_async(job, peer_uid) if isinstance(job, Job) else job
    return handle(req, peer_pid)


def read_line(conn, limit):
    buf = b""
    while len(buf) <= limit:
        chunk = conn.recv(65536)
        if not chunk:
            return buf or None
        nl = chunk.find(b"\n")
        if nl >= 0:
            return buf + chunk[:nl]
        buf += chunk
    return None


def serve_conn(conn, slots):
    try:
        cred = conn.getsockopt(SOL_LOCAL, LOCAL_PEERCRED, 76)
        peer_uid = struct.unpack_from("Ii", cred)[1]
        peer_pid = struct.unpack("i", conn.getsockopt(SOL_LOCAL, LOCAL_PEERPID, 4))[0]
        if peer_uid != os.getuid():
            resp = {"ok": False, "error": "peer uid mismatch"}
        else:
            conn.settimeout(15)
            line = read_line(conn, MAX_LINE)
            try:
                req = json.loads(line) if line else None
            except ValueError:
                req = None
            if not isinstance(req, dict):
                resp = {"ok": False, "error": "bad request (one JSON line)"}
            else:
                conn.settimeout(BROKER_CONN_S)
                resp = dispatch(req, peer_pid, peer_uid)
                req.clear()
        conn.sendall(json.dumps(resp).encode() + b"\n")
    except (OSError, socket.timeout):
        pass  # status probes and clients that gave up
    except Exception as e:  # noqa: BLE001
        log({"op": "serve", "result": "error", "detail": type(e).__name__})
    finally:
        conn.close()
        slots.release()


def cmd_serve(_argv):
    os.umask(0o077)
    sweep_stale_dialog(load_config())
    os.makedirs(SOCK_DIR, exist_ok=True)
    os.chmod(SOCK_DIR, 0o700)
    try:
        os.unlink(LOCAL_SOCK)
    except FileNotFoundError:
        pass
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(LOCAL_SOCK)
    os.chmod(LOCAL_SOCK, 0o600)
    srv.listen(16)
    log({"op": "serve", "result": "listening", "detail": LOCAL_SOCK})

    def sweeper():
        while True:
            time.sleep(30)
            TICKETS.sweep()
    threading.Thread(target=sweeper, name="ticket-sweeper", daemon=True).start()
    slots = threading.BoundedSemaphore(MAX_CONNS)
    # One thread per connection so ping and ticket.get answer while an approval is pending; approvals
    # themselves stay serial (GATE_LOCK): one Touch ID prompt at a time.
    while True:
        conn, _ = srv.accept()
        if not slots.acquire(blocking=False):
            conn.close()
            continue
        threading.Thread(target=serve_conn, args=(conn, slots), name="conn", daemon=True).start()


