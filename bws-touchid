#!/usr/bin/env python3
"""bws-touchid: Touch ID per access for Bitwarden Secrets Manager machine tokens.

Tokens are age-encrypted to a Secure Enclave identity (age-plugin-se, Touch ID access control).
Every use decrypts the token, so the Secure Enclave asks for Touch ID every time. A small broker
(launchd user agent) does the decrypting and runs `bws` on this Mac; local and ssh-forwarded
clients only ever get results, never the token.

Commands (also reachable through the bws-save / bws-gated symlinks):
  bws-touchid init [--access-control any-biometry]   create the Secure Enclave identity
  bws-touchid store NAME [--stdin]                    encrypt a token (hidden prompt; no Touch ID needed)
  bws-touchid status                                  identity, stored token names, broker reachability
  bws-touchid delete NAME                             remove an encrypted token
  bws-touchid run [--token NAME] -- CMD...            Touch ID, then exec CMD with BWS_ACCESS_TOKEN set
  bws-touchid serve                                   the broker (launchd, gui/<uid>)
  bws-touchid reap                                    delete a dead forwarded socket (remote hosts)
  bws-touchid ping [SOCKET]                           is a broker reachable? (no Touch ID)
  bws-touchid tunnel install|status|uninstall         persistent ssh -R tunnels to the hosts in `tunnels`
  bws-touchid approver add DEVICE_ID PEM | list | remove DEVICE_ID   pin an iPhone approve key
  bws-touchid iphone-setup                            one-time: no-biometry identity + iPhone token copies
  bws-save [--project P] [--note N] [--dry-run] KEY   VALUE on stdin -> broker -> bws secret create/edit
  bws-gated <bws args>                                read-only bws through the broker (drop-in BWS_BIN)

Python 3.9 standard library only. See README.md for the threat model.
"""

import base64
import datetime
import getpass
import hashlib
import json
import os
import re
import select
import shutil
import signal
import socket
import stat
import struct
import subprocess
import sys
import tempfile
import time

HOME = os.path.expanduser("~")
CONF_DIR = os.environ.get("BWS_TOUCHID_HOME") or os.path.join(HOME, ".config", "bws-touchid")
CONFIG_PATH = os.path.join(CONF_DIR, "config.json")
IDENTITY = os.path.join(CONF_DIR, "identity.txt")
RECIPIENT = os.path.join(CONF_DIR, "recipient.txt")
RECIPIENT_IPHONE = os.path.join(CONF_DIR, "recipient-iphone.txt")
TOKENS_DIR = os.path.join(CONF_DIR, "tokens")
SOCK_DIR = os.path.join(HOME, ".bws-broker")
LOCAL_SOCK = os.path.join(SOCK_DIR, "broker.sock")
FWD_SOCK = os.path.join(SOCK_DIR, "fwd.sock")
LOG_PATH = os.path.join(HOME, "Library", "Logs", "bws-touchid.log")

MAX_VALUE = 64 * 1024
MAX_LINE = 512 * 1024
MAX_STDOUT = 8 * 1024 * 1024
KEY_RE = re.compile(r"^[A-Z0-9_]{1,128}$")
NAME_RE = re.compile(r"^[A-Za-z0-9_-]{1,64}$")
UUID_RE = re.compile(r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$")
TOKEN_RE = re.compile(r"^0\.[0-9a-fA-F-]{36}\.[^:\s]+:[A-Za-z0-9+/=]+$")
SOL_LOCAL, LOCAL_PEERCRED, LOCAL_PEERPID = 0, 0x001, 0x002
EXTRA_PATH = ["/opt/homebrew/bin", "/usr/local/bin", os.path.join(HOME, ".local", "bin")]

# Approvers (whispera-link protocol v1, PROTOCOL.md §7, §8, §11). Module constants so tests can shrink them.
KNOWN_APPROVERS = ("touchid", "iphone")
TOUCHID_WINDOW_S = 120          # Touch ID leg deadline (today's decrypt timeout)
PHONE_WINDOW_MIN, PHONE_WINDOW_MAX = 30, 110
PHONE_CONNECT_S = 1.0           # approvals.sock connect timeout
PHONE_ACK_S = 2.0               # wait for approval.ack
PHONE_GRACE_S = 5               # iphone-only: deadline = expires_at + this
IPHONE_DECRYPT_S = 10
KILL_GRACE_S = 1.0
MAX_DAEMON_LINE = 64 * 1024
OPENSSL = "/usr/bin/openssl"    # absolute path on purpose, never PATH
SPKI_P256_PREFIX = bytes.fromhex("3059301306072a8648ce3d020106082a8648ce3d030107034200")
DEVICE_RE = re.compile(r"^dev_[a-z2-7]{24}$")

DEFAULTS = {
    "broker_name": "the broker Mac",          # shown to agents when the broker is unreachable
    "read_token": "read",                     # token used by bws-gated / run
    "write_token": "write",                   # token used by bws-save
    "save_projects": [],                      # project NAMES bws-save may write; first = default
    "project_names": {},                      # project id -> name, for readable notifications
    "denied_projects": [],                    # ids or names never read or written
    "denied_key_prefixes": [],                # key prefixes never read or written
    "server_urls": ["https://vault.bitwarden.com", "https://vault.bitwarden.eu"],
    "bws_path": "",                           # default: first bws on PATH / common locations
    "age_path": "",
    "notify": True,                           # macOS notification before every decrypt
    "local_broker": True,                     # clients: false = never use this Mac's broker.sock,
                                              # only the forwarded socket (Mac without usable Touch ID)
    "tunnels": [],                            # broker Mac: hosts that get a persistent ssh -R tunnel,
                                              # "alias" or {"host": "alias", "remote_sock": "/abs/fwd.sock"}
    "tunnel_ssh_options": [],                 # extra ssh -o options for the tunnels
    "approvers": ["touchid"],                 # who may approve a gated op: "touchid", "iphone" (race)
    "iphone_token_identity": "",              # default: <conf dir>/identity-iphone.txt (no biometry)
    "approvals_socket": "~/.whispera-link/approvals.sock",   # whispera-link daemon (iphone approver)
    "approvers_dir": "~/.bws-broker/approvers",               # pinned approve keys <device_id>.pub
    "phone_window_s": 100,                    # how long the phone may answer (clamped 30-110)
    "age_plugin_se_path": "",
}


# ---------------------------------------------------------------- helpers

def eprint(*a):
    print(*a, file=sys.stderr)


def die(msg, code=1):
    eprint("bws-touchid: " + msg)
    sys.exit(code)


def clean(s, n=80):
    s = "".join(ch for ch in str(s or "") if ch.isprintable())
    return s if len(s) <= n else s[:n] + "…"


def load_config():
    c = json.loads(json.dumps(DEFAULTS))
    try:
        with open(CONFIG_PATH) as f:
            user = json.load(f)
        if isinstance(user, dict):
            c.update({k: v for k, v in user.items() if not k.startswith("_")})
    except FileNotFoundError:
        pass
    except Exception as e:  # noqa: BLE001
        eprint("bws-touchid: ignoring unreadable config %s: %s" % (CONFIG_PATH, e))
    c["denied_projects"] = [str(x).lower() for x in c.get("denied_projects") or []]
    names = {str(k).lower(): str(v) for k, v in (c.get("project_names") or {}).items()}
    c["project_names"] = names
    for pid, nm in names.items():  # denying a name also denies its id
        if nm.lower() in c["denied_projects"]:
            c["denied_projects"].append(pid)
    c["save_projects"] = [p for p in c.get("save_projects") or [] if p.lower() not in c["denied_projects"]]
    return c


def denied_project(x, c):
    return str(x or "").lower() in c["denied_projects"]


def denied_key(k, c):
    return any(p and str(k).startswith(p) for p in c.get("denied_key_prefixes") or [])


def log(fields):
    fields = dict(fields)
    fields["ts"] = datetime.datetime.now().astimezone().isoformat(timespec="seconds")
    notes = fields.pop("notes", None)
    if notes:
        fields["detail"] = " ".join(([fields["detail"]] if fields.get("detail") else []) + list(notes))
    order = ["ts", "op", "result", "key", "project", "token", "host", "caller", "via", "approver",
             "request_id", "detail"]
    line = " ".join("%s=%s" % (k, clean(fields[k], 200)) for k in order if fields.get(k)) + "\n"
    os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
    fd = os.open(LOG_PATH, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    with os.fdopen(fd, "a") as f:
        f.write(line)


def find_tool(name, configured):
    if configured:
        return configured
    path = os.pathsep.join([os.environ.get("PATH", "")] + EXTRA_PATH)
    return shutil.which(name, path=path)


def tool_env():
    return {"PATH": os.pathsep.join(EXTRA_PATH + ["/usr/bin", "/bin"]), "HOME": HOME}


def notify(title, msg, c):
    if not c.get("notify", True):
        return
    script = ["-e", "on run argv", "-e", "display notification (item 2 of argv) with title (item 1 of argv)",
              "-e", "end run", clean(title, 60), clean(msg, 200)]
    try:
        subprocess.run(["/usr/bin/osascript"] + script, timeout=5,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:  # noqa: BLE001
        pass


def token_path(name):
    if not NAME_RE.match(name or ""):
        raise ValueError("bad token name")
    return os.path.join(TOKENS_DIR, name + ".age")


def decrypt_token(name, c):
    """One Secure Enclave decrypt = one Touch ID prompt. Returns (token, error)."""
    path = token_path(name)
    if not os.path.isfile(path):
        return None, "no token named '%s' on the broker Mac (owner: bws-touchid store %s)" % (name, name)
    age = find_tool("age", c.get("age_path"))
    if not age:
        return None, "age not found (brew install age age-plugin-se)"
    try:
        r = subprocess.run([age, "-d", "-i", IDENTITY, path], capture_output=True, timeout=120, env=tool_env())
    except subprocess.TimeoutExpired:
        return None, "timed out waiting for Touch ID"
    if r.returncode != 0:
        err = r.stderr.decode("utf-8", "replace").strip().splitlines()
        return None, "Touch ID / decrypt failed: %s" % clean(err[-1] if err else "exit %d" % r.returncode, 160)
    tok = r.stdout.decode("utf-8").strip()
    if not tok:
        return None, "decrypted token is empty"
    return tok, None


def run_bws(args, token, c, timeout=60):
    """Run bws with the token in env only and an empty HOME (no user bws config can redirect it)."""
    bws = find_tool("bws", c.get("bws_path"))
    if not bws:
        return 127, b"", "bws not found on the broker Mac"
    with tempfile.TemporaryDirectory(prefix="bws-touchid-") as tmp:
        env = {"HOME": tmp, "TMPDIR": tmp + "/", "PATH": "/usr/bin:/bin", "BWS_ACCESS_TOKEN": token}
        try:
            r = subprocess.run([bws, "--color", "no"] + args, capture_output=True, timeout=timeout,
                               env=env, stdin=subprocess.DEVNULL)
        except subprocess.TimeoutExpired:
            return 124, b"", "bws timed out"
    err = r.stderr.decode("utf-8", "replace").replace(token, "[REDACTED]")
    if len(r.stdout) > MAX_STDOUT:
        return 1, b"", "bws output too large"
    return r.returncode, r.stdout, err[:600]


# ------------------------------------------------------------ approvers
#
# A gated op (save, bws) needs one approval before a token is decrypted. With the default
# `"approvers": ["touchid"]` that is exactly the old notify() + decrypt_token() path. With "iphone" in
# the list the broker races the Touch ID decrypt against a phone-signed approval relayed by the
# whispera-link daemon (PROTOCOL.md §8, §11.2). The broker builds and serialises the canonical request
# itself and re-verifies every phone signature with /usr/bin/openssl against a pinned key; the daemon
# is only a relay. First valid answer wins; a deny from either leg is a deny; the deadline is a deny.

def expand(p):
    p = str(p or "")
    return HOME + p[1:] if p == "~" or p.startswith("~/") else p


def approvers_of(c):
    """The configured approver list, or None when it is unusable (fail closed)."""
    a = c.get("approvers")
    if not isinstance(a, list) or not a or not all(isinstance(x, str) and x in KNOWN_APPROVERS for x in a) \
            or len(set(a)) != len(a):
        return None
    return a


def is_default_approvers(c):
    return approvers_of(c) == ["touchid"]


def phone_window(c):
    try:
        w = int(c.get("phone_window_s", 100))
    except (TypeError, ValueError):
        w = 100
    return max(PHONE_WINDOW_MIN, min(PHONE_WINDOW_MAX, w))


def iphone_identity(c):
    return expand(c.get("iphone_token_identity")) or os.path.join(CONF_DIR, "identity-iphone.txt")


def iphone_token_path(name):
    if not NAME_RE.match(name or ""):
        raise ValueError("bad token name")
    return os.path.join(TOKENS_DIR, name + ".iphone.age")


def approvers_dir(c):
    return expand(c.get("approvers_dir") or "~/.bws-broker/approvers")


def b32id(prefix):
    return prefix + "_" + base64.b32encode(os.urandom(15)).decode().lower().rstrip("=")


def canonical_bytes(obj):
    return json.dumps(obj, sort_keys=True, separators=(",", ":"), ensure_ascii=True).encode("ascii")


def build_canonical(c, op, key, summary, project, token, host, caller, via, now=None):
    created = int(time.time() if now is None else now)
    return {"v": 1, "request_id": b32id("apr"),
            "nonce": base64.urlsafe_b64encode(os.urandom(16)).decode().rstrip("="),
            "op": op, "key": key, "summary": summary, "project": project, "token": token,
            "host": host, "caller": caller, "via": via, "broker": str(c["broker_name"]),
            "created_at": created, "expires_at": created + phone_window(c)}


# --- P-256 keys and signatures (copied, not imported, from whispera_link/crypto.py; PROTOCOL.md §2.1, §4.5)

def spki_from_pem(text):
    """DER SubjectPublicKeyInfo of a P-256 public key PEM, or None."""
    m = re.search(r"-----BEGIN PUBLIC KEY-----([A-Za-z0-9+/=\s]+)-----END PUBLIC KEY-----", text or "")
    if not m:
        return None
    try:
        der = base64.b64decode("".join(m.group(1).split()), validate=True)
    except ValueError:
        return None
    if len(der) != 91 or not der.startswith(SPKI_P256_PREFIX) or der[26] != 4:
        return None
    return der


def pem_from_spki(der):
    b = base64.b64encode(der).decode()
    return "-----BEGIN PUBLIC KEY-----\n%s\n-----END PUBLIC KEY-----\n" % "\n".join(
        b[i:i + 64] for i in range(0, len(b), 64))


def fingerprint(der):
    return hashlib.sha256(der).hexdigest()


def display_fp(der):
    h = fingerprint(der)[:16]
    return "-".join(h[i:i + 4] for i in range(0, 16, 4))


def p256_verify(spki_der, message, sig_der):
    """ECDSA P-256 / SHA-256 / DER via /usr/bin/openssl. Any doubt = False."""
    if not isinstance(sig_der, bytes) or not 8 <= len(sig_der) <= 80 or not os.path.exists(OPENSSL):
        return False
    tmp = tempfile.mkdtemp(prefix="bws-touchid-v-")
    try:
        os.chmod(tmp, 0o700)
        pub, sig = os.path.join(tmp, "pub.pem"), os.path.join(tmp, "sig.der")
        with open(pub, "w") as f:
            f.write(pem_from_spki(spki_der))
        with open(sig, "wb") as f:
            f.write(sig_der)
        r = subprocess.run([OPENSSL, "dgst", "-sha256", "-verify", pub, "-signature", sig], input=message,
                           capture_output=True, timeout=5, env={"PATH": "/usr/bin:/bin"})
        return r.returncode == 0 and r.stdout.strip() == b"Verified OK"
    except (OSError, subprocess.SubprocessError):
        return False
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def safe_owned(path, want_dir):
    """Not a symlink, owned by us, not group/world-writable, right type."""
    try:
        st = os.lstat(path)
    except OSError:
        return False
    kind_ok = stat.S_ISDIR(st.st_mode) if want_dir else stat.S_ISREG(st.st_mode)
    return kind_ok and st.st_uid == os.getuid() and not st.st_mode & 0o022


def load_pin(c, device_id):
    """SPKI DER of a pinned approve key, or (None, why)."""
    if not DEVICE_RE.match(device_id or ""):
        return None, "bad device id"
    d = approvers_dir(c)
    path = os.path.join(d, device_id + ".pub")
    if not os.path.lexists(path):
        return None, "not pinned"
    if not safe_owned(d, True) or not safe_owned(path, False):
        return None, "pin file or dir is a symlink, not ours, or group/world-writable"
    try:
        with open(path) as f:
            der = spki_from_pem(f.read(4096))
    except (OSError, UnicodeDecodeError):
        der = None
    return (der, "") if der else (None, "not a P-256 public key PEM")


def pinned_devices(c):
    d = approvers_dir(c)
    try:
        names = sorted(os.listdir(d))
    except OSError:
        return []
    return [n[:-4] for n in names if n.endswith(".pub") and DEVICE_RE.match(n[:-4])]


# --- the legs

class Leg(object):
    """One approver in the race. poll() returns None while undecided, else a decision dict:
    {"kind": "approve"|"deny"|"unavailable", "approver": str, "why": str, ...}. A leg that returned a
    decision is no longer live. cancel(reason) stops it (kills the prompt / tells the daemon)."""
    name = "?"
    live = False

    def fileno_or_none(self):
        return None

    def poll(self, now):
        raise NotImplementedError

    def cancel(self, reason):
        pass

    def token(self):
        """After an approve: (token, None) or (None, error)."""
        raise NotImplementedError


class TouchIdLeg(Leg):
    name = "touchid"

    def __init__(self, c, tname, deadline):
        self.c, self.tname, self.deadline = c, tname, deadline
        self.proc, self._tok, self.error = None, None, ""

    def start(self):
        path = token_path(self.tname)
        if not os.path.isfile(path):
            self.error = "no token named '%s' on the broker Mac (owner: bws-touchid store %s)" % (self.tname, self.tname)
            return False
        age = find_tool("age", self.c.get("age_path"))
        if not age:
            self.error = "age not found (brew install age age-plugin-se)"
            return False
        self.proc = subprocess.Popen([age, "-d", "-i", IDENTITY, path], stdin=subprocess.DEVNULL,
                                     stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=tool_env(),
                                     start_new_session=True)
        self.live = True
        return True

    def poll(self, now):
        if not self.live:
            return None
        if self.proc.poll() is None:
            if now >= self.deadline:
                self.cancel("timeout")
                self.error = "timed out waiting for Touch ID"
                return {"kind": "unavailable", "approver": "touchid", "why": "timeout"}
            return None
        out, err = self.proc.communicate()
        self.live = False
        if self.proc.returncode == 0:
            tok = out.decode("utf-8", "replace").strip()
            if tok:
                self._tok = tok
                return {"kind": "approve", "approver": "touchid", "why": ""}
            self.error = "decrypted token is empty"
            return {"kind": "unavailable", "approver": "touchid", "why": "empty"}
        lines = err.decode("utf-8", "replace").strip().splitlines()
        self.error = "Touch ID / decrypt failed: %s" % clean(lines[-1] if lines else "exit %d" % self.proc.returncode, 160)
        if "cancel" in err.decode("utf-8", "replace").lower():
            return {"kind": "deny", "approver": "touchid", "why": "cancel"}
        return {"kind": "unavailable", "approver": "touchid", "why": "error"}

    def cancel(self, reason):
        if self.proc is None or self.proc.poll() is not None:
            self.live = False
            return
        for sig, wait in ((signal.SIGTERM, KILL_GRACE_S), (signal.SIGKILL, 5)):
            try:
                os.killpg(self.proc.pid, sig)
            except OSError:
                pass
            try:
                self.proc.wait(wait)
                break
            except subprocess.TimeoutExpired:
                continue
        try:
            self.proc.communicate(timeout=1)
        except (subprocess.SubprocessError, ValueError, OSError):
            pass
        self.live = False

    def token(self):
        return (self._tok, None) if self._tok else (None, self.error or "no token")


class IphoneLeg(Leg):
    """Client of ~/.whispera-link/approvals.sock: one connection per approval (PROTOCOL.md §8)."""
    name = "iphone"

    def __init__(self, c, canon, tname):
        self.c, self.canon, self.tname = c, canon, tname
        self.raw = canonical_bytes(canon)
        self.rid = canon["request_id"]
        self.sock, self.buf, self.why, self.device = None, b"", "", ""
        self.devices = 0

    def start(self):
        """Connect + request + ack. False (with self.why) = leg unavailable, never a deny."""
        if not os.path.isfile(iphone_identity(self.c)):
            self.why = "no-iphone-identity"
        elif not os.path.isfile(iphone_token_path(self.tname)):
            self.why = "no-iphone-token-copy"
        elif not any(load_pin(self.c, d)[0] for d in pinned_devices(self.c)):
            self.why = "no-pinned-device"
        if self.why:
            return False
        path = expand(self.c.get("approvals_socket") or "~/.whispera-link/approvals.sock")
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            s.settimeout(PHONE_CONNECT_S)
            s.connect(path)
        except (OSError, socket.timeout) as e:
            s.close()
            self.why = "daemon-unreachable(%s)" % type(e).__name__
            return False
        self.sock = s
        try:  # the daemon must run as us (it is only a relay, but do not even talk to another uid)
            peer_uid = struct.unpack_from("Ii", s.getsockopt(SOL_LOCAL, LOCAL_PEERCRED, 76))[1]
        except OSError:
            peer_uid = -1
        if peer_uid != os.getuid():
            self._close()
            self.why = "daemon-uid-mismatch"
            return False
        try:
            req = {"op": "approval.request", "v": 1, "request_id": self.rid,
                   "canonical_b64": base64.b64encode(self.raw).decode(), "expires_at": self.canon["expires_at"]}
            s.sendall(json.dumps(req).encode() + b"\n")
            end = time.time() + PHONE_ACK_S
            line = None
            while line is None:
                left = end - time.time()
                if left <= 0:
                    raise socket.timeout()
                s.settimeout(left)
                line = self._next_line(s.recv(4096) or None)
            msg = json.loads(line)
        except socket.timeout:
            self._close()
            self.why = "no-ack"
            return False
        except (OSError, ValueError, EOFError):
            self._close()
            self.why = "bad-ack"
            return False
        if not isinstance(msg, dict) or msg.get("request_id") != self.rid:
            self._close()
            self.why = "bad-ack"
            return False
        if msg.get("op") == "approval.error":
            self._close()
            self.why = "daemon-error(%s)" % clean(msg.get("code"), 30)
            return False
        n = msg.get("devices")
        if msg.get("op") != "approval.ack" or not isinstance(n, int) or isinstance(n, bool) or n < 1:
            self._close()
            self.why = "no-devices" if msg.get("op") == "approval.ack" else "bad-ack"
            return False
        self.devices = n
        s.setblocking(False)
        self.live = True
        return True

    def _next_line(self, chunk):
        """Feed bytes; return one complete line or None. EOF (chunk None) raises EOFError."""
        if chunk is None:
            raise EOFError()
        self.buf += chunk
        nl = self.buf.find(b"\n")
        if nl < 0:
            if len(self.buf) > MAX_DAEMON_LINE:
                raise ValueError("line too long")
            return None
        line, self.buf = self.buf[:nl], self.buf[nl + 1:]
        if len(line) > MAX_DAEMON_LINE:
            raise ValueError("line too long")
        return line

    def fileno_or_none(self):
        return self.sock if self.live else None

    def _send(self, obj):
        if self.sock is None:
            return
        try:
            self.sock.setblocking(True)
            self.sock.settimeout(1)
            self.sock.sendall(json.dumps(obj).encode() + b"\n")
        except OSError:
            pass

    def _close(self):
        if self.sock is not None:
            try:
                self.sock.close()
            except OSError:
                pass
        self.sock = None
        self.live = False

    def _result(self, outcome):
        self._send({"op": "approval.result", "request_id": self.rid, "outcome": outcome})
        self._close()

    def poll(self, now):
        if not self.live:
            return None
        line = None
        try:
            if self.buf.find(b"\n") >= 0:
                line = self._next_line(b"")
            else:
                try:
                    chunk = self.sock.recv(65536)
                except (BlockingIOError, InterruptedError):
                    return None
                line = self._next_line(chunk or None)
        except EOFError:
            self._close()
            return {"kind": "unavailable", "approver": "iphone", "why": "daemon-eof"}
        except ValueError:
            self._result("malformed")
            return {"kind": "deny", "approver": "iphone", "why": "malformed"}
        except OSError as e:
            self._close()
            return {"kind": "unavailable", "approver": "iphone", "why": "socket-error(%s)" % type(e).__name__}
        if line is None:
            return None
        return self._decide(line, now)

    def _decide(self, line, now):
        try:
            msg = json.loads(line)
        except ValueError:
            msg = None
        if not isinstance(msg, dict) or msg.get("op") != "approval.decision" \
                or msg.get("decision") not in ("approve", "deny"):
            self._result("malformed")
            return {"kind": "deny", "approver": "iphone", "why": "malformed"}
        dev = msg.get("device_id") if isinstance(msg.get("device_id"), str) else ""
        self.device = dev if DEVICE_RE.match(dev) else ""
        who = "iphone:" + (self.device or "?")
        if msg["decision"] == "deny":
            self._result("accepted")
            return {"kind": "deny", "approver": who, "why": "phone-deny"}
        outcome = "accepted"
        if msg.get("request_id") != self.rid:
            outcome = "malformed"
        elif not self.device:
            outcome = "unknown_device"
        else:
            der, _why = load_pin(self.c, self.device)
            if der is None:
                outcome = "unknown_device"
            elif now > self.canon["expires_at"]:
                outcome = "expired"
            else:
                sig = msg.get("signature")
                try:
                    sig_der = base64.b64decode(sig, validate=True) if isinstance(sig, str) else None
                except ValueError:
                    sig_der = None
                if not sig_der or not p256_verify(der, b"WL1-APPROVE\n" + self.raw, sig_der):
                    outcome = "bad_signature"
        self._result(outcome)
        if outcome != "accepted":  # fail closed: something is tampering or confused
            return {"kind": "deny", "approver": who, "why": outcome}
        return {"kind": "approve", "approver": who, "why": ""}

    def cancel(self, reason):
        if self.live:
            self._send({"op": "approval.cancel", "request_id": self.rid, "reason": reason})
        self._close()

    def token(self):
        """Decrypt the no-biometry iphone copy. Never falls back to the Touch ID copy."""
        age = find_tool("age", self.c.get("age_path"))
        if not age:
            return None, "age not found (brew install age age-plugin-se)"
        try:
            r = subprocess.run([age, "-d", "-i", iphone_identity(self.c), iphone_token_path(self.tname)],
                               capture_output=True, timeout=IPHONE_DECRYPT_S, env=tool_env(),
                               stdin=subprocess.DEVNULL)
        except subprocess.TimeoutExpired:
            return None, "iPhone token decrypt timed out"
        if r.returncode != 0:
            err = r.stderr.decode("utf-8", "replace").strip().splitlines()
            return None, "iPhone token decrypt failed: %s" % clean(err[-1] if err else "exit %d" % r.returncode, 160)
        tok = r.stdout.decode("utf-8").strip()
        return (tok, None) if tok else (None, "decrypted iPhone token is empty")


def approve_gate(c, rec, tname, title, msg, canon_fields):
    """Get one approval and the decrypted token. Returns (token, None) or (None, (result, detail, error)).
    Sets rec approver / request_id / notes for the audit line."""
    if is_default_approvers(c):  # exactly the pre-approver behaviour
        notify(title, msg, c)
        token, err = decrypt_token(tname, c)
        return (token, None) if not err else (None, ("auth-failed", err, err))
    approvers = approvers_of(c)
    if approvers is None:
        return None, ("rejected", "bad approvers config", "bad approvers config")
    canon = build_canonical(c, **canon_fields)
    rec["request_id"] = canon["request_id"]
    rec["approver"] = "none"
    notes = rec.setdefault("notes", [])
    created = canon["created_at"]
    deadline_touchid = created + TOUCHID_WINDOW_S
    deadline = deadline_touchid if "touchid" in approvers else canon["expires_at"] + PHONE_GRACE_S
    window = int(deadline - created)
    phone = touch = None
    try:
        if "iphone" in approvers:
            phone = IphoneLeg(c, canon, tname)
            if not phone.start():
                notes.append("iphone-unavailable:" + phone.why)
                phone = None
        if "touchid" in approvers:
            notify(title, msg + (" — or approve on iPhone" if phone else ""), c)
            touch = TouchIdLeg(c, tname, deadline_touchid)
            if not touch.start():
                notes.append("touchid-unavailable:start")
        legs = [x for x in (phone, touch) if x is not None]
        while True:
            now = time.time()
            if now >= deadline:
                for leg in legs:
                    leg.cancel("timeout")
                return None, ("timeout", "", "no approval within %ds (Touch ID or iPhone)" % window)
            live = [x for x in legs if x.live]
            if not live:
                if touch is not None and touch.error and phone is None:
                    return None, ("auth-failed", touch.error, touch.error)  # today's error
                return None, ("no-approver", "",
                              "no approver available (Touch ID unavailable, iPhone not connected)")
            socks = [x.fileno_or_none() for x in live if x.fileno_or_none() is not None]
            if socks:
                select.select(socks, [], [], 0.1)
            else:
                time.sleep(0.1)
            now = time.time()
            if now >= deadline:
                continue
            for leg in live:
                d = leg.poll(now)
                if d is None:
                    continue
                if d["kind"] == "unavailable":
                    notes.append("%s-unavailable:%s" % (leg.name, d["why"]))
                    continue
                rec["approver"] = d["approver"]
                other = [x for x in legs if x is not leg]
                if leg is touch:
                    reason = "touchid_approved" if d["kind"] == "approve" else "touchid_denied"
                    for x in other:
                        x.cancel(reason)
                    if d["kind"] == "deny":
                        return None, ("denied", "by=touchid", touch.error)
                    return touch.token()[0], None
                for x in other:  # the phone decided: stop the Touch ID prompt first
                    x.cancel("phone_decided")
                if d["kind"] == "deny":
                    detail = "by=%s" % d["approver"] + ("" if d["why"] == "phone-deny" else " outcome=" + d["why"])
                    err = "denied on iPhone" if d["why"] == "phone-deny" else \
                        "iPhone approval rejected (%s)" % d["why"]
                    return None, ("denied", detail, err)
                token, err = leg.token()
                if err:
                    return None, ("auth-failed", err, err)
                return token, None
    finally:  # exceptions included: never leave a prompt up or the daemon waiting
        for leg in (phone, touch):
            if leg is not None and leg.live:
                leg.cancel("broker_error")


# ------------------------------------------------------- who is asking

def ps_field(pid, field):
    try:
        r = subprocess.run(["/bin/ps", "-o", field + "=", "-p", str(pid)], capture_output=True, timeout=3)
        return r.stdout.decode("utf-8", "replace").strip()
    except Exception:  # noqa: BLE001
        return ""


def proc_label(pid):
    args = ps_field(pid, "args").split()
    if not args:
        return "pid%s" % pid
    base = os.path.basename(args[0]).lstrip("-")
    if base in ("bash", "zsh", "sh") and "-c" in args:
        return base + " -c"
    if base in ("node", "bun", "deno", "bash", "zsh", "sh", "perl", "ruby", "env") or base.startswith("python"):
        for a in args[1:]:
            if not a.startswith("-"):
                return "%s %s" % (base, "/".join(a.split("/")[-2:]))
    return base


def proc_chain(pid, depth=4):
    out = []
    for _ in range(depth):
        try:
            pid = int(pid)
        except ValueError:
            break
        if pid <= 1:
            break
        out.append(proc_label(pid))
        pid = ps_field(pid, "ppid") or "0"
    return " < ".join(out)


def ssh_destination(args):
    """Destination of an ssh client argv, never the remote command (which could hold a value)."""
    with_arg = set("-" + ch for ch in "BbcDEeFIiJLlmOoPpQRSWw")
    i = 1
    while i < len(args):
        a = args[i]
        if a == "--":
            return args[i + 1] if i + 1 < len(args) else "?"
        if a.startswith("-"):
            i += 2 if a in with_arg else 1
            continue
        return a
    return "?"


# ---------------------------------------------------------------- broker

def validate_read_args(raw, c):
    pos, server = [], None
    i = 0
    while i < len(raw):
        a = raw[i]
        if a in ("--color", "-c"):
            i += 2
        elif a in ("--output", "-o"):
            if i + 1 >= len(raw) or raw[i + 1] != "json":
                return None
            i += 2
        elif a in ("--server-url", "-u"):
            if i + 1 >= len(raw) or raw[i + 1] not in c["server_urls"]:
                return None
            server = raw[i + 1]
            i += 2
        elif a.startswith("-"):
            return None  # -t/--access-token, -f, -p, --value, ... all refused
        else:
            pos.append(a)
            i += 1
    name = lambda pid: c["project_names"].get(pid.lower(), pid)  # noqa: E731
    if pos == ["project", "list"]:
        summary = "list projects"
    elif pos == ["secret", "list"]:
        summary = "read ALL secrets the token can see"
    elif len(pos) == 3 and pos[:2] == ["secret", "list"] and UUID_RE.match(pos[2]):
        summary = "read all secrets in " + name(pos[2])
    elif len(pos) == 3 and pos[:2] == ["secret", "get"] and UUID_RE.match(pos[2]):
        summary = "read secret %s…" % pos[2][:8]
    elif len(pos) == 3 and pos[:2] == ["project", "get"] and UUID_RE.match(pos[2]):
        summary = "get project " + name(pos[2])
    else:
        return None
    if any(denied_project(p, c) for p in pos):
        return None
    args = ["--output", "json"] + (["--server-url", server] if server else []) + pos
    return args, summary


def scrub(stdout, c):
    def bad(e):
        return (denied_key(e.get("key", ""), c) or denied_project(e.get("projectId"), c)
                or denied_project(e.get("id"), c) or denied_project(e.get("name"), c))
    try:
        data = json.loads(stdout or b"null")
    except ValueError:
        return stdout
    if isinstance(data, list):
        return json.dumps([e for e in data if not (isinstance(e, dict) and bad(e))]).encode()
    if isinstance(data, dict) and bad(data):
        return b"{}"
    return stdout


def handle(req, peer_pid):
    c = load_config()
    op = req.get("op", "")
    host = clean(req.get("host"), 48)
    caller = clean(req.get("caller"), 60)
    peer_args = ps_field(peer_pid, "args").split()
    if peer_args and os.path.basename(peer_args[0]) == "ssh":
        via = "ssh session to " + clean(ssh_destination(peer_args), 40)
        who = "%s (%s)" % (host or "remote", caller or "?")
    else:
        via = "local: " + clean(proc_chain(ps_field(peer_pid, "ppid") or peer_pid), 70)
        who = caller or "local process"
    rec = {"op": op, "host": host, "caller": caller, "via": via}
    dry = bool(req.get("dryrun"))

    def reject(msg):
        rec.update(result="rejected", detail=msg)
        log(rec)
        return {"ok": False, "error": msg}

    if op == "ping":
        return {"ok": True, "broker": "bws-touchid", "broker_name": c["broker_name"]}

    if op == "save":
        key = req.get("key") or ""
        project = req.get("project") or (c["save_projects"][0] if c["save_projects"] else "")
        note = req.get("note") or ""
        value = req.get("value")
        rec.update(key=key, project=project, token=c["write_token"])
        if not KEY_RE.match(key):
            return reject("key must match ^[A-Z0-9_]+$ (max 128)")
        if denied_key(key, c):
            return reject("that key prefix is owner-only")
        if not project or denied_project(project, c) or project not in c["save_projects"]:
            return reject("project '%s' is not in save_projects %s" % (clean(project, 40), c["save_projects"]))
        if not isinstance(value, str) or not value:
            return reject("empty value")
        if len(value.encode()) > MAX_VALUE:
            return reject("value larger than %d bytes" % MAX_VALUE)
        if not isinstance(note, str) or len(note) > 1000:
            return reject("note longer than 1000 chars")
        if approvers_of(c) is None:
            return reject("bad approvers config")
        if dry:
            rec.update(result="DRYRUN-ok")
            log(rec)
            return {"ok": True, "id": "dryrun", "action": "dry-run"}
        token, fail = approve_gate(c, rec, c["write_token"], "Touch ID: save %s" % key,
                                   "%s → %s [%s]" % (who, project, via),
                                   dict(op="save", key=key, summary="save %s → %s" % (key, project),
                                        project=project, token=c["write_token"], host=host, caller=caller, via=via))
        if fail:
            rec.update(result=fail[0], detail=fail[1])
            log(rec)
            return {"ok": False, "error": fail[2]}
        code, out, err = run_bws(["--output", "json", "project", "list"], token, c)
        try:
            projects = json.loads(out) if code == 0 else None
        except ValueError:
            projects = None
        if not isinstance(projects, list):
            return reject("bws project list failed: " + err)
        pid = next((p.get("id") for p in projects if p.get("name") == project), None)
        if not pid or denied_project(pid, c):
            return reject("project '%s' is not visible to the write token" % project)
        code, out, err = run_bws(["--output", "json", "secret", "list", pid], token, c)
        try:
            secrets = json.loads(out) if code == 0 else None
        except ValueError:
            secrets = None
        if not isinstance(secrets, list):
            return reject("bws secret list failed: " + err)
        existing = [s for s in secrets if s.get("key") == key]
        if len(existing) > 1:
            return reject("%d secrets already named %s in %s; fix by hand" % (len(existing), key, project))
        # bws 2.x only takes the value on argv: it is visible to same-user processes on this Mac
        # for the second bws runs. Never logged; redacted from errors.
        if existing:
            args = ["--output", "json", "secret", "edit", "--value", value]
            args += ["--note", note] if note else []
            args.append(existing[0]["id"])
            action = "updated"
        else:
            args = ["--output", "json", "secret", "create", key, value, pid]
            args += ["--note", note] if note else []
            action = "created"
        code, out, err = run_bws(args, token, c)
        del token
        if code != 0:
            rec.update(result="error", detail="bws %s failed exit %d" % (action, code))
            log(rec)
            return {"ok": False, "error": "bws failed: " + err.replace(value, "[REDACTED]")}
        try:
            sid = json.loads(out).get("id", "")
        except (ValueError, AttributeError):
            sid = ""
        rec.update(result=action, detail="id=%s" % sid)
        log(rec)
        return {"ok": True, "id": sid, "action": action, "project": project}

    if op == "bws":
        raw = req.get("args")
        tname = req.get("token") or c["read_token"]
        rec["token"] = tname
        if not NAME_RE.match(str(tname)):
            return reject("bad token name")
        v = validate_read_args(raw, c) if isinstance(raw, list) and all(isinstance(a, str) for a in raw) else None
        if not v:
            return reject("refused: only read-only bws calls (project list/get, secret list/get, -o json)")
        args, summary = v
        rec["detail"] = summary
        if approvers_of(c) is None:
            return reject("bad approvers config")
        if dry:
            rec.update(result="DRYRUN-ok")
            log(rec)
            return {"ok": True, "exit": 0, "stdout_b64": base64.b64encode(b"[]").decode()}
        pos = args[4:] if args[2:3] == ["--server-url"] else args[2:]
        project = c["project_names"].get(pos[2].lower(), pos[2]) \
            if len(pos) == 3 and pos[:2] in (["secret", "list"], ["project", "get"]) else ""
        token, fail = approve_gate(c, rec, tname, "Touch ID: %s" % summary, "%s [%s]" % (who, via),
                                   dict(op="bws", key="", summary=summary, project=project, token=tname,
                                        host=host, caller=caller, via=via))
        if fail:
            rec.update(result=fail[0], detail=fail[1] or summary)
            log(rec)
            return {"ok": False, "error": fail[2]}
        code, out, err = run_bws(args, token, c)
        del token
        rec["result"] = "exit=%d" % code
        log(rec)
        return {"ok": code == 0, "exit": code, "stdout_b64": base64.b64encode(scrub(out, c)).decode(),
                "stderr": err, "error": "" if code == 0 else "bws exited %d" % code}

    return reject("unknown op")


def read_line(conn, limit):
    buf = b""
    while len(buf) <= limit:
        chunk = conn.recv(65536)
        if not chunk:
            return buf or None
        nl = chunk.find(b"\n")
        if nl >= 0:
            return buf + chunk[:nl]
        buf += chunk
    return None


def cmd_serve(_argv):
    os.umask(0o077)
    os.makedirs(SOCK_DIR, exist_ok=True)
    os.chmod(SOCK_DIR, 0o700)
    try:
        os.unlink(LOCAL_SOCK)
    except FileNotFoundError:
        pass
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(LOCAL_SOCK)
    os.chmod(LOCAL_SOCK, 0o600)
    srv.listen(16)
    log({"op": "serve", "result": "listening", "detail": LOCAL_SOCK})
    while True:  # serial on purpose: one Touch ID prompt at a time
        conn, _ = srv.accept()
        try:
            cred = conn.getsockopt(SOL_LOCAL, LOCAL_PEERCRED, 76)
            peer_uid = struct.unpack_from("Ii", cred)[1]
            peer_pid = struct.unpack("i", conn.getsockopt(SOL_LOCAL, LOCAL_PEERPID, 4))[0]
            if peer_uid != os.getuid():
                resp = {"ok": False, "error": "peer uid mismatch"}
            else:
                conn.settimeout(15)
                line = read_line(conn, MAX_LINE)
                try:
                    req = json.loads(line) if line else None
                except ValueError:
                    req = None
                if not isinstance(req, dict):
                    resp = {"ok": False, "error": "bad request (one JSON line)"}
                else:
                    conn.settimeout(150)
                    resp = handle(req, peer_pid)
                    req.clear()
            conn.sendall(json.dumps(resp).encode() + b"\n")
        except (OSError, socket.timeout):
            pass  # status probes and clients that gave up
        except Exception as e:  # noqa: BLE001
            log({"op": "serve", "result": "error", "detail": type(e).__name__})
        finally:
            conn.close()


# ---------------------------------------------------------------- client

def not_connected(c, tried):
    return ("%s broker unreachable (tried %s).\n"
            "Bitwarden SM access needs the owner's Touch ID on that Mac. It reaches this host through\n"
            "~/.bws-broker/fwd.sock (a persistent tunnel or an ssh session opened FROM that Mac); the Mac\n"
            "may be asleep, off the network, or its tunnel down. Ask the owner, or ask him to store the\n"
            "value himself. Nothing was sent." % (c["broker_name"], ", ".join(tried) or "nothing"))


def socket_order(c):
    """Sockets a client tries, in order. BWS_BROKER_SOCK first; inside an ssh session the broker of
    the Mac that opened it (forwarded socket) wins, otherwise this Mac's own broker. local_broker=false
    drops this Mac's broker entirely."""
    order = [FWD_SOCK, LOCAL_SOCK] if os.environ.get("SSH_CONNECTION") else [LOCAL_SOCK, FWD_SOCK]
    if not c.get("local_broker", True):
        order.remove(LOCAL_SOCK)
    env = os.environ.get("BWS_BROKER_SOCK")
    return ([env] if env else []) + [p for p in order if p != env]


def connect_first(paths):
    for p in paths:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            s.connect(p)
            return s
        except OSError:
            s.close()
    return None


def broker_call(req):
    c = load_config()
    order = socket_order(c)
    s = connect_first(order)
    if s is None:
        die(not_connected(c, [p.replace(HOME, "~") for p in order]), 3)
    try:
        s.settimeout(160)
        s.sendall(json.dumps(req).encode() + b"\n")
        line = read_line(s, MAX_STDOUT * 2)
    except OSError as e:
        die("broker connection failed: %s" % e, 4)
    finally:
        s.close()
    try:
        return json.loads(line)
    except (TypeError, ValueError):
        die("no answer from the broker (timed out or died)", 4)


def my_caller():
    return clean(os.environ.get("BWS_TOUCHID_CALLER") or proc_chain(os.getppid(), 2), 60)


def read_value(prompt):
    if sys.stdin.isatty():
        return getpass.getpass(prompt)
    data = sys.stdin.buffer.read(MAX_VALUE + 3)
    if len(data) > MAX_VALUE + 2:
        die("value larger than %d bytes" % MAX_VALUE)
    if data.endswith(b"\n"):
        data = data[:-1]
    if data.endswith(b"\r"):
        data = data[:-1]
    try:
        return data.decode("utf-8")
    except UnicodeDecodeError:
        die("value is not UTF-8")


def cmd_save(argv):
    project = note = key = ""
    dry = False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("--project", "--note") and i + 1 < len(argv):
            if a == "--project":
                project = argv[i + 1]
            else:
                note = argv[i + 1]
            i += 2
        elif a == "--dry-run":
            dry, i = True, i + 1
        elif a in ("-h", "--help"):
            print('usage: printf %s "$VALUE" | bws-save [--project NAME] [--note TEXT] [--dry-run] KEY')
            sys.exit(0)
        elif a.startswith("-"):
            die("unknown option " + a, 2)
        elif key:
            die("only one KEY; the value goes on stdin, never argv", 2)
        else:
            key, i = a, i + 1
    if not KEY_RE.match(key):
        die("KEY must match ^[A-Z0-9_]+$", 2)
    value = read_value("Value for %s (hidden): " % key)
    if not value:
        die("empty value on stdin", 2)
    req = {"op": "save", "key": key, "value": value, "host": socket.gethostname().split(".")[0],
           "caller": my_caller(), "dryrun": dry}
    if project:
        req["project"] = project
    if note:
        req["note"] = note
    eprint("bws-save: waiting for the owner's Touch ID on %s…" % load_config()["broker_name"])
    r = broker_call(req)
    if r.get("ok"):
        print("ok %s %s id=%s" % (r.get("action", "saved"), key, r.get("id", "")))
        sys.exit(0)
    die("refused: " + str(r.get("error")), 5)


def cmd_gated(argv):
    req = {"op": "bws", "args": argv, "host": socket.gethostname().split(".")[0], "caller": my_caller(),
           "dryrun": os.environ.get("BWS_BROKER_DRYRUN") == "1"}
    if os.environ.get("BWS_TOUCHID_TOKEN"):
        req["token"] = os.environ["BWS_TOUCHID_TOKEN"]
    r = broker_call(req)
    out = base64.b64decode(r.get("stdout_b64") or "")
    sys.stdout.buffer.write(out)
    sys.stdout.flush()
    if r.get("stderr"):
        eprint(r["stderr"])
    if not r.get("ok"):
        eprint("bws-gated: " + str(r.get("error") or "failed"))
        sys.exit(r.get("exit") or 5)
    sys.exit(0)


# ------------------------------------------------------- local admin

def cmd_init(argv):
    ac = "any-biometry"
    if "--access-control" in argv:
        ac = argv[argv.index("--access-control") + 1]
    os.makedirs(TOKENS_DIR, exist_ok=True)
    os.chmod(CONF_DIR, 0o700)
    os.chmod(TOKENS_DIR, 0o700)
    if os.path.exists(IDENTITY):
        print("identity exists: %s" % IDENTITY)
    else:
        plugin = find_tool("age-plugin-se", load_config().get("age_plugin_se_path"))
        if not plugin:
            die("age-plugin-se not found (brew install age age-plugin-se)")
        subprocess.run([plugin, "keygen", "--access-control", ac, "-o", IDENTITY], check=True,
                       stdout=subprocess.DEVNULL)
        os.chmod(IDENTITY, 0o600)
        print("created Secure Enclave identity (%s): %s" % (ac, IDENTITY))
    plugin = find_tool("age-plugin-se", load_config().get("age_plugin_se_path"))
    subprocess.run([plugin, "recipients", "-i", IDENTITY, "-o", RECIPIENT], check=True)
    os.chmod(RECIPIENT, 0o600)
    print("recipient: %s" % open(RECIPIENT).read().strip())


def encrypt_to(age, recipient_file, token, dest):
    """age-encrypt token (stdin only, never argv) to dest.tmp, 0600, rename. Returns an error or ""."""
    os.makedirs(TOKENS_DIR, exist_ok=True)
    tmp = dest + ".tmp"
    old = os.umask(0o077)
    try:
        r = subprocess.run([age, "-R", recipient_file, "-o", tmp], input=token.encode(), env=tool_env(),
                           capture_output=True)
    finally:
        os.umask(old)
    if r.returncode != 0:
        try:
            os.remove(tmp)
        except OSError:
            pass
        return r.stderr.decode("utf-8", "replace")[:200] or "exit %d" % r.returncode
    os.chmod(tmp, 0o600)
    os.replace(tmp, dest)
    return ""


def cmd_store(argv):
    names = [a for a in argv if not a.startswith("-")]
    if len(names) != 1 or not NAME_RE.match(names[0]):
        die("usage: bws-touchid store NAME [--stdin]   (NAME like read, write)", 2)
    name = names[0]
    if not os.path.exists(RECIPIENT):
        die("no identity yet: run bws-touchid init")
    if "--stdin" in argv:
        if sys.stdin.isatty():
            die("--stdin expects a pipe")
        token = read_value("")
    else:
        token = getpass.getpass("Paste the Bitwarden SM access token for '%s' (hidden): " % name)
    token = token.strip()
    if not TOKEN_RE.match(token):
        die("that does not look like a bws access token (0.<uuid>.<secret>:<key>); nothing stored")
    age = find_tool("age", load_config().get("age_path"))
    if not age:
        die("age not found (brew install age age-plugin-se)")
    dest = token_path(name)
    err = encrypt_to(age, RECIPIENT, token, dest)
    if err:
        del token
        die("age encrypt failed: " + err)
    log({"op": "store", "result": "ok", "token": name})
    print("stored token '%s' -> %s (decrypting it needs Touch ID)" % (name, dest))
    if os.path.exists(RECIPIENT_IPHONE):  # already holding the plaintext: no extra prompt
        err = encrypt_to(age, RECIPIENT_IPHONE, token, iphone_token_path(name))
        if err:
            del token
            die("iPhone copy: age encrypt failed: " + err)
        log({"op": "store", "result": "ok", "token": name, "detail": "iphone copy"})
        print("stored iPhone copy -> %s (no biometry; used only after a verified iPhone approval)"
              % iphone_token_path(name))
    del token


def cmd_delete(argv):
    if len(argv) != 1:
        die("usage: bws-touchid delete NAME", 2)
    found = False
    for path in (token_path(argv[0]), iphone_token_path(argv[0])):
        if os.path.exists(path):
            os.remove(path)
            found = True
            print("deleted %s" % path)
    if found:
        log({"op": "delete", "result": "ok", "token": argv[0]})
    else:
        print("no token named %s" % argv[0])


def cmd_status(_argv):
    c = load_config()
    print("identity:  %s" % (IDENTITY if os.path.exists(IDENTITY) else "absent (client-only host)"))
    files = os.listdir(TOKENS_DIR) if os.path.isdir(TOKENS_DIR) else []
    toks = sorted(f[:-4] for f in files if f.endswith(".age") and not f.endswith(".iphone.age"))
    print("tokens:    %s" % (", ".join(toks) or "none"))
    reach = "unreachable"
    for p in socket_order(c):
        s = connect_first([p])
        if s:
            s.close()
            reach = "reachable at " + p
            break
    print("broker:    %s (%s)" % (reach, c["broker_name"]))
    if not c.get("local_broker", True):
        print("           local_broker=false: this Mac's broker.sock is never used")
    print("config:    %s" % (CONFIG_PATH if os.path.exists(CONFIG_PATH) else "defaults"))
    print("log:       %s" % LOG_PATH)
    a = approvers_of(c)
    print("approvers: %s" % (", ".join(a) if a else "BAD CONFIG %r (every gated op is refused)" % (c.get("approvers"),)))
    ident = iphone_identity(c)
    print("iphone id: %s" % (ident if os.path.exists(ident) else "absent (bws-touchid iphone-setup)"))
    copies = sorted(f[:-len(".iphone.age")] for f in files if f.endswith(".iphone.age"))
    print("iphone tokens: %s" % (", ".join(copies) or "none"))
    pins = pinned_devices(c)
    for d in pins:
        der, why = load_pin(c, d)
        print("pinned:    %s %s" % (d, display_fp(der) if der else "REFUSED: " + why))
    if not pins:
        print("pinned:    none (bws-touchid approver add)")
    sock = expand(c.get("approvals_socket") or "")
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(PHONE_CONNECT_S)
    try:
        s.connect(sock)
        ok = "accepts connections"
    except (OSError, socket.timeout):
        ok = "not reachable"
    finally:
        s.close()
    print("approvals.sock: %s (%s)" % (ok, sock))


def cmd_run(argv):
    c = load_config()
    name = c["read_token"]
    if "--token" in argv[: argv.index("--") if "--" in argv else len(argv)]:
        name = argv[argv.index("--token") + 1]
    if "--" not in argv or argv.index("--") == len(argv) - 1:
        die("usage: bws-touchid run [--token NAME] -- CMD ARGS...", 2)
    cmd = argv[argv.index("--") + 1:]
    shown = clean(" ".join(cmd), 60)
    notify("Touch ID: run with token '%s'" % name, "%s [%s]" % (shown, clean(proc_chain(os.getppid(), 2), 50)), c)
    token, err = decrypt_token(name, c)
    if err:
        die(err)
    log({"op": "run", "result": "exec", "token": name, "caller": proc_chain(os.getppid(), 2),
         "detail": os.path.basename(cmd[0])})
    env = dict(os.environ)
    env["BWS_ACCESS_TOKEN"] = token
    try:
        os.execvpe(cmd[0], cmd, env)
    except OSError as e:
        die("exec %s failed: %s" % (cmd[0], e), 127)


def cmd_reap(_argv):
    if not os.path.exists(FWD_SOCK):
        return
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        s.connect(FWD_SOCK)
    except ConnectionRefusedError:
        os.unlink(FWD_SOCK)
    except OSError:
        pass
    finally:
        s.close()


def cmd_ping(argv):
    """Exit 0 if a broker answers a ping (no Touch ID, not logged), 3 otherwise."""
    c = load_config()
    paths = argv[:1] or socket_order(c)
    for p in paths:
        s = connect_first([p])
        if not s:
            continue
        try:
            s.settimeout(10)
            s.sendall(b'{"op": "ping"}\n')
            r = json.loads(read_line(s, 4096) or b"null")
        except (OSError, ValueError):
            r = None
        finally:
            s.close()
        if isinstance(r, dict) and r.get("ok"):
            print("ok %s (%s)" % (p, r.get("broker_name", "?")))
            sys.exit(0)
    die(not_connected(c, [p.replace(HOME, "~") for p in paths]), 3)


# ------------------------------------------------------- iPhone approver admin

def write_private(path, data, dir_mode=0o700):
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    os.chmod(d, dir_mode)
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(data)
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


def cmd_approver(argv):
    c = load_config()
    sub = argv[0] if argv else ""
    if sub == "list":
        pins = pinned_devices(c)
        for d in pins:
            der, why = load_pin(c, d)
            print("%s  %s" % (d, display_fp(der) if der else "REFUSED: " + why))
        if not pins:
            print("no pinned iPhone approvers in %s" % approvers_dir(c))
        log({"op": "approver-list", "result": "ok", "detail": "%d pinned" % len(pins)})
        return
    if sub == "remove" and len(argv) == 2:
        dev = argv[1]
        if not DEVICE_RE.match(dev):
            die("device id must match ^dev_[a-z2-7]{24}$", 2)
        path = os.path.join(approvers_dir(c), dev + ".pub")
        if os.path.lexists(path):
            os.remove(path)
            log({"op": "approver-remove", "result": "ok", "detail": dev})
            print("removed %s" % dev)
        else:
            log({"op": "approver-remove", "result": "absent", "detail": dev})
            print("no pin for %s" % dev)
        return
    if sub == "add" and len(argv) == 3:
        dev, pem = argv[1], argv[2]
        if not DEVICE_RE.match(dev):
            die("device id must match ^dev_[a-z2-7]{24}$", 2)
        try:
            with open(expand(pem)) as f:
                der = spki_from_pem(f.read(8192))
        except (OSError, UnicodeDecodeError) as e:
            die("cannot read %s: %s" % (pem, e))
        if not der:
            die("%s is not a P-256 public key PEM (SPKI)" % pem)
        shown = display_fp(der)
        print("device:      %s" % dev)
        print("fingerprint: %s   (compare with the approve fingerprint on the phone)" % shown)
        sys.stdout.write("Type the last 4 characters shown on the phone: ")
        sys.stdout.flush()
        typed = (sys.stdin.readline() or "").strip().lower().replace("-", "")
        if typed != shown.replace("-", "")[-4:]:
            log({"op": "approver-add", "result": "rejected", "detail": "%s fingerprint mismatch" % dev})
            die("fingerprint mismatch; nothing pinned")
        notify("Touch ID: pin iPhone approver", "%s %s" % (dev, shown), c)
        token, err = decrypt_token(c["read_token"], c)  # owner presence; the token is discarded
        if err:
            log({"op": "approver-add", "result": "auth-failed", "detail": dev})
            die(err)
        del token
        path = os.path.join(approvers_dir(c), dev + ".pub")
        write_private(path, pem_from_spki(der))
        log({"op": "approver-add", "result": "ok", "detail": "%s fp=%s" % (dev, fingerprint(der))})
        print("pinned %s -> %s" % (dev, path))
        if "iphone" not in (approvers_of(c) or []):
            print('next: set "approvers": ["touchid", "iphone"] in %s and restart the broker' % CONFIG_PATH)
        return
    die("usage: bws-touchid approver add DEVICE_ID PEM | list | remove DEVICE_ID", 2)


def cmd_iphone_setup(_argv):
    """One-time (owner, two Touch IDs): a no-biometry Secure Enclave identity and an iPhone copy of each
    token, so a phone-signed approval can be served without Touch ID (PROTOCOL.md §11.5)."""
    c = load_config()
    if not os.path.exists(IDENTITY):
        die("no Touch ID identity yet: run bws-touchid init and store the tokens first")
    plugin = find_tool("age-plugin-se", c.get("age_plugin_se_path"))
    age = find_tool("age", c.get("age_path"))
    if not plugin or not age:
        die("age / age-plugin-se not found (brew install age age-plugin-se)")
    ident = iphone_identity(c)
    os.makedirs(os.path.dirname(ident), exist_ok=True)
    old = os.umask(0o077)
    try:
        if os.path.exists(ident):
            print("iphone identity exists: %s" % ident)
        else:
            subprocess.run([plugin, "keygen", "--access-control", "none", "-o", ident], check=True,
                           stdout=subprocess.DEVNULL, env=tool_env())
            os.chmod(ident, 0o600)
            print("created no-biometry Secure Enclave identity: %s" % ident)
        subprocess.run([plugin, "recipients", "-i", ident, "-o", RECIPIENT_IPHONE], check=True,
                       stdout=subprocess.DEVNULL, env=tool_env())
        os.chmod(RECIPIENT_IPHONE, 0o600)
    finally:
        os.umask(old)
    done = []
    for name in dict.fromkeys([c["read_token"], c["write_token"]]):
        if not os.path.isfile(token_path(name)):
            print("skip '%s': no Touch ID token stored (bws-touchid store %s)" % (name, name))
            continue
        print("Touch ID for token '%s'…" % name)
        notify("Touch ID: iPhone copy of token '%s'" % name, "bws-touchid iphone-setup", c)
        token, err = decrypt_token(name, c)
        if err:
            log({"op": "iphone-setup", "result": "auth-failed", "token": name})
            die(err)
        err = encrypt_to(age, RECIPIENT_IPHONE, token, iphone_token_path(name))
        del token
        if err:
            die("age encrypt failed: " + err)
        log({"op": "iphone-setup", "result": "ok", "token": name})
        done.append(name)
        print("wrote %s" % iphone_token_path(name))
    print("""
iPhone copies: %s
Next:
  1. whispera-link pair                      (scan the QR with the Whispera app)
  2. bws-touchid approver add <device_id> ~/.whispera-link/keys/<device_id>.approve.pem
  3. set "approvers": ["touchid", "iphone"] in %s
  4. launchctl kickstart -k gui/$(id -u)/bws-touchid.broker
Threat note: the iPhone identity has no biometry, so a process running as you on this Mac can decrypt
the .iphone.age copies directly. The phone signature protects the broker path, not those files.""" % (
        ", ".join(done) or "none", CONFIG_PATH))


# ---------------------------------------------------------------- tunnels

TUNNEL_PREFIX = "bws-touchid.tunnel."
LAUNCH_AGENTS = os.path.join(HOME, "Library", "LaunchAgents")
HOST_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._@-]{0,127}$")


def tunnel_list(c):
    out = []
    for t in c.get("tunnels") or []:
        t = {"host": t} if isinstance(t, str) else dict(t)
        if not HOST_RE.match(str(t.get("host", ""))):
            die("bad tunnel host %r (an ssh alias or user@host)" % t.get("host"))
        rs = t.get("remote_sock") or ""
        if rs and (not rs.startswith("/") or ":" in rs):
            die("tunnel %s: remote_sock must be an absolute path" % t["host"])
        t["label"] = TUNNEL_PREFIX + re.sub(r"[^A-Za-z0-9.-]", "-", t["host"])
        out.append(t)
    return out


def ssh_base(c):
    opts = ["-o", "BatchMode=yes", "-o", "ConnectTimeout=10"]
    for o in c.get("tunnel_ssh_options") or []:
        opts += ["-o", str(o)]
    return ["/usr/bin/ssh"] + opts


def tunnel_ssh_argv(c, host, remote_sock):
    # No ClearAllForwardings here: it would also clear this -R. Do not also put a RemoteForward to
    # the same socket in ~/.ssh/config for this host, or the second bind fails.
    return ssh_base(c) + ["-N", "-o", "ExitOnForwardFailure=yes", "-o", "ServerAliveInterval=15",
                          "-o", "ServerAliveCountMax=3", "-R", "%s:%s" % (remote_sock, LOCAL_SOCK), host]


def tunnel_plist(label, host, remote_sock):
    esc = lambda x: x.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")  # noqa: E731
    me = os.path.realpath(sys.argv[0]) if os.path.basename(sys.argv[0]) == "bws-touchid" else \
        os.path.join(HOME, ".local", "bin", "bws-touchid")
    args = ["/usr/bin/python3", me, "tunnel", "run", host, remote_sock]
    errlog = os.path.join(HOME, "Library", "Logs", label + ".err.log")
    return """<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>%s</string>
  <key>ProgramArguments</key><array>%s</array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardErrorPath</key><string>%s</string>
</dict></plist>
""" % (esc(label), "".join("<string>%s</string>" % esc(a) for a in args), esc(errlog))


def launchctl(*args):
    return subprocess.run(["/bin/launchctl"] + list(args), capture_output=True, text=True)


def remote_fwd_path(c, host):
    """Ask HOST for its $HOME (forwarded socket paths are not ~-expanded) and create ~/.bws-broker."""
    r = subprocess.run(ssh_base(c) + ["-o", "ClearAllForwardings=yes", host,
                                     'mkdir -p "$HOME/.bws-broker" && chmod 700 "$HOME/.bws-broker" '
                                     '&& printf %s "$HOME"'], capture_output=True, text=True, timeout=30)
    home = r.stdout.strip()
    if r.returncode != 0 or not home.startswith("/"):
        die("tunnel %s: cannot reach it over ssh (%s)" % (host, clean(r.stderr.strip(), 160)))
    return home + "/.bws-broker/fwd.sock"


def tunnel_install(c):
    uid = str(os.getuid())
    tunnels = tunnel_list(c)
    wanted = {t["label"] for t in tunnels}
    os.makedirs(LAUNCH_AGENTS, exist_ok=True)
    for f in sorted(os.listdir(LAUNCH_AGENTS)):  # drop tunnels no longer in the config
        if f.startswith(TUNNEL_PREFIX) and f.endswith(".plist") and f[:-6] not in wanted:
            launchctl("bootout", "gui/%s/%s" % (uid, f[:-6]))
            os.remove(os.path.join(LAUNCH_AGENTS, f))
            print("removed %s" % f[:-6])
    for t in tunnels:
        rs = t.get("remote_sock") or remote_fwd_path(c, t["host"])
        path = os.path.join(LAUNCH_AGENTS, t["label"] + ".plist")
        with open(path, "w") as f:
            f.write(tunnel_plist(t["label"], t["host"], rs))
        launchctl("bootout", "gui/%s/%s" % (uid, t["label"]))
        r = launchctl("bootstrap", "gui/" + uid, path)
        if r.returncode != 0:
            die("launchctl bootstrap %s failed: %s" % (t["label"], r.stderr.strip()))
        print("loaded %s: %s -> %s" % (t["label"], t["host"], rs))
    if not tunnels:
        print("no tunnels in %s" % CONFIG_PATH)


def tunnel_uninstall(_c):
    uid = str(os.getuid())
    for f in sorted(os.listdir(LAUNCH_AGENTS)) if os.path.isdir(LAUNCH_AGENTS) else []:
        if f.startswith(TUNNEL_PREFIX) and f.endswith(".plist"):
            launchctl("bootout", "gui/%s/%s" % (uid, f[:-6]))
            os.remove(os.path.join(LAUNCH_AGENTS, f))
            print("removed %s" % f[:-6])


def tunnel_status(c, probe):
    uid = str(os.getuid())
    tunnels = tunnel_list(c)
    if not tunnels:
        print("no tunnels in %s" % CONFIG_PATH)
    bad = 0
    for t in tunnels:
        r = launchctl("print", "gui/%s/%s" % (uid, t["label"]))
        if r.returncode != 0:
            print("%-40s not loaded (bws-touchid tunnel install)" % t["label"])
            bad += 1
            continue
        info = dict(re.findall(r"^\s*(state|pid|runs|last exit code) = (.+)$", r.stdout, re.M))
        line = "%-40s %s pid=%s runs=%s last-exit=%s" % (t["label"], info.get("state", "?"), info.get("pid", "-"),
                                                        info.get("runs", "?"), info.get("last exit code", "-"))
        if probe:
            q = subprocess.run(ssh_base(c) + ["-o", "ClearAllForwardings=yes", t["host"],
                                              "/usr/bin/python3 ~/.local/bin/bws-touchid ping " +
                                              (t.get("remote_sock") or "~/.bws-broker/fwd.sock")],
                               capture_output=True, text=True, timeout=40)
            ok = q.returncode == 0
            bad += 0 if ok else 1
            line += "  remote fwd.sock: " + ("answers" if ok else "NOT answering")
        elif "pid" not in info:
            bad += 1
        print(line)
    sys.exit(1 if bad else 0)


def tunnel_run(host, remote_sock):
    """launchd entry point: one ssh -R tunnel, logged; launchd restarts it when it exits."""
    import signal
    import time
    c = load_config()
    argv = tunnel_ssh_argv(c, host, remote_sock)
    log({"op": "tunnel", "result": "start", "host": host, "detail": remote_sock})
    t0 = time.time()
    p = subprocess.Popen(argv, stdin=subprocess.DEVNULL)
    signal.signal(signal.SIGTERM, lambda *_: p.terminate())
    code = p.wait()
    log({"op": "tunnel", "result": "exit=%d" % code, "host": host, "detail": "after %ds" % (time.time() - t0)})
    sys.exit(1)


def cmd_tunnel(argv):
    sub = argv[0] if argv else ""
    c = load_config()
    if sub == "install":
        return tunnel_install(c)
    if sub == "uninstall":
        return tunnel_uninstall(c)
    if sub == "status":
        return tunnel_status(c, "--probe" in argv)
    if sub == "run" and len(argv) == 3 and HOST_RE.match(argv[1]) and argv[2].startswith("/"):
        return tunnel_run(argv[1], argv[2])
    die("usage: bws-touchid tunnel install | status [--probe] | uninstall", 2)


def main():
    prog = os.path.basename(sys.argv[0])
    argv = sys.argv[1:]
    if prog == "bws-save":
        return cmd_save(argv)
    if prog == "bws-gated":
        return cmd_gated(argv)
    cmds = {"init": cmd_init, "store": cmd_store, "status": cmd_status, "delete": cmd_delete,
            "run": cmd_run, "serve": cmd_serve, "reap": cmd_reap, "save": cmd_save, "gated": cmd_gated,
            "ping": cmd_ping, "tunnel": cmd_tunnel, "approver": cmd_approver, "iphone-setup": cmd_iphone_setup}
    if not argv or argv[0] not in cmds:
        print(__doc__.strip())
        sys.exit(0 if argv and argv[0] in ("-h", "--help") else 2)
    return cmds[argv[0]](argv[1:])


if __name__ == "__main__":
    main()
