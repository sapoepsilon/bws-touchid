PROVIDERS = {"bitwarden": BitwardenProvider()}                     # shipped
PROVIDER_SKELETONS = {"1password": OnePasswordProvider(), "keychain": KeychainProvider()}  # not enabled


def provider_of(c):
    """(provider, None) or (None, why). Unknown and skeleton providers fail closed."""
    name = c.get("provider") or "bitwarden"
    p = PROVIDERS.get(name) if isinstance(name, str) else None
    if p is not None and p.enabled:
        return p, None
    if isinstance(name, str) and name in PROVIDER_SKELETONS:
        return None, "provider '%s' is not enabled in this version" % name
    return None, "unknown provider %r" % clean(name, 30)


# ---------------------------------------------------------------- requests

class Job(object):
    """A validated gated op that still needs its approval. run() = gate + provider call (+ audit line);
    it must hold GATE_LOCK. approved is set once the gate let it through."""

    def __init__(self, op, rec, run, reject):
        self.op, self.rec, self._run, self.reject = op, rec, run, reject
        self.approved = False

    def run(self):
        return self._run(self)


GATE_LOCK = threading.Lock()   # one approval in flight: one Touch ID sheet / one phone request at a time


def prepare(req, peer_pid):
    """Validate a request. Returns a response dict (ping, rejects, dry runs) or a Job for save / bws."""
    c = load_config()
    op = req.get("op", "")
    host = claimed(req.get("host"), 48)
    caller = claimed(req.get("caller"), 60)
    peer_args = ps_field(peer_pid, "args").split()
    named_ssh = bool(peer_args) and os.path.basename(peer_args[0]) == "ssh"
    # argv[0] is whatever the peer chose; only the real /usr/bin/ssh binary counts as a tunnel (audit L6)
    if named_ssh and exe_path(peer_pid) == SSH_EXE:
        via = "ssh session to " + claimed(ssh_destination(peer_args), 40)
        who = "%s (%s)" % (host or "remote", caller or "?")
        named_ssh = False
    else:
        via = "local: " + clean(proc_chain(ps_field(peer_pid, "ppid") or peer_pid), 70)
        who = caller or "local process"
    rec = {"op": op, "host": host, "caller": caller, "via": via}
    if named_ssh:
        rec["notes"] = ["peer-claims-ssh:" + clean(os.path.basename(exe_path(peer_pid)) or "?", 40)]
    dry = bool(req.get("dryrun"))

    def reject(msg):
        rec.update(result="rejected", detail=msg)
        log(rec)
        return {"ok": False, "error": msg}

    if op == "ping":
        return {"ok": True, "broker": "bws-touchid", "broker_name": c["broker_name"]}

    if op in ("save", "bws"):
        provider, why = provider_of(c)
        if provider is None:
            return reject(why)
        prefer = prefer_device_of(req, c)

    if op == "save":
        key = req.get("key") or ""
        project = req.get("project") or (c["save_projects"][0] if c["save_projects"] else "")
        note = req.get("note") or ""
        value = req.get("value")
        tname = provider.write_token(c)
        rec.update(key=key, project=project, token=tname)
        if not KEY_RE.match(key):
            return reject("key must match ^[A-Z0-9_]+$ (max 128)")
        if denied_key(key, c):
            return reject("that key prefix is owner-only")
        if not project or denied_project(project, c) or project not in c["save_projects"]:
            return reject("project '%s' is not in save_projects %s" % (clean(project, 40), c["save_projects"]))
        if not isinstance(value, str) or not value:
            return reject("empty value")
        if len(value.encode()) > MAX_VALUE:
            return reject("value larger than %d bytes" % MAX_VALUE)
        if not isinstance(note, str) or len(note) > 1000:
            return reject("note longer than 1000 chars")
        if approvers_of(c) is None:
            return reject("bad approvers config")
        if dry:
            rec.update(result="DRYRUN-ok")
            log(rec)
            return {"ok": True, "id": "dryrun", "action": "dry-run"}

        def run_save(job):
            token, fail = approve_gate(c, rec, tname, "Touch ID: save %s" % key,
                                       "%s → %s [%s]" % (who, project, via),
                                       dict(op="save", key=key, summary="save %s → %s" % (key, project),
                                            project=project, token=tname, host=host, caller=caller, via=via),
                                       prefer)
            if fail:
                rec.update(result=fail[0], detail=fail[1])
                log(rec)
                return {"ok": False, "error": fail[2]}
            job.approved = True
            result, detail, resp = provider.save(key, value, note, project, token, c)
            del token
            rec.update(result=result, detail=detail)
            log(rec)
            return resp
        return Job("save", rec, run_save, reject)

    if op == "bws":
        raw = req.get("args")
        tname = provider.read_token(c, req.get("token"))
        rec["token"] = tname
        if not NAME_RE.match(str(tname)):
            return reject("bad token name")
        if tname not in c["read_tokens"]:  # a read may not pick the write token on its own (audit M5)
            return reject("token '%s' is not allowed for reads (config read_tokens: %s)"
                          % (tname, ", ".join(c["read_tokens"])))
        rop = provider.parse_read(raw, c) \
            if isinstance(raw, list) and all(isinstance(a, str) for a in raw) else None
        if not rop:
            return reject("refused: only read-only bws calls (project list/get, secret list/get, -o json)")
        summary = rop["summary"]
        rec["detail"] = summary
        if approvers_of(c) is None:
            return reject("bad approvers config")
        if dry:
            rec.update(result="DRYRUN-ok")
            log(rec)
            return {"ok": True, "exit": 0, "stdout_b64": base64.b64encode(b"[]").decode()}

        title = "Touch ID: %s" % summary + ("" if tname == c["read_token"] else " (token %s)" % tname)

        def run_read(job):
            token, fail = approve_gate(c, rec, tname, title, "%s [%s]" % (who, via),
                                       dict(op="bws", key="", summary=summary, project=rop["project"],
                                            token=tname, host=host, caller=caller, via=via),
                                       prefer)
            if fail:
                rec.update(result=fail[0], detail=fail[1] or summary)
                log(rec)
                return {"ok": False, "error": fail[2]}
            job.approved = True
            if c["denied_unresolved"]:
                # A denied project NAME without an id in project_names: look the ids up with this token
                # before reading, and return only secrets of visible, allowed projects (fail closed).
                allowed, why = provider.resolve_projects(rop, token, c)
                if allowed is None or (rop.get("project_id") and rop["project_id"] not in allowed):
                    del token
                    msg = ("refused: could not resolve denied project names to ids (%s); nothing was read" % why
                           if allowed is None else "refused: that project is denied or not visible to the token")
                    rec.update(result="rejected", detail=msg)
                    log(rec)
                    return {"ok": False, "error": msg}
                c["allowed_project_ids"] = allowed
            code, out, err = provider.read(rop, token, c)
            del token
            rec["result"] = "exit=%d" % code
            log(rec)
            return {"ok": code == 0, "exit": code, "stdout_b64": base64.b64encode(provider.scrub(out, c)).decode(),
                    "stderr": err, "error": "" if code == 0 else "bws exited %d" % code}
        return Job("bws", rec, run_read, reject)

    return reject("unknown op")


def handle(req, peer_pid):
    """Synchronous request: validate, wait for the approval slot, run. Returns the response dict."""
    job = prepare(req, peer_pid)
    if not isinstance(job, Job):
        return job
    if not GATE_LOCK.acquire(timeout=GATE_QUEUE_S):
        return job.reject("broker busy: another approval is pending; retry, or use --async")
    try:
        return job.run()
    finally:
        GATE_LOCK.release()


# ---------------------------------------------------------------- async tickets
#
# A caller that cannot wait for an approval (MCP tools are killed at 60 s) sends "async": true and gets
# {"ticket"} at once; the job runs in the background, one approval at a time like every other request.
# ticket.get returns pending | approved (with the result) | denied | expired. Results live in this
# process's memory only (never on disk, never logged), are handed out once, and are dropped
# TICKET_TTL_S after the job finished. A ticket only answers a ticket.get that carries its ticket_key
# (a random secret returned once, to the creator only; the broker keeps a hash) AND the same uid + host +
# caller; anything else - unknown, used, expired, someone else's - gets the same "expired" answer.
# One host + caller may have MAX_PENDING_PER_CALLER tickets pending, and once the owner denies (or lets
# time out) one of its requests, the ones it queued before that are dropped without another prompt.

class Tickets(object):
    def __init__(self):
        self.lock = threading.Lock()
        self.items = {}
        self.refused_at = {}    # (uid, host, caller) -> time of the last owner deny / timeout

    def _purge(self, now):
        for tid in [t for t, e in self.items.items() if e["done_at"] and now - e["done_at"] > TICKET_TTL_S]:
            e = self.items.pop(tid)
            e["result"] = None

    def create(self, uid, host, caller, op):
        """(ticket id, ticket key, None) or (None, None, why)."""
        with self.lock:
            self._purge(time.time())
            if len(self.items) >= MAX_TICKETS:
                return None, None, "too many outstanding tickets (%d); collect or let them expire" % MAX_TICKETS
            mine = [e for e in self.items.values()
                    if e["status"] == "pending" and (e["uid"], e["host"], e["caller"]) == (uid, host, caller)]
            if len(mine) >= MAX_PENDING_PER_CALLER:
                return None, None, "too many pending requests from this host/caller (%d)" % MAX_PENDING_PER_CALLER
            tid = b32id("tkt")
            key = base64.urlsafe_b64encode(os.urandom(24)).decode().rstrip("=")
            self.items[tid] = {"uid": uid, "host": host, "caller": caller, "op": op, "status": "pending",
                               "key_hash": hashlib.sha256(key.encode()).digest(),
                               "created": time.time(), "done_at": None, "result": None,
                               "event": threading.Event()}
            return tid, key, None

    def note_refused(self, tid):
        with self.lock:
            e = self.items.get(tid)
            if e is not None:
                self.refused_at[(e["uid"], e["host"], e["caller"])] = time.time()

    def refused_since_created(self, tid):
        with self.lock:
            e = self.items.get(tid)
            if e is None:
                return False
            return self.refused_at.get((e["uid"], e["host"], e["caller"]), 0) >= e["created"]

    def finish(self, tid, status, result):
        with self.lock:
            e = self.items.get(tid)
            if e is None:
                return
            e.update(status=status, result=result, done_at=time.time())
            e["event"].set()

    def get(self, tid, key, uid, host, caller, wait=0):
        gone = {"ok": False, "status": "expired",
                "error": "no such ticket (expired, already collected, or not yours)"}
        if not isinstance(tid, str) or not TICKET_RE.match(tid) or not isinstance(key, str) or len(key) > 128:
            return gone
        digest = hashlib.sha256(key.encode()).digest()
        with self.lock:
            self._purge(time.time())
            e = self.items.get(tid)
            if e is None or not hmac.compare_digest(e["key_hash"], digest) \
                    or (e["uid"], e["host"], e["caller"]) != (uid, host, caller):
                return gone
            ev = e["event"]
        if e["status"] == "pending" and wait > 0:
            ev.wait(min(wait, TICKET_WAIT_MAX_S))
        with self.lock:
            if self.items.get(tid) is not e:
                return gone  # collected by a concurrent ticket.get
            if e["status"] == "pending":
                return {"ok": True, "status": "pending", "ticket": tid}
            del self.items[tid]
            result, e["result"] = e["result"], None
        if e["status"] == "approved":
            return {"ok": True, "status": "approved", "op": e["op"], "result": result}
        return {"ok": False, "status": "denied", "op": e["op"], "error": (result or {}).get("error") or "denied"}

    def sweep(self):
        with self.lock:
            self._purge(time.time())


TICKETS = Tickets()


def _ticket_worker(job, tid):
    try:
        with GATE_LOCK:
            if TICKETS.refused_since_created(tid):  # the owner already said no to this caller: no new prompt
                resp = job.reject("dropped: the owner denied an earlier request from this host/caller")
            else:
                resp = job.run()
                if job.rec.get("result") in ("denied", "timeout", "auth-failed"):  # Touch ID cancel = auth-failed
                    TICKETS.note_refused(tid)
    except Exception as e:  # noqa: BLE001
        log({"op": job.op, "result": "error", "detail": "async " + type(e).__name__})
        resp = {"ok": False, "error": "broker error"}
    TICKETS.finish(tid, "approved" if job.approved else "denied", resp)


def start_async(job, uid):
    tid, key, why = TICKETS.create(uid, job.rec.get("host", ""), job.rec.get("caller", ""), job.op)
    if tid is None:
        return job.reject(why)
    threading.Thread(target=_ticket_worker, args=(job, tid), name="ticket", daemon=True).start()
    return {"ok": True, "status": "pending", "ticket": tid, "ticket_key": key, "ttl_s": TICKET_TTL_S}


def dispatch(req, peer_pid, peer_uid):
    """Everything the broker socket accepts: ping, save, bws (sync or "async": true), ticket.get."""
    op = req.get("op", "")
    if op == "ticket.get":
        try:
            wait = max(0.0, min(float(req.get("wait") or 0), TICKET_WAIT_MAX_S))
        except (TypeError, ValueError):
            wait = 0.0
        return TICKETS.get(req.get("ticket"), req.get("ticket_key"), peer_uid, claimed(req.get("host"), 48),
                           claimed(req.get("caller"), 60), wait)
    if req.get("async") is True and op in ("save", "bws"):
        job = prepare(req, peer_pid)
        return start_async(job, peer_uid) if isinstance(job, Job) else job
    return handle(req, peer_pid)


def read_line(conn, limit):
    buf = b""
    while len(buf) <= limit:
        chunk = conn.recv(65536)
        if not chunk:
            return buf or None
        nl = chunk.find(b"\n")
        if nl >= 0:
            return buf + chunk[:nl]
        buf += chunk
    return None


def serve_conn(conn, slots):
    try:
        cred = conn.getsockopt(SOL_LOCAL, LOCAL_PEERCRED, 76)
        peer_uid = struct.unpack_from("Ii", cred)[1]
        peer_pid = struct.unpack("i", conn.getsockopt(SOL_LOCAL, LOCAL_PEERPID, 4))[0]
        if peer_uid != os.getuid():
            resp = {"ok": False, "error": "peer uid mismatch"}
        else:
            conn.settimeout(15)
            line = read_line(conn, MAX_LINE)
            try:
                req = json.loads(line) if line else None
            except ValueError:
                req = None
            if not isinstance(req, dict):
                resp = {"ok": False, "error": "bad request (one JSON line)"}
            else:
                conn.settimeout(BROKER_CONN_S)
                resp = dispatch(req, peer_pid, peer_uid)
                req.clear()
        conn.sendall(json.dumps(resp).encode() + b"\n")
    except (OSError, socket.timeout):
        pass  # status probes and clients that gave up
    except Exception as e:  # noqa: BLE001
        log({"op": "serve", "result": "error", "detail": type(e).__name__})
    finally:
        conn.close()
        slots.release()


def cmd_serve(_argv):
    os.umask(0o077)
    os.makedirs(SOCK_DIR, exist_ok=True)
    os.chmod(SOCK_DIR, 0o700)
    try:
        os.unlink(LOCAL_SOCK)
    except FileNotFoundError:
        pass
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(LOCAL_SOCK)
    os.chmod(LOCAL_SOCK, 0o600)
    srv.listen(16)
    log({"op": "serve", "result": "listening", "detail": LOCAL_SOCK})

    def sweeper():
        while True:
            time.sleep(30)
            TICKETS.sweep()
    threading.Thread(target=sweeper, name="ticket-sweeper", daemon=True).start()
    slots = threading.BoundedSemaphore(MAX_CONNS)
    # One thread per connection so ping and ticket.get answer while an approval is pending; approvals
    # themselves stay serial (GATE_LOCK): one Touch ID prompt at a time.
    while True:
        conn, _ = srv.accept()
        if not slots.acquire(blocking=False):
            conn.close()
            continue
        threading.Thread(target=serve_conn, args=(conn, slots), name="conn", daemon=True).start()


# ---------------------------------------------------------------- client

def not_connected(c, tried):
    return ("%s broker unreachable (tried %s).\n"
            "Bitwarden SM access needs the owner's Touch ID on that Mac. It reaches this host through\n"
            "~/.bws-broker/fwd.sock (a persistent tunnel or an ssh session opened FROM that Mac); the Mac\n"
            "may be asleep, off the network, or its tunnel down. Ask the owner, or ask him to store the\n"
            "value himself. Nothing was sent." % (c["broker_name"], ", ".join(tried) or "nothing"))


def socket_order(c):
    """Sockets a client tries, in order. BWS_BROKER_SOCK first; inside an ssh session the broker of
    the Mac that opened it (forwarded socket) wins, otherwise this Mac's own broker. local_broker=false
    drops this Mac's broker entirely."""
    order = [FWD_SOCK, LOCAL_SOCK] if os.environ.get("SSH_CONNECTION") else [LOCAL_SOCK, FWD_SOCK]
    if not c.get("local_broker", True):
        order.remove(LOCAL_SOCK)
    env = os.environ.get("BWS_BROKER_SOCK")
    return ([env] if env else []) + [p for p in order if p != env]


def connect_first(paths):
    for p in paths:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            s.connect(p)
            return s
        except OSError:
            s.close()
    return None


def broker_call(req, timeout=None):
    c = load_config()
    order = socket_order(c)
    s = connect_first(order)
    if s is None:
        die(not_connected(c, [p.replace(HOME, "~") for p in order]), 3)
    try:
        s.settimeout(timeout or CLIENT_TIMEOUT_S)
        s.sendall(json.dumps(req).encode() + b"\n")
        line = read_line(s, MAX_STDOUT * 2)
    except OSError as e:
        die("broker connection failed: %s" % e, 4)
    finally:
        s.close()
    try:
        return json.loads(line)
    except (TypeError, ValueError):
        die("no answer from the broker (timed out or died)", 4)


def my_caller():
    return clean(os.environ.get("BWS_TOUCHID_CALLER") or proc_chain(os.getppid(), 2), 60)


def read_value(prompt):
    if sys.stdin.isatty():
        return getpass.getpass(prompt)
    data = sys.stdin.buffer.read(MAX_VALUE + 3)
    if len(data) > MAX_VALUE + 2:
        die("value larger than %d bytes" % MAX_VALUE)
    if data.endswith(b"\n"):
        data = data[:-1]
    if data.endswith(b"\r"):
        data = data[:-1]
    try:
        return data.decode("utf-8")
    except UnicodeDecodeError:
        die("value is not UTF-8")


def cmd_save(argv):
    project = note = key = ""
    dry = False
    asyn = os.environ.get("BWS_TOUCHID_ASYNC") == "1"
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--async":
            asyn, i = True, i + 1
        elif a in ("--project", "--note") and i + 1 < len(argv):
            if a == "--project":
                project = argv[i + 1]
            else:
                note = argv[i + 1]
            i += 2
        elif a == "--dry-run":
            dry, i = True, i + 1
        elif a in ("-h", "--help"):
            print('usage: printf %s "$VALUE" | bws-save [--async] [--project NAME] [--note TEXT] [--dry-run] KEY')
            sys.exit(0)
        elif a.startswith("-"):
            die("unknown option " + a, 2)
        elif key:
            die("only one KEY; the value goes on stdin, never argv", 2)
        else:
            key, i = a, i + 1
    if not KEY_RE.match(key):
        die("KEY must match ^[A-Z0-9_]+$", 2)
    value = read_value("Value for %s (hidden): " % key)
    if not value:
        die("empty value on stdin", 2)
    req = {"op": "save", "key": key, "value": value, "host": socket.gethostname().split(".")[0],
           "caller": my_caller(), "dryrun": dry}
    if project:
        req["project"] = project
    if note:
        req["note"] = note
    if asyn:
        req["async"] = True
        return print_ticket("bws-save", broker_call(req))
    eprint("bws-save: waiting for the owner's Touch ID on %s…" % load_config()["broker_name"])
    r = broker_call(req)
    if r.get("ok"):
        print("ok %s %s id=%s" % (r.get("action", "saved"), key, r.get("id", "")))
        sys.exit(0)
    die("refused: " + str(r.get("error")), 5)


TICKET_KEY_DIR = os.path.join(SOCK_DIR, "tickets")


def ticket_key_path(tid):
    """Where this host keeps a ticket's key (0600, never argv or stdout); named by a hash of the id."""
    return os.path.join(TICKET_KEY_DIR, hashlib.sha256(tid.encode()).hexdigest()[:32])


def save_ticket_key(tid, key):
    os.makedirs(SOCK_DIR, mode=0o700, exist_ok=True)
    write_private(ticket_key_path(tid), key)
    now = time.time()
    for f in os.listdir(TICKET_KEY_DIR):  # keys of tickets nobody collected: the broker forgot them long ago
        path = os.path.join(TICKET_KEY_DIR, f)
        try:
            if now - os.lstat(path).st_mtime > 86400:
                os.remove(path)
        except OSError:
            pass


def load_ticket_key(tid):
    if os.environ.get("BWS_TOUCHID_TICKET_KEY"):
        return os.environ["BWS_TOUCHID_TICKET_KEY"]
    path = ticket_key_path(tid)
    if not private_file_ok(path):
        return ""
    try:
        with open(path) as f:
            return f.read(256).strip()
    except OSError:
        return ""


def drop_ticket_key(tid):
    try:
        os.remove(ticket_key_path(tid))
    except OSError:
        pass


def print_ticket(prog, r):
    """An --async answer: {"ticket": ...} on stdout (exit 0), or the refusal (exit 5). The ticket key is
    kept in ~/.bws-broker/tickets/ for `ticket wait|get`; it never goes to stdout or argv."""
    if r.get("ok") and r.get("ticket"):
        if r.get("ticket_key"):
            save_ticket_key(r["ticket"], r["ticket_key"])
        print(json.dumps({"ticket": r["ticket"]}))
        eprint("%s: queued for approval; collect with: bws-touchid ticket wait %s" % (prog, r["ticket"]))
        sys.exit(0)
    if r.get("ok"):  # a dry run answers at once
        print(json.dumps(r))
        sys.exit(0)
    die("refused: " + str(r.get("error")), 5)


def print_gated(r):
    out = base64.b64decode(r.get("stdout_b64") or "")
    sys.stdout.buffer.write(out)
    sys.stdout.flush()
    if r.get("stderr"):
        eprint(r["stderr"])
    if not r.get("ok"):
        eprint("bws-gated: " + str(r.get("error") or "failed"))
        sys.exit(r.get("exit") or 5)
    sys.exit(0)


def cmd_gated(argv):
    asyn = os.environ.get("BWS_TOUCHID_ASYNC") == "1"
    while argv[:1] == ["--async"]:
        asyn, argv = True, argv[1:]
    req = {"op": "bws", "args": argv, "host": socket.gethostname().split(".")[0], "caller": my_caller(),
           "dryrun": os.environ.get("BWS_BROKER_DRYRUN") == "1"}
    if os.environ.get("BWS_TOUCHID_TOKEN"):
        req["token"] = os.environ["BWS_TOUCHID_TOKEN"]
    if asyn:
        req["async"] = True
        return print_ticket("bws-gated", broker_call(req))
    print_gated(broker_call(req))


def cmd_ticket(argv):
    """ticket wait TICKET [--timeout S]: long-poll until decided (default 50 s, fits a 60 s MCP call);
    ticket get TICKET: one look. Exit 0 approved (output as bws-gated / bws-save would print it),
    5 denied, 6 expired / unknown / not yours, 75 still pending."""
    usage = "usage: bws-touchid ticket wait|get TICKET [--timeout SECONDS]"
    if len(argv) < 2 or argv[0] not in ("wait", "get"):
        die(usage, 2)
    timeout = 50.0 if argv[0] == "wait" else 0.0
    if "--timeout" in argv:
        try:
            timeout = float(argv[argv.index("--timeout") + 1])
        except (IndexError, ValueError):
            die(usage, 2)
    tid = argv[1]
    if not TICKET_RE.match(tid):
        die("not a ticket id (tkt_…)", 2)
    host, caller = socket.gethostname().split(".")[0], my_caller()
    key = load_ticket_key(tid)
    end = time.time() + max(0.0, timeout)
    while True:
        left = max(0.0, min(end - time.time(), TICKET_WAIT_MAX_S))
        r = broker_call({"op": "ticket.get", "ticket": tid, "ticket_key": key, "host": host, "caller": caller,
                         "wait": left}, timeout=left + 30)
        st = r.get("status")
        if st == "pending" and time.time() < end:
            continue
        break
    if st in ("approved", "denied"):
        drop_ticket_key(tid)
    if st == "pending":
        eprint("bws-touchid: %s still pending (owner has not answered yet); run ticket wait again" % tid)
        sys.exit(75)
    if st == "approved":
        res = r.get("result") or {}
        if r.get("op") == "save":
            if res.get("ok"):
                print("ok %s id=%s" % (res.get("action", "saved"), res.get("id", "")))
                sys.exit(0)
            die("refused: " + str(res.get("error")), 5)
        return print_gated(res)
    if st == "denied":
        die("refused: " + str(r.get("error")), 5)
    die(str(r.get("error") or "ticket expired"), 6)


