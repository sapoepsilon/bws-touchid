# ---------------------------------------------------------------- helpers

def eprint(*a):
    print(*a, file=sys.stderr)


def die(msg, code=1):
    eprint("bws-touchid: " + msg)
    sys.exit(code)


def clean(s, n=80):
    s = "".join(ch for ch in str(s or "") if ch.isprintable())
    return s if len(s) <= n else s[:n] + "…"


def claimed(s, n):
    """A client-asserted label (host, caller): printable ASCII only, so look-alike letters, bidi and
    zero-width characters never reach a prompt, the canonical or the log."""
    return "".join(ch if " " <= ch < "\x7f" or ch == "…" else "?" for ch in clean(s, n))


def load_config():
    c = json.loads(json.dumps(DEFAULTS))
    try:
        with open(CONFIG_PATH) as f:
            user = json.load(f)
        if isinstance(user, dict):
            c.update({k: v for k, v in user.items() if not k.startswith("_")})
    except FileNotFoundError:
        pass
    except Exception as e:  # noqa: BLE001
        eprint("bws-touchid: ignoring unreadable config %s: %s" % (CONFIG_PATH, e))
    c["denied_projects"] = [str(x).lower() for x in c.get("denied_projects") or []]
    names = {str(k).lower(): str(v) for k, v in (c.get("project_names") or {}).items()}
    c["project_names"] = names
    for pid, nm in names.items():  # denying a name also denies its id
        if nm.lower() in c["denied_projects"]:
            c["denied_projects"].append(pid)
    # Denied NAMES with no id in project_names: bws output only carries projectId, so these are resolved
    # to ids with a live `project list` before any read result is returned (fail closed).
    mapped = {v.lower() for v in names.values()}
    c["denied_unresolved"] = sorted(set(n for n in c["denied_projects"] if not UUID_RE.match(n) and n not in mapped))
    c["save_projects"] = [p for p in c.get("save_projects") or [] if p.lower() not in c["denied_projects"]]
    rt = c.get("read_tokens")
    rt = [x for x in rt if isinstance(x, str)] if isinstance(rt, list) else []
    c["read_tokens"] = list(dict.fromkeys([str(c["read_token"])] + rt))
    return c


def denied_project(x, c):
    return str(x or "").lower() in c["denied_projects"]


def denied_key(k, c):
    """Key prefixes are matched case-insensitively (Bitwarden keys are free-form: Mail_x, mail_x)."""
    k = str(k or "").upper()
    return any(p and k.startswith(str(p).upper()) for p in c.get("denied_key_prefixes") or [])


def log(fields):
    fields = dict(fields)
    fields["ts"] = datetime.datetime.now().astimezone().isoformat(timespec="seconds")
    notes = fields.pop("notes", None)
    if notes:
        fields["detail"] = " ".join(([fields["detail"]] if fields.get("detail") else []) + list(notes))
    order = ["ts", "op", "result", "key", "project", "token", "host", "caller", "via", "approver",
             "request_id", "detail"]
    line = " ".join("%s=%s" % (k, clean(fields[k], 200)) for k in order if fields.get(k)) + "\n"
    os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
    fd = os.open(LOG_PATH, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    with os.fdopen(fd, "a") as f:
        f.write(line)


def find_tool(name, configured):
    if configured:
        return configured
    path = os.pathsep.join([os.environ.get("PATH", "")] + EXTRA_PATH)
    return shutil.which(name, path=path)


def tool_env():
    return {"PATH": os.pathsep.join(EXTRA_PATH + ["/usr/bin", "/bin"]), "HOME": HOME}


def notify(title, msg, c):
    if not c.get("notify", True):
        return
    script = ["-e", "on run argv", "-e", "display notification (item 2 of argv) with title (item 1 of argv)",
              "-e", "end run", clean(title, 60), clean(msg, 200)]
    try:
        subprocess.run(["/usr/bin/osascript"] + script, timeout=5,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:  # noqa: BLE001
        pass


def token_path(name):
    if not NAME_RE.match(name or ""):
        raise ValueError("bad token name")
    return os.path.join(TOKENS_DIR, name + ".age")


def decrypt_token(name, c):
    """One Secure Enclave decrypt = one Touch ID prompt. Returns (token, error)."""
    path = token_path(name)
    if not os.path.isfile(path):
        return None, "no token named '%s' on the broker Mac (owner: bws-touchid store %s)" % (name, name)
    age = find_tool("age", c.get("age_path"))
    if not age:
        return None, "age not found (brew install age age-plugin-se)"
    try:
        r = subprocess.run([age, "-d", "-i", IDENTITY, path], capture_output=True, timeout=120, env=tool_env())
    except subprocess.TimeoutExpired:
        return None, "timed out waiting for Touch ID"
    if r.returncode != 0:
        err = r.stderr.decode("utf-8", "replace").strip().splitlines()
        return None, "Touch ID / decrypt failed: %s" % clean(err[-1] if err else "exit %d" % r.returncode, 160)
    tok = r.stdout.decode("utf-8").strip()
    if not tok:
        return None, "decrypted token is empty"
    return tok, None


def run_bws(args, token, c, timeout=None):
    """Run bws with the token in env only and an empty HOME (no user bws config can redirect it)."""
    bws = find_tool("bws", c.get("bws_path"))
    if not bws:
        return 127, b"", "bws not found on the broker Mac"
    with tempfile.TemporaryDirectory(prefix="bws-touchid-") as tmp:
        env = {"HOME": tmp, "TMPDIR": tmp + "/", "PATH": "/usr/bin:/bin", "BWS_ACCESS_TOKEN": token}
        try:
            r = subprocess.run([bws, "--color", "no"] + args, capture_output=True, timeout=timeout or BWS_TIMEOUT_S,
                               env=env, stdin=subprocess.DEVNULL)
        except subprocess.TimeoutExpired:
            return 124, b"", "bws timed out"
    err = r.stderr.decode("utf-8", "replace").replace(token, "[REDACTED]")
    if len(r.stdout) > MAX_STDOUT:
        return 1, b"", "bws output too large"
    return r.returncode, r.stdout, err[:600]


# ------------------------------------------------------------ approvers
#
# A gated op (save, bws) needs one approval before a token is decrypted. With the default
# `"approvers": ["touchid"]` that is exactly the old notify() + decrypt_token() path. With "iphone" in
# the list the broker races the Touch ID decrypt against a phone-signed approval relayed by the
# whispera-link daemon (PROTOCOL.md §8, §11.2). The broker builds and serialises the canonical request
# itself and re-verifies every phone signature with /usr/bin/openssl against a pinned key; the daemon
# is only a relay. First valid answer wins; a deny from either leg is a deny; the deadline is a deny.

def expand(p):
    p = str(p or "")
    return HOME + p[1:] if p == "~" or p.startswith("~/") else p


def approvers_of(c):
    """The configured approver list, or None when it is unusable (fail closed)."""
    a = c.get("approvers")
    if not isinstance(a, list) or not a or not all(isinstance(x, str) and x in KNOWN_APPROVERS for x in a) \
            or len(set(a)) != len(a):
        return None
    return a


def is_default_approvers(c):
    return approvers_of(c) == ["touchid"]


def phone_window(c):
    """approval_wait_s (legacy: phone_window_s), default 300, clamped PHONE_WINDOW_MIN-PHONE_WINDOW_MAX."""
    raw = c.get("approval_wait_s")
    if raw is None:
        raw = c.get("phone_window_s")
    try:
        w = APPROVAL_WAIT_DEFAULT_S if raw is None or isinstance(raw, bool) else int(raw)
    except (TypeError, ValueError):
        w = APPROVAL_WAIT_DEFAULT_S
    return max(PHONE_WINDOW_MIN, min(PHONE_WINDOW_MAX, w))


def prefer_device_of(req, c):
    """Routing hint for the daemon: which paired device to push first (the one used last). Only a hint:
    every approval is still verified against a pinned key. From the request, else the helper's file."""
    dev = req.get("prefer_device")
    if isinstance(dev, str) and DEVICE_RE.match(dev):
        return dev
    path = expand(c.get("prefer_device_file") or "")
    if not path or not safe_owned(path, False):
        return ""
    try:
        with open(path) as f:
            dev = f.read(64).strip()
    except (OSError, UnicodeDecodeError):
        return ""
    return dev if DEVICE_RE.match(dev) else ""


def iphone_identity(c):
    return expand(c.get("iphone_token_identity")) or os.path.join(CONF_DIR, "identity-iphone.txt")


def iphone_token_path(name):
    if not NAME_RE.match(name or ""):
        raise ValueError("bad token name")
    return os.path.join(TOKENS_DIR, name + ".iphone.age")


def approvers_dir(c):
    return expand(c.get("approvers_dir") or "~/.bws-broker/approvers")


def b32id(prefix):
    return prefix + "_" + base64.b32encode(os.urandom(15)).decode().lower().rstrip("=")


def canonical_bytes(obj):
    return json.dumps(obj, sort_keys=True, separators=(",", ":"), ensure_ascii=True).encode("ascii")


def build_canonical(c, op, key, summary, project, token, host, caller, via, now=None):
    created = int(time.time() if now is None else now)
    return {"v": 1, "request_id": b32id("apr"),
            "nonce": base64.urlsafe_b64encode(os.urandom(16)).decode().rstrip("="),
            "op": op, "key": key, "summary": summary, "project": project, "token": token,
            "host": host, "caller": caller, "via": via, "broker": str(c["broker_name"]),
            "created_at": created, "expires_at": created + phone_window(c)}


# --- P-256 keys and signatures (copied, not imported, from whispera_link/crypto.py; PROTOCOL.md §2.1, §4.5)

def spki_from_pem(text):
    """DER SubjectPublicKeyInfo of a P-256 public key PEM, or None."""
    m = re.search(r"-----BEGIN PUBLIC KEY-----([A-Za-z0-9+/=\s]+)-----END PUBLIC KEY-----", text or "")
    if not m:
        return None
    try:
        der = base64.b64decode("".join(m.group(1).split()), validate=True)
    except ValueError:
        return None
    if len(der) != 91 or not der.startswith(SPKI_P256_PREFIX) or der[26] != 4:
        return None
    return der


def pem_from_spki(der):
    b = base64.b64encode(der).decode()
    return "-----BEGIN PUBLIC KEY-----\n%s\n-----END PUBLIC KEY-----\n" % "\n".join(
        b[i:i + 64] for i in range(0, len(b), 64))


def fingerprint(der):
    return hashlib.sha256(der).hexdigest()


def display_fp(der):
    h = fingerprint(der)[:16]
    return "-".join(h[i:i + 4] for i in range(0, 16, 4))


def p256_verify(spki_der, message, sig_der):
    """ECDSA P-256 / SHA-256 / DER via /usr/bin/openssl. Any doubt = False."""
    if not isinstance(sig_der, bytes) or not 8 <= len(sig_der) <= 80 or not os.path.exists(OPENSSL):
        return False
    tmp = tempfile.mkdtemp(prefix="bws-touchid-v-")
    try:
        os.chmod(tmp, 0o700)
        pub, sig = os.path.join(tmp, "pub.pem"), os.path.join(tmp, "sig.der")
        with open(pub, "w") as f:
            f.write(pem_from_spki(spki_der))
        with open(sig, "wb") as f:
            f.write(sig_der)
        r = subprocess.run([OPENSSL, "dgst", "-sha256", "-verify", pub, "-signature", sig], input=message,
                           capture_output=True, timeout=5, env={"PATH": "/usr/bin:/bin"})
        return r.returncode == 0 and r.stdout.strip() == b"Verified OK"
    except (OSError, subprocess.SubprocessError):
        return False
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def safe_owned(path, want_dir):
    """Not a symlink, owned by us, not group/world-writable, right type."""
    try:
        st = os.lstat(path)
    except OSError:
        return False
    kind_ok = stat.S_ISDIR(st.st_mode) if want_dir else stat.S_ISREG(st.st_mode)
    return kind_ok and st.st_uid == os.getuid() and not st.st_mode & 0o022


def load_pin(c, device_id):
    """SPKI DER of a pinned approve key, or (None, why)."""
    if not DEVICE_RE.match(device_id or ""):
        return None, "bad device id"
    d = approvers_dir(c)
    path = os.path.join(d, device_id + ".pub")
    if not os.path.lexists(path):
        return None, "not pinned"
    if not safe_owned(d, True) or not safe_owned(path, False):
        return None, "pin file or dir is a symlink, not ours, or group/world-writable"
    try:
        with open(path) as f:
            der = spki_from_pem(f.read(4096))
    except (OSError, UnicodeDecodeError):
        der = None
    return (der, "") if der else (None, "not a P-256 public key PEM")


def pinned_devices(c):
    d = approvers_dir(c)
    try:
        names = sorted(os.listdir(d))
    except OSError:
        return []
    return [n[:-4] for n in names if n.endswith(".pub") and DEVICE_RE.match(n[:-4])]


def private_file_ok(path):
    """A regular file we own, not a symlink, no group/other bits at all (0600 or tighter)."""
    try:
        st = os.lstat(path)
    except OSError:
        return False
    return stat.S_ISREG(st.st_mode) and st.st_uid == os.getuid() and not st.st_mode & 0o077


def exe_path(pid):
    """The real executable of a process (proc_pidpath), not its self-reported argv[0]. "" if unknown."""
    try:
        import ctypes
        buf = ctypes.create_string_buffer(4096)
        n = ctypes.CDLL("/usr/lib/libproc.dylib").proc_pidpath(int(pid), buf, 4096)
        return buf.value.decode("utf-8", "replace") if n > 0 else ""
    except Exception:  # noqa: BLE001
        return ""


# --- iPhone token copies: the token sealed together with the approve keys allowed to release it

def seal_iphone_payload(token, fps):
    return IPHONE_COPY_MAGIC + json.dumps({"token": token, "approvers": sorted(set(fps))}, sort_keys=True)


def open_iphone_payload(text):
    """(token, approver fingerprints) of a decrypted iPhone copy. fps None = a pre-binding copy that holds
    the bare token (re-run `approver add` to bind it); token None = malformed."""
    if not text.startswith(IPHONE_COPY_MAGIC):
        return (text.strip() or None), None
    try:
        obj = json.loads(text[len(IPHONE_COPY_MAGIC):])
    except ValueError:
        return None, None
    tok = obj.get("token") if isinstance(obj, dict) else None
    fps = obj.get("approvers") if isinstance(obj, dict) else None
    if not isinstance(tok, str) or not tok.strip() or not isinstance(fps, list) \
            or not all(isinstance(x, str) for x in fps):
        return None, None
    return tok.strip(), [x.lower() for x in fps]


def decrypt_iphone_copy(c, name):
    """Decrypt tokens/<name>.iphone.age with the no-biometry identity (no prompt).
    Returns (token, fps, error); fps None = unbound legacy copy."""
    age = find_tool("age", c.get("age_path"))
    if not age:
        return None, None, "age not found (brew install age age-plugin-se)"
    try:
        r = subprocess.run([age, "-d", "-i", iphone_identity(c), iphone_token_path(name)],
                           capture_output=True, timeout=IPHONE_DECRYPT_S, env=tool_env(), stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        return None, None, "iPhone token decrypt timed out"
    if r.returncode != 0:
        err = r.stderr.decode("utf-8", "replace").strip().splitlines()
        return None, None, "iPhone token decrypt failed: %s" % clean(err[-1] if err else "exit %d" % r.returncode, 160)
    tok, fps = open_iphone_payload(r.stdout.decode("utf-8", "replace"))
    if not tok:
        return None, None, "decrypted iPhone token is empty or malformed"
    return tok, fps, None


def iphone_copy_names():
    try:
        files = os.listdir(TOKENS_DIR)
    except OSError:
        return []
    return sorted(f[:-len(".iphone.age")] for f in files
                  if f.endswith(".iphone.age") and NAME_RE.match(f[:-len(".iphone.age")]))


def rebind_iphone_copies(c, add=None, keep=None):
    """Re-seal every iPhone copy with its approver list changed: add one fingerprint and/or keep only
    `keep`. Decrypts with the no-biometry identity. Returns (names rebound, errors)."""
    age = find_tool("age", c.get("age_path"))
    done, errors = [], []
    if not age or not os.path.exists(RECIPIENT_IPHONE):
        return done, ["no iPhone identity (bws-touchid iphone-setup)"] if iphone_copy_names() else []
    for name in iphone_copy_names():
        tok, fps, err = decrypt_iphone_copy(c, name)
        if err:
            errors.append("%s: %s" % (name, err))
            continue
        fps = set(fps or [])
        if keep is not None:
            fps &= set(keep)
        if add:
            fps.add(add)
        err = encrypt_to(age, RECIPIENT_IPHONE, seal_iphone_payload(tok, fps), iphone_token_path(name))
        del tok
        (errors.append("%s: age encrypt failed: %s" % (name, err)) if err else done.append(name))
    return done, errors


def bound_fps(c):
    """Union of the approver fingerprints sealed in the existing iPhone copies (for new copies)."""
    out = set()
    for name in iphone_copy_names():
        _tok, fps, err = decrypt_iphone_copy(c, name)
        if not err:
            out |= set(fps or [])
    return out


# --- the legs

class Leg(object):
    """One approver in the race. poll() returns None while undecided, else a decision dict:
    {"kind": "approve"|"deny"|"unavailable", "approver": str, "why": str, ...}. A leg that returned a
    decision is no longer live. cancel(reason) stops it (kills the prompt / tells the daemon)."""
    name = "?"
    live = False

    def fileno_or_none(self):
        return None

    def poll(self, now):
        raise NotImplementedError

    def cancel(self, reason):
        pass

    def token(self):
        """After an approve: (token, None) or (None, error)."""
        raise NotImplementedError


class TouchIdLeg(Leg):
    name = "touchid"

    def __init__(self, c, tname, deadline):
        self.c, self.tname, self.deadline = c, tname, deadline
        self.proc, self._tok, self.error = None, None, ""

    def start(self):
        path = token_path(self.tname)
        if not os.path.isfile(path):
            self.error = "no token named '%s' on the broker Mac (owner: bws-touchid store %s)" % (self.tname, self.tname)
            return False
        age = find_tool("age", self.c.get("age_path"))
        if not age:
            self.error = "age not found (brew install age age-plugin-se)"
            return False
        self.proc = subprocess.Popen([age, "-d", "-i", IDENTITY, path], stdin=subprocess.DEVNULL,
                                     stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=tool_env(),
                                     start_new_session=True)
        self.live = True
        return True

    def poll(self, now):
        if not self.live:
            return None
        if self.proc.poll() is None:
            if now >= self.deadline:
                self.cancel("timeout")
                self.error = "timed out waiting for Touch ID"
                return {"kind": "unavailable", "approver": "touchid", "why": "timeout"}
            return None
        out, err = self.proc.communicate()
        self.live = False
        if self.proc.returncode == 0:
            tok = out.decode("utf-8", "replace").strip()
            if tok:
                self._tok = tok
                return {"kind": "approve", "approver": "touchid", "why": ""}
            self.error = "decrypted token is empty"
            return {"kind": "unavailable", "approver": "touchid", "why": "empty"}
        lines = err.decode("utf-8", "replace").strip().splitlines()
        self.error = "Touch ID / decrypt failed: %s" % clean(lines[-1] if lines else "exit %d" % self.proc.returncode, 160)
        if "cancel" in err.decode("utf-8", "replace").lower():
            return {"kind": "deny", "approver": "touchid", "why": "cancel"}
        return {"kind": "unavailable", "approver": "touchid", "why": "error"}

    def cancel(self, reason):
        if self.proc is None or self.proc.poll() is not None:
            self.live = False
            return
        for sig, wait in ((signal.SIGTERM, KILL_GRACE_S), (signal.SIGKILL, 5)):
            try:
                os.killpg(self.proc.pid, sig)
            except OSError:
                pass
            try:
                self.proc.wait(wait)
                break
            except subprocess.TimeoutExpired:
                continue
        try:
            self.proc.communicate(timeout=1)
        except (subprocess.SubprocessError, ValueError, OSError):
            pass
        self.live = False

    def token(self):
        return (self._tok, None) if self._tok else (None, self.error or "no token")


class IphoneLeg(Leg):
    """Client of ~/.whispera-link/approvals.sock: one connection per approval (PROTOCOL.md §8)."""
    name = "iphone"

    def __init__(self, c, canon, tname, prefer_device=""):
        self.c, self.canon, self.tname = c, canon, tname
        self.prefer_device = prefer_device or None
        self.raw = canonical_bytes(canon)
        self.rid = canon["request_id"]
        self.sock, self.buf, self.why, self.device = None, b"", "", ""
        self.devices = 0
        self._tok, self.error = None, ""

    def start(self):
        """Connect + request + ack. False (with self.why) = leg unavailable, never a deny."""
        if not os.path.isfile(iphone_identity(self.c)):
            self.why = "no-iphone-identity"
        elif not os.path.isfile(iphone_token_path(self.tname)):
            self.why = "no-iphone-token-copy"
        elif not private_file_ok(iphone_identity(self.c)) or not private_file_ok(iphone_token_path(self.tname)):
            self.why = "unsafe-file-mode"   # identity / copy must be ours, not a symlink, 0600
        elif not any(load_pin(self.c, d)[0] for d in pinned_devices(self.c)):
            self.why = "no-pinned-device"
        if self.why:
            return False
        path = expand(self.c.get("approvals_socket") or "~/.whispera-link/approvals.sock")
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            s.settimeout(PHONE_CONNECT_S)
            s.connect(path)
        except (OSError, socket.timeout) as e:
            s.close()
            self.why = "daemon-unreachable(%s)" % type(e).__name__
            return False
        self.sock = s
        try:  # the daemon must run as us (it is only a relay, but do not even talk to another uid)
            peer_uid = struct.unpack_from("Ii", s.getsockopt(SOL_LOCAL, LOCAL_PEERCRED, 76))[1]
        except OSError:
            peer_uid = -1
        if peer_uid != os.getuid():
            self._close()
            self.why = "daemon-uid-mismatch"
            return False
        allowed = self.c.get("approvals_peer_paths") or []
        if allowed:  # optional: only these executables may serve the approvals socket
            try:
                peer_pid = struct.unpack("i", s.getsockopt(SOL_LOCAL, LOCAL_PEERPID, 4))[0]
            except OSError:
                peer_pid = -1
            exe = exe_path(peer_pid) if peer_pid > 0 else ""
            if not isinstance(allowed, list) or exe not in allowed:
                self._close()
                self.why = "daemon-not-allowed(%s)" % clean(os.path.basename(exe) or "?", 40)
                return False
        try:
            req = {"op": "approval.request", "v": 1, "request_id": self.rid,
                   "canonical_b64": base64.b64encode(self.raw).decode(), "expires_at": self.canon["expires_at"],
                   "prefer_device": self.prefer_device}
            s.sendall(json.dumps(req).encode() + b"\n")
            end = time.time() + PHONE_ACK_S
            line = None
            while line is None:
                left = end - time.time()
                if left <= 0:
                    raise socket.timeout()
                s.settimeout(left)
                line = self._next_line(s.recv(4096) or None)
            msg = json.loads(line)
        except socket.timeout:
            self._close()
            self.why = "no-ack"
            return False
        except (OSError, ValueError, EOFError):
            self._close()
            self.why = "bad-ack"
            return False
        if not isinstance(msg, dict) or msg.get("request_id") != self.rid:
            self._close()
            self.why = "bad-ack"
            return False
        if msg.get("op") == "approval.error":
            self._close()
            self.why = "daemon-error(%s)" % clean(msg.get("code"), 30)
            return False
        n = msg.get("devices")
        if msg.get("op") != "approval.ack" or not isinstance(n, int) or isinstance(n, bool) or n < 1:
            self._close()
            self.why = "no-devices" if msg.get("op") == "approval.ack" else "bad-ack"
            return False
        self.devices = n
        s.setblocking(False)
        self.live = True
        return True

    def _next_line(self, chunk):
        """Feed bytes; return one complete line or None. EOF (chunk None) raises EOFError."""
        if chunk is None:
            raise EOFError()
        self.buf += chunk
        nl = self.buf.find(b"\n")
        if nl < 0:
            if len(self.buf) > MAX_DAEMON_LINE:
                raise ValueError("line too long")
            return None
        line, self.buf = self.buf[:nl], self.buf[nl + 1:]
        if len(line) > MAX_DAEMON_LINE:
            raise ValueError("line too long")
        return line

    def fileno_or_none(self):
        return self.sock if self.live else None

    def _send(self, obj):
        if self.sock is None:
            return
        try:
            self.sock.setblocking(True)
            self.sock.settimeout(1)
            self.sock.sendall(json.dumps(obj).encode() + b"\n")
        except OSError:
            pass

    def _close(self):
        if self.sock is not None:
            try:
                self.sock.close()
            except OSError:
                pass
        self.sock = None
        self.live = False

    def _result(self, outcome):
        self._send({"op": "approval.result", "request_id": self.rid, "outcome": outcome})
        self._close()

    def poll(self, now):
        if not self.live:
            return None
        line = None
        try:
            if self.buf.find(b"\n") >= 0:
                line = self._next_line(b"")
            else:
                try:
                    chunk = self.sock.recv(65536)
                except (BlockingIOError, InterruptedError):
                    return None
                line = self._next_line(chunk or None)
        except EOFError:
            self._close()
            return {"kind": "unavailable", "approver": "iphone", "why": "daemon-eof"}
        except ValueError:
            self._result("malformed")
            return {"kind": "deny", "approver": "iphone", "why": "malformed"}
        except OSError as e:
            self._close()
            return {"kind": "unavailable", "approver": "iphone", "why": "socket-error(%s)" % type(e).__name__}
        if line is None:
            return None
        return self._decide(line, now)

    def _decide(self, line, now):
        try:
            msg = json.loads(line)
        except ValueError:
            msg = None
        if not isinstance(msg, dict) or msg.get("op") != "approval.decision" \
                or msg.get("decision") not in ("approve", "deny"):
            self._result("malformed")
            return {"kind": "deny", "approver": "iphone", "why": "malformed"}
        dev = msg.get("device_id") if isinstance(msg.get("device_id"), str) else ""
        self.device = dev if DEVICE_RE.match(dev) else ""
        who = "iphone:" + (self.device or "?")
        der = load_pin(self.c, self.device)[0] if self.device else None
        if msg["decision"] == "deny":
            # A deny is unsigned (PROTOCOL v1). Only a pinned approver's deny is final; any other paired or
            # rogue device only ends the phone leg, and Touch ID keeps waiting (audit M1).
            if der is None:
                self._result("unknown_device")
                return {"kind": "advisory", "approver": who, "why": "deny-from-unpinned-device"}
            self._result("accepted")
            return {"kind": "deny", "approver": who, "why": "phone-deny"}
        outcome = "accepted"
        if msg.get("request_id") != self.rid:
            outcome = "malformed"
        elif der is None:  # not a pinned approver: it cannot approve, and it must not cancel Touch ID either
            self._result("unknown_device")
            return {"kind": "advisory", "approver": who, "why": "unknown_device"}
        elif now > self.canon["expires_at"]:
            outcome = "expired"
        else:
            sig = msg.get("signature")
            try:
                sig_der = base64.b64decode(sig, validate=True) if isinstance(sig, str) else None
            except ValueError:
                sig_der = None
            if not sig_der or not p256_verify(der, b"WL1-APPROVE\n" + self.raw, sig_der):
                outcome = "bad_signature"
        if outcome == "accepted":
            # The signer must also be bound inside the sealed iPhone copy: a pin file alone (plain file,
            # writable by any same-user process) does not unlock the token (audit H1, broker route).
            tok, fps, err = decrypt_iphone_copy(self.c, self.tname)
            if err:
                self.error = err  # approved, but no token: token() reports it; never the Touch ID copy
            elif fps is None or fingerprint(der) not in fps:
                del tok
                self._result("unknown_device")
                return {"kind": "advisory", "approver": who,
                        "why": "unbound_device" if fps is not None else "unbound_device(legacy-copy)"}
            else:
                self._tok = tok
        self._result(outcome)
        if outcome != "accepted":  # fail closed: something is tampering or confused
            return {"kind": "deny", "approver": who, "why": outcome}
        return {"kind": "approve", "approver": who, "why": ""}

    def cancel(self, reason):
        if self.live:
            self._send({"op": "approval.cancel", "request_id": self.rid, "reason": reason})
        self._close()

    def token(self):
        """The token from the no-biometry iPhone copy, unsealed while checking the binding. Never falls back
        to the Touch ID copy."""
        tok, self._tok = self._tok, None
        return (tok, None) if tok else (None, self.error or "no iPhone token")


def approve_gate(c, rec, tname, title, msg, canon_fields, prefer_device=""):
    """Get one approval and the decrypted token. Returns (token, None) or (None, (result, detail, error)).
    Sets rec approver / request_id / notes for the audit line.

    Deadlines: the Touch ID leg keeps its 120 s; a live iPhone leg may answer until expires_at
    (created_at + approval_wait_s, default 300) + PHONE_GRACE_S. The gate waits for the later of the
    legs it actually has, so with the phone unavailable Touch ID behaves exactly as before."""
    if is_default_approvers(c):  # exactly the pre-approver behaviour
        notify(title, msg, c)
        token, err = decrypt_token(tname, c)
        return (token, None) if not err else (None, ("auth-failed", err, err))
    approvers = approvers_of(c)
    if approvers is None:
        return None, ("rejected", "bad approvers config", "bad approvers config")
    canon = build_canonical(c, **canon_fields)
    rec["request_id"] = canon["request_id"]
    rec["approver"] = "none"
    notes = rec.setdefault("notes", [])
    created = canon["created_at"]
    deadline_touchid = created + TOUCHID_WINDOW_S
    deadline_phone = canon["expires_at"] + PHONE_GRACE_S
    phone = touch = None
    try:
        if "iphone" in approvers:
            phone = IphoneLeg(c, canon, tname, prefer_device)
            if not phone.start():
                notes.append("iphone-unavailable:" + phone.why)
                phone = None
        if "touchid" not in approvers:
            deadline = deadline_phone
        else:
            deadline = max(deadline_touchid, deadline_phone) if phone is not None else deadline_touchid
        window = int(deadline - created)
        if "touchid" in approvers:
            notify(title, msg + (" — or approve on iPhone" if phone else ""), c)
            touch = TouchIdLeg(c, tname, deadline_touchid)
            if not touch.start():
                notes.append("touchid-unavailable:start")
        legs = [x for x in (phone, touch) if x is not None]
        while True:
            now = time.time()
            if now >= deadline:
                for leg in legs:
                    leg.cancel("timeout")
                return None, ("timeout", "", "no approval within %ds (Touch ID or iPhone)" % window)
            live = [x for x in legs if x.live]
            if not live:
                if touch is not None and touch.error and phone is None:
                    return None, ("auth-failed", touch.error, touch.error)  # today's error
                return None, ("no-approver", "",
                              "no approver available (Touch ID unavailable, iPhone not connected)")
            socks = [x.fileno_or_none() for x in live if x.fileno_or_none() is not None]
            if socks:
                select.select(socks, [], [], 0.1)
            else:
                time.sleep(0.1)
            now = time.time()
            if now >= deadline:
                continue
            for leg in live:
                d = leg.poll(now)
                if d is None:
                    continue
                if d["kind"] == "unavailable":
                    notes.append("%s-unavailable:%s" % (leg.name, d["why"]))
                    continue
                if d["kind"] == "advisory":  # an answer we do not act on; the other leg keeps going
                    notes.append("%s-ignored:%s" % (leg.name, d["why"]))
                    if any(x.live for x in legs if x is not leg):
                        continue
                    rec["approver"] = d["approver"]
                    return None, ("denied", "by=%s outcome=%s" % (d["approver"], d["why"]),
                                  "iPhone answer not accepted (%s) and no other approver" % d["why"])
                rec["approver"] = d["approver"]
                other = [x for x in legs if x is not leg]
                if leg is touch:
                    reason = "touchid_approved" if d["kind"] == "approve" else "touchid_denied"
                    for x in other:
                        x.cancel(reason)
                    if d["kind"] == "deny":
                        return None, ("denied", "by=touchid", touch.error)
                    return touch.token()[0], None
                for x in other:  # the phone decided: stop the Touch ID prompt first
                    x.cancel("phone_decided")
                if d["kind"] == "deny":
                    detail = "by=%s" % d["approver"] + ("" if d["why"] == "phone-deny" else " outcome=" + d["why"])
                    err = "denied on iPhone" if d["why"] == "phone-deny" else \
                        "iPhone approval rejected (%s)" % d["why"]
                    return None, ("denied", detail, err)
                token, err = leg.token()
                if err:
                    return None, ("auth-failed", err, err)
                return token, None
    finally:  # exceptions included: never leave a prompt up or the daemon waiting
        for leg in (phone, touch):
            if leg is not None and leg.live:
                leg.cancel("broker_error")


# ------------------------------------------------------- who is asking

def ps_field(pid, field):
    try:
        r = subprocess.run(["/bin/ps", "-o", field + "=", "-p", str(pid)], capture_output=True, timeout=3)
        return r.stdout.decode("utf-8", "replace").strip()
    except Exception:  # noqa: BLE001
        return ""


def proc_label(pid):
    args = ps_field(pid, "args").split()
    if not args:
        return "pid%s" % pid
    base = os.path.basename(args[0]).lstrip("-")
    if base in ("bash", "zsh", "sh") and "-c" in args:
        return base + " -c"
    if base in ("node", "bun", "deno", "bash", "zsh", "sh", "perl", "ruby", "env") or base.startswith("python"):
        for a in args[1:]:
            if not a.startswith("-"):
                return "%s %s" % (base, "/".join(a.split("/")[-2:]))
    return base


def proc_chain(pid, depth=4):
    out = []
    for _ in range(depth):
        try:
            pid = int(pid)
        except ValueError:
            break
        if pid <= 1:
            break
        out.append(proc_label(pid))
        pid = ps_field(pid, "ppid") or "0"
    return " < ".join(out)


def ssh_destination(args):
    """Destination of an ssh client argv, never the remote command (which could hold a value)."""
    with_arg = set("-" + ch for ch in "BbcDEeFIiJLlmOoPpQRSWw")
    i = 1
    while i < len(args):
        a = args[i]
        if a == "--":
            return args[i + 1] if i + 1 < len(args) else "?"
        if a.startswith("-"):
            i += 2 if a in with_arg else 1
            continue
        return a
    return "?"


# ---------------------------------------------------------------- broker

def validate_read_args(raw, c):
    pos, server = [], None
    i = 0
    while i < len(raw):
        a = raw[i]
        if a in ("--color", "-c"):
            i += 2
        elif a in ("--output", "-o"):
            if i + 1 >= len(raw) or raw[i + 1] != "json":
                return None
            i += 2
        elif a in ("--server-url", "-u"):
            if i + 1 >= len(raw) or raw[i + 1] not in c["server_urls"]:
                return None
            server = raw[i + 1]
            i += 2
        elif a.startswith("-"):
            return None  # -t/--access-token, -f, -p, --value, ... all refused
        else:
            pos.append(a)
            i += 1
    name = lambda pid: c["project_names"].get(pid.lower(), pid)  # noqa: E731
    if pos == ["project", "list"]:
        summary = "list projects"
    elif pos == ["secret", "list"]:
        summary = "read ALL secrets the token can see"
    elif len(pos) == 3 and pos[:2] == ["secret", "list"] and UUID_RE.match(pos[2]):
        summary = "read all secrets in " + name(pos[2])
    elif len(pos) == 3 and pos[:2] == ["secret", "get"] and UUID_RE.match(pos[2]):
        summary = "read secret %s" % pos[2].lower()   # the full id: what the owner approves is unambiguous
    elif len(pos) == 3 and pos[:2] == ["project", "get"] and UUID_RE.match(pos[2]):
        summary = "get project " + name(pos[2])
    else:
        return None
    if any(denied_project(p, c) for p in pos):
        return None
    if server:
        summary += " @ " + server.split("://", 1)[-1]
    args = ["--output", "json"] + (["--server-url", server] if server else []) + pos
    return args, summary


def scrub(stdout, c):
    """Drop denied entries by key prefix and by project id AND name. After a live project lookup
    (c["allowed_project_ids"]), a secret whose projectId is not a visible, allowed project is dropped too."""
    allowed = c.get("allowed_project_ids")

    def bad(e):
        if (denied_key(e.get("key", ""), c) or denied_project(e.get("projectId"), c)
                or denied_project(e.get("id"), c) or denied_project(e.get("name"), c)):
            return True
        return allowed is not None and "key" in e and str(e.get("projectId") or "").lower() not in allowed
    try:
        data = json.loads(stdout or b"null")
    except ValueError:
        return stdout
    if isinstance(data, list):
        return json.dumps([e for e in data if not (isinstance(e, dict) and bad(e))]).encode()
    if isinstance(data, dict) and bad(data):
        return b"{}"
    return stdout


# ------------------------------------------------------------ providers
#
# The approval gate (approve_gate above) decides WHETHER an op may run and unseals the credential the
# provider asked for; a Provider decides WHAT runs: which sealed token it needs, how a read request is
# parsed and summarised for the prompt, and how list / get / save talk to the backend. The gate never
# sees provider details and a provider never sees approvers. See docs/PROVIDERS.md for adding one.

class Provider(object):
    """A secret backend behind the approval gate.

    Token handling: every provider names the sealed credential each operation needs (read_token /
    write_token; files tokens/<name>.age, plus the .iphone.age copies) and how it is handed to the backend
    (token_env). The token is decrypted by the gate, used for one op, and dropped.

    parse_read(raw, c) -> None (refused) or {"kind": "list"|"get", "args", "summary", "project"}
    list(op, token, c) / get(op, token, c) -> (exit_code, stdout_bytes, stderr_text)
    save(key, value, note, project, token, c) -> (result, detail, response_dict)
    scrub(stdout, c) -> stdout with denied projects / keys removed
    """
    name = "?"
    enabled = False
    token_env = ""

    def read_token(self, c, requested=None):
        return requested or c["read_token"]

    def write_token(self, c):
        return c["write_token"]

    def resolve_projects(self, op, token, c):
        """Live project ids visible to `token`, minus denied ones (ids and names): (set, None) or (None, why).
        Used when a denied project name has no id in project_names. A provider without it fails closed."""
        return None, "provider '%s' cannot resolve denied project names" % self.name

    def parse_read(self, raw, c):
        raise NotImplementedError

    def list(self, op, token, c):
        raise NotImplementedError

    def get(self, op, token, c):
        raise NotImplementedError

    def read(self, op, token, c):
        return (self.list if op["kind"] == "list" else self.get)(op, token, c)

    def save(self, key, value, note, project, token, c):
        raise NotImplementedError

    def scrub(self, stdout, c):
        return stdout


class BitwardenProvider(Provider):
    """Bitwarden Secrets Manager through the `bws` CLI (the original and default behaviour)."""
    name = "bitwarden"
    enabled = True
    token_env = "BWS_ACCESS_TOKEN"

    def parse_read(self, raw, c):
        v = validate_read_args(raw, c)
        if not v:
            return None
        args, summary = v
        pos = args[4:] if args[2:3] == ["--server-url"] else args[2:]
        scoped = len(pos) == 3 and pos[:2] in (["secret", "list"], ["project", "get"])
        project = c["project_names"].get(pos[2].lower(), pos[2]) if scoped else ""
        return {"kind": "list" if "list" in pos[1:2] else "get", "args": args, "summary": summary,
                "project": project, "project_id": pos[2].lower() if scoped else ""}

    def resolve_projects(self, op, token, c):
        server = op["args"][2:4] if op["args"][2:3] == ["--server-url"] else []
        code, out, err = run_bws(["--output", "json"] + server + ["project", "list"], token, c)
        try:
            projects = json.loads(out) if code == 0 else None
        except ValueError:
            projects = None
        if not isinstance(projects, list) or not all(isinstance(p, dict) for p in projects):
            return None, "bws project list failed: " + clean(err, 120)
        allowed = set()
        for p in projects:
            pid, name = str(p.get("id") or "").lower(), str(p.get("name") or "").lower()
            if not UUID_RE.match(pid):
                return None, "bws project list returned an entry without a project id"
            if pid in c["denied_projects"] or name in c["denied_projects"]:
                c["denied_projects"].append(pid)
            else:
                allowed.add(pid)
        return allowed, None

    def list(self, op, token, c):
        return run_bws(op["args"], token, c, BWS_TIMEOUT_S)

    get = list  # bws itself tells list from get by its argv

    def scrub(self, stdout, c):
        return scrub(stdout, c)

    def save(self, key, value, note, project, token, c):
        def reject(msg):
            return "rejected", msg, {"ok": False, "error": msg}
        code, out, err = run_bws(["--output", "json", "project", "list"], token, c)
        try:
            projects = json.loads(out) if code == 0 else None
        except ValueError:
            projects = None
        if not isinstance(projects, list):
            return reject("bws project list failed: " + err)
        pid = next((p.get("id") for p in projects if p.get("name") == project), None)
        if not pid or denied_project(pid, c):
            return reject("project '%s' is not visible to the write token" % project)
        code, out, err = run_bws(["--output", "json", "secret", "list", pid], token, c)
        try:
            secrets = json.loads(out) if code == 0 else None
        except ValueError:
            secrets = None
        if not isinstance(secrets, list):
            return reject("bws secret list failed: " + err)
        existing = [s for s in secrets if s.get("key") == key]
        if len(existing) > 1:
            return reject("%d secrets already named %s in %s; fix by hand" % (len(existing), key, project))
        # bws 2.x only takes the value on argv: it is visible to same-user processes on this Mac
        # for the second bws runs. Never logged; redacted from errors.
        # Values, notes and keys may start with "-" (a PEM is "-----BEGIN ..."), which clap would read as
        # a flag: option values are attached with "=" and positionals all follow "--".
        note_arg = ["--note=" + note] if note else []
        if existing:
            args = ["--output", "json", "secret", "edit", "--value=" + value] + note_arg + ["--", existing[0]["id"]]
            action = "updated"
        else:
            args = ["--output", "json", "secret", "create"] + note_arg + ["--", key, value, pid]
            action = "created"
        code, out, err = run_bws(args, token, c)
        if code != 0:
            return "error", "bws %s failed exit %d" % (action, code), \
                {"ok": False, "error": "bws failed: " + err.replace(value, "[REDACTED]")}
        try:
            sid = json.loads(out).get("id", "")
        except (ValueError, AttributeError):
            sid = ""
        return action, "id=%s" % sid, {"ok": True, "id": sid, "action": action, "project": project}


