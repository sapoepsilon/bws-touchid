# Approvers (whispera-link protocol v1, PROTOCOL.md §7, §8, §11). Module constants so tests can shrink them.
KNOWN_APPROVERS = ("touchid", "iphone")
TOUCHID_WINDOW_S = 120          # Touch ID leg deadline (today's decrypt timeout)
APPROVAL_WAIT_DEFAULT_S = 300   # how long the iPhone leg may take (approval_wait_s)
PHONE_WINDOW_MIN, PHONE_WINDOW_MAX = 30, 300
PHONE_CONNECT_S = 1.0           # approvals.sock connect timeout
PHONE_ACK_S = 2.0               # wait for approval.ack
PHONE_GRACE_S = 5               # iphone-only: deadline = expires_at + this
IPHONE_DECRYPT_S = 10
KILL_GRACE_S = 1.0
MAX_DAEMON_LINE = 64 * 1024
PREFER_DEVICE_FILE = "~/.whispera-link/last_device"   # routing hint written by the helper (optional)

# Budgets, innermost first. Every outer wait covers everything inside it, so a slow approval ends
# with a coded error from the broker, never a client that gave up first (PROTOCOL.md §11.2).
BWS_TIMEOUT_S = 60                                    # one provider CLI run
GATE_MAX_S = PHONE_WINDOW_MAX + PHONE_GRACE_S         # longest approval gate (305 s)
BROKER_CONN_S = GATE_MAX_S + 3 * BWS_TIMEOUT_S + 10   # a save runs the CLI up to 3 times after approval
