            if a == "--project":
                project = argv[i + 1]
            else:
                note = argv[i + 1]
            i += 2
        elif a == "--dry-run":
            dry, i = True, i + 1
        elif a in ("-h", "--help"):
            print('usage: printf %s "$VALUE" | bws-save [--async] [--project NAME] [--note TEXT] [--dry-run] KEY')
            sys.exit(0)
        elif a.startswith("-"):
