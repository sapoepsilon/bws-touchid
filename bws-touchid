# ------------------------------------------------------- passcode approver admin

PASSCODE_USAGE = "usage: bws-touchid passcode set | change | remove | status | unlock"


def read_passcode_tty(prompt):
    """getpass on the controlling terminal (no echo), as a bytearray the caller zeroes. Never a pipe,
    argv or env: without a /dev/tty this refuses instead of letting getpass fall back to echoing stdin."""
    try:
        os.close(os.open("/dev/tty", os.O_RDWR | os.O_NOCTTY))
    except OSError:
        die("the passcode is typed on a terminal and there is none here (/dev/tty); nothing changed", 2)
    s = getpass.getpass(prompt)
    b = bytearray(s.encode("utf-8"))
    del s
    return b


def passcode_problem(secret):
    """Why a new passcode is not acceptable, or ''."""
    try:
        s = secret.decode("utf-8")
    except UnicodeDecodeError:
        return "the passcode is not UTF-8"
    try:
        if len(s) < PASSCODE_MIN_LEN:
            return "the passcode needs at least %d characters" % PASSCODE_MIN_LEN
        if len(s) > PASSCODE_MAX_LEN:
            return "the passcode may have at most %d characters" % PASSCODE_MAX_LEN
        if not all(ch.isprintable() for ch in s) or s != s.strip():
            return "the passcode may not contain control characters or leading/trailing spaces"
        return ""
    finally:
        del s


def passcode_unseal_tty(c, name, how):
    """The token from tokens/<name>.passcode.age, passcode typed on this tty; counted like the dialog."""
    path = passcode_token_path(name)
    if not os.path.lexists(path):
        die("no passcode copy for token '%s' (bws-touchid passcode set)" % name)
    if not private_file_ok(path) or not safe_owned(TOKENS_DIR, True):
        die("refusing %s: not a 0600 file you own in a private tokens dir" % path)
    if passcode_tools(c):
        die("passcode approver unavailable: %s (age >= 1.3 ships age-plugin-batchpass)" % passcode_tools(c))
    why, wait = passcode_check(passcode_state(), time.time())
    if why == "backoff":
        die("too many wrong passcodes: try again in %ds" % (int(wait) + 1), 5)
    if why:
        die("passcode locked; only Touch ID unlocks it: bws-touchid passcode unlock", 5)
    secret = read_passcode_tty("Passcode for token '%s' (hidden): " % name)
    try:
        failures, why = passcode_begin_attempt()
        if why:
            die("passcode %s" % why, 5)
        tok, kind, err = open_passcode_copy(c, name, secret)
    finally:
        zero(secret)
    if tok:
        passcode_reset()
        return tok
    passcode_failed(c, name, failures, kind, how)
    die("%s (%d of %d attempts used)" % (err, failures, PASSCODE_MAX_FAILURES), 5)


def passcode_set(c, sub):
    """set / change: Touch ID for every token first, then the new passcode twice, then re-seal."""
    have = passcode_copy_names()
    if sub == "set" and have:
        die("a passcode is already set (copies: %s); use: bws-touchid passcode change" % ", ".join(have), 2)
    if sub == "change" and not have:
        die("no passcode set; use: bws-touchid passcode set", 2)
    if passcode_tools(c):
        die("passcode approver unavailable: %s (age >= 1.3 ships age-plugin-batchpass)" % passcode_tools(c))
    names = touchid_token_names()
    if not names:
        die("no Touch ID tokens stored yet (bws-touchid store NAME)")
    try:
        os.close(os.open("/dev/tty", os.O_RDWR | os.O_NOCTTY))
    except OSError:
        die("passcode %s needs a terminal (/dev/tty); nothing changed" % sub, 2)
    for d in (CONF_DIR, TOKENS_DIR):
        os.chmod(d, 0o700)
    tokens, sealed, secret, seen, lock = {}, [], None, {}, None
    try:
        for name in names:
            print("Touch ID for token '%s'…" % name)
            notify("Touch ID: passcode %s (token '%s')" % (sub, name), "bws-touchid passcode " + sub, c)
            seen[name] = token_identity(name)   # before the decrypt: a store after this is caught below
            tok, err = decrypt_token(name, c)
            if err:
                log({"op": "passcode-" + sub, "result": "auth-failed", "token": name})
                die(err)
            tokens[name] = tok
            del tok
        secret = read_passcode_tty("New passcode (at least %d characters, hidden): " % PASSCODE_MIN_LEN)
        problem = passcode_problem(secret)
        if problem:
            log({"op": "passcode-" + sub, "result": "rejected", "detail": "too weak or malformed"})
            die(problem + "; nothing changed")
        again = read_passcode_tty("Repeat it: ")
        same = hmac.compare_digest(secret, again)
        zero(again)
        if not same:
            log({"op": "passcode-" + sub, "result": "rejected", "detail": "mismatch"})
            die("the two passcodes differ; nothing changed")
        # From here to the renames a `store` must wait (and vice versa): seal, re-check, replace.
        lock = take_seal_lock("passcode " + sub)
        for name in names:
            err = seal_passcode_copy(c, secret, tokens[name], name)
            if err:
                die("age encrypt failed for '%s': %s; nothing changed" % (name, err))
            sealed.append(name)
        tokens.clear()
        zero(secret)
        changed = [n for n in sealed if token_identity(n) != seen.get(n)]
        if changed:   # `store` replaced a token meanwhile: these copies would hold the old one
            log({"op": "passcode-" + sub, "result": "rejected", "token": changed[0], "detail": "token changed"})
            die("token '%s' changed while sealing (bws-touchid store?); nothing changed, run passcode %s again"
                % (changed[0], sub))
        for name in sealed:
            os.replace(passcode_token_path(name) + ".tmp", passcode_token_path(name))
        for name in passcode_copy_names():
            if name not in sealed:   # a copy of a token that no longer has a Touch ID copy
                os.remove(passcode_token_path(name))
    except BaseException:   # die(), Ctrl-C, a crash: no half-sealed *.passcode.age.tmp left behind
        if lock is not None:   # .tmp files are only written under the lock: never touch another run's
            for n in names:
                try:
                    os.remove(passcode_token_path(n) + ".tmp")
                except OSError:
                    pass
        raise
    finally:
        tokens.clear()
        zero(secret)
        if lock is not None:
            os.close(lock)
    exclude_from_backups(c, [passcode_token_path(n) for n in sealed])
    passcode_reset(create=True)
    log({"op": "passcode-" + sub, "result": "ok", "detail": "copies=" + ",".join(sealed)})
    print("passcode %s: sealed copies of %s (scrypt, tokens/<name>.passcode.age)" % (
        "set" if sub == "set" else "changed", ", ".join(sealed)))
    if "passcode" not in (approvers_of(c) or []):
        print('next: add "passcode" to "approvers" in %s (e.g. ["touchid", "passcode"]) and restart the broker'
              % CONFIG_PATH)


def token_identity(name):
    """(inode, mtime_ns, size) of tokens/<name>.age, or None: tells whether `store` replaced it."""
    try:
        st = os.stat(token_path(name))
    except OSError:
        return None
    return st.st_ino, st.st_mtime_ns, st.st_size


def exclude_from_backups(c, paths):
    """tmutil addexclusion (sticky, follows the file) on each path: an old passcode copy in a Time
    Machine backup would still open with the old passcode. macOS only; failures warn, never fail."""
    tm = find_tool("tmutil", c.get("tmutil_path"))
    if not tm or not os.path.isfile(tm) or not os.access(tm, os.X_OK):
        return
    for p in paths:
        try:
            r = subprocess.run([tm, "addexclusion", p], capture_output=True, timeout=15)
            why = "" if r.returncode == 0 else clean(r.stderr.decode("utf-8", "replace"), 160) or \
                "exit %d" % r.returncode
        except (OSError, subprocess.TimeoutExpired) as e:
            why = clean(e, 160)
        if why:
            eprint("bws-touchid: warning: could not exclude %s from Time Machine (%s); exclude it by hand: "
                   "tmutil addexclusion %s" % (p, why, p))


def passcode_remove(c):
    lock = take_seal_lock("passcode remove")   # never delete a running set / change's copies under it
    try:
        _passcode_remove(c)
    finally:
        os.close(lock)


def _passcode_remove(c):
    removed = []
    names = sorted(os.listdir(TOKENS_DIR)) if os.path.isdir(TOKENS_DIR) else []
    for path in [os.path.join(TOKENS_DIR, f) for f in names if f.endswith((".passcode.age", ".passcode.age.tmp"))] \
            + [PASSCODE_STATE]:
        if os.path.lexists(path):
            os.remove(path)
            removed.append(path)
            print("removed %s" % path)
    log({"op": "passcode-remove", "result": "ok", "detail": "%d files" % len(removed)})
    if not removed:
        print("no passcode set")
    if "passcode" in (approvers_of(c) or []):
        print('next: remove "passcode" from "approvers" in %s and restart the broker' % CONFIG_PATH)


def passcode_unlock(c):
    """Clear failures / the lockout. Needs Touch ID: a passcode can never unlock itself."""
    if not passcode_copy_names():
        die("no passcode set")
    names = touchid_token_names()
    name = c["read_token"] if c["read_token"] in names else (names[0] if names else c["read_token"])
    st = passcode_state()
    notify("Touch ID: unlock the bws-touchid passcode", "clears %d failed attempts" %
           ((st if isinstance(st, dict) else {}).get("failures") or 0), c)
    tok, err = decrypt_token(name, c)   # owner presence; the token is discarded
    if err:
        log({"op": "passcode-unlock", "result": "auth-failed", "token": name})
        die(err)
    del tok
    if not passcode_reset(create=True):
        die("could not write %s" % PASSCODE_STATE)
    log({"op": "passcode-unlock", "result": "ok"})
    print("passcode unlocked: failed attempts reset")


def passcode_status(c):
    print("passcode:  %s" % passcode_summary())
    on = "passcode" in (approvers_of(c) or [])
    print("approver:  %s" % ("on (approvers: %s)" % ", ".join(approvers_of(c)) if on else
                             'off (add "passcode" to "approvers" to use it)'))
    why = passcode_tools(c)
    print("plugin:    %s" % (batchpass_plugin(c) if not why else "MISSING: " + why))
    print("state:     %s" % PASSCODE_STATE)


def cmd_passcode(argv):
    c = load_config()
    sub = argv[0] if len(argv) == 1 else ""
    if sub in ("set", "change"):
