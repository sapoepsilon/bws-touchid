CLIENT_TIMEOUT_S = GATE_QUEUE_S + BROKER_CONN_S + 10  # bws-save / bws-gated read timeout
MAX_CONNS = 32                                        # concurrent broker connections

# Async tickets: in broker memory only, single retrieval, bound to uid + host + caller.
TICKET_TTL_S = 600              # a finished result is kept this long, then forgotten
TICKET_WAIT_MAX_S = 55          # longest ticket.get long-poll (fits inside a 60 s MCP call)
MAX_TICKETS = 64
TICKET_RE = re.compile(r"^tkt_[a-z2-7]{24}$")
OPENSSL = "/usr/bin/openssl"    # absolute path on purpose, never PATH
SPKI_P256_PREFIX = bytes.fromhex("3059301306072a8648ce3d020106082a8648ce3d030107034200")
DEVICE_RE = re.compile(r"^dev_[a-z2-7]{24}$")

